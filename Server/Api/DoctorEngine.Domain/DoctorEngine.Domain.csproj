<Project Sdk="Microsoft.NET.Sdk">

  <!-- DOMAIN: entitilər (Models) və enumlar. Heç bir başqa layihədən asılı deyil. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DoctorEngineApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- AppUser : IdentityUser -->
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="10.0.15" />
    <!-- [Index] atributları (yalnız annotasiyalar, EF-in özü yox) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.15" />
  </ItemGroup>

</Project>

