<Project Sdk="Microsoft.NET.Sdk">

  <!-- APPLICATION: ViewModel/DTO-lar, servis interfeysləri, ayarlar (Options), tərcümə (L.T).
       Yalnız Domain-dən asılıdır; verilənlər bazasını bilmir. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DoctorEngineApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- IFormFile, SelectListItem, HttpContext (L.Apply) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Əllə tərcümə olunmuş UI/JS mətnləri (az → en/ru/tr) -->
  <ItemGroup>
    <!-- WithCulture=false: "ui.en.json"-dakı ".en" mədəniyyət kimi oxunmasın (yoxsa satellite assembly-yə düşür) -->
    <EmbeddedResource Include="Localization\*.json" WithCulture="false" />
    <None Remove="Localization\*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DoctorEngine.Domain\DoctorEngine.Domain.csproj" />
  </ItemGroup>

  <!-- Web SDK-nın avtomatik "using"-ləri (kod saytdan köçürüldüyü üçün eyni qalır) -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
