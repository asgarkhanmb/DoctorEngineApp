{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },

  "Site": {
    "BaseUrl": "https://doctorengine.az"
  },

  "Storage": {
    "WebRoot": "wwwroot"
  },

  "DataProtection": {
    "KeysPath": ""
  },

  "Cors": {
    "Origins": [ "https://doctorengine.az", "https://www.doctorengine.az" ]
  },

  "Ai": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "Model": "gemini-3.8-flash",
    "MaxOutputTokens": 900,
    "Temperature": 0.4,
    "DailyPerUser": 20,
    "DailyPerIp": 60,
    "PerMinute": 5,
    "DailyLimit": 900
  }
}
