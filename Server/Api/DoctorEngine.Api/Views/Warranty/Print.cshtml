@model DoctorEngineApp.Models.Warranty

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@*  Saytdakı Areas/Admin/Views/Warranty/Print.cshtml-in surəti (API: GET api/v1/admin/warranties/{id}/print).
    Fərq: loqo data-URI ilə yerləşdirilir — API saytın /assets qovluğunu vermir.  *@
@{
    Layout = null;
    var logoPath = System.IO.Path.Combine(Env.WebRootPath, "assets", "img", "el.png");
    var logoSrc = System.IO.File.Exists(logoPath)
        ? "data:image/png;base64," + Convert.ToBase64String(System.IO.File.ReadAllBytes(logoPath))
        : "";
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <title>Zemanet Senedi</title>

    <style>

        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            font-size: 14px;
            color: #000;
            margin: 35px;
        }

        .header {
            width: 100%;
            border-bottom: 2px solid #000;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

        .logo {
            float: left;
        }

            .logo img {
                height: 70px;
            }

        .service-info {
            float: right;
            text-align: right;
        }

            .service-info h1 {
                margin: 0;
                font-size: 24px;
            }

            .service-info p {
                margin: 2px 0;
                font-size: 12px;
            }

        .clear {
            clear: both;
        }

        h2 {
            text-align: center;
            margin-top: 30px;
            margin-bottom: 30px;
            font-size: 24px;
        }

        .info {
            margin-bottom: 20px;
        }

            .info p {
                margin: 6px 0;
            }

        table {
            width: 100%;
            border-collapse: collapse;
        }

            table th,
            table td {
                border: 1px solid #000;
                padding: 10px;
            }

            table th {
                background: #f2f2f2;
                text-align: left;
            }

        .terms {
            margin-top: 25px;
        }

            .terms p {
                line-height: 1.6;
            }

        .signature {
            width: 100%;
            margin-top: 120px;
        }

            .signature td {
                border: none;
                padding-top: 50px;
                font-weight: bold;
            }

        .footer {
            margin-top: 50px;
            border-top: 1px solid #ccc;
            padding-top: 10px;
            text-align: center;
            font-size: 11px;
        }

    </style>
</head>

<body>

    <!-- HEADER -->
    <div class="header">

        <div class="logo">
            <img src="@logoSrc" />
        </div>

        <div class="service-info">
            <h1>DOCTOR ENGINE</h1>
            <p>Avtomobil Təmir Mərkəzi</p>
            <p>Tel: +994 77 305 13 19</p>
            <p>Bakı, Azərbaycan</p>
        </div>

        <div class="clear"></div>

    </div>

    <!-- TITLE -->
    <h2>ZƏMANƏT SƏNƏDİ</h2>

    <!-- CUSTOMER INFO -->
    <div class="info">

        <p>
            <strong>Müştəri:</strong>
            @Model.CustomerFullName
        </p>

        <p>
            <strong>Avtomobil:</strong>
            @Model.VehicleModel
        </p>

        <p>
            <strong>İl:</strong>
            @Model.VehicleYear
        </p>

        <p>
            <strong>Tarix:</strong>
            @Model.CreatedDate.ToString("dd.MM.yyyy")
        </p>

    </div>

    <!-- TABLE -->
    <table>

        <thead>
            <tr>
                <th>Detal</th>
                <th>Zəmanət</th>
            </tr>
        </thead>

        <tbody>

            @if (Model.Items != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.PartName</td>
                        <td>@item.WarrantyMonth ay</td>
                    </tr>
                }
            }

        </tbody>

    </table>

    <!-- TERMS -->
    <div class="terms">

        <p>
            <strong>Zəmanət şərtləri:</strong>
        </p>

        <p>
            @Model.Terms
        </p>

    </div>

    <!-- SIGNATURE -->
    <table class="signature">

        <tr>

            <td>
                İmza: ____________________
            </td>

            <td style="text-align:right;">
                Möhür: ____________________
            </td>

        </tr>

    </table>

    <!-- FOOTER -->
  

</body>
<div class="footer">
    Bu sənəd DoctorEngine.Az Service tərəfindən təqdim edilmişdir.
</div>
</html>

