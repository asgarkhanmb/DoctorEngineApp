@model ServicePageVM

@{
    ViewData["Title"] = "Xidmətlər";
}

@section css {
    <link rel="stylesheet" href="~/css/services.css" asp-append-version="true" />
}

<partial name="_PageHeader" model='("Xidmətlər", "Mühərrik diaqnostikasından tam təmirə qədər — bütün xidmətlərimizi kəşf edin.")' />

<div class="sv">

    <!-- ================= GİRİŞ ================= -->
    <section class="container sv-intro">
        <div class="sv-intro__text wow fadeInUp" data-wow-delay="0.1s">
            <span class="sv-eyebrow">@L.T("Xidmətlərimiz")</span>
            <h2>@L.T("Mühərrikiniz üçün peşəkar həllər")</h2>
            <p>@L.T("Hər xidmətin videosuna baxın, işin necə görüldüyünü öz gözünüzlə görün. Uyğun xidməti seçib bir kliklə rezervasiya edin.")</p>
        </div>
        <ul class="sv-perks wow fadeInUp" data-wow-delay="0.2s">
            <li><i class="fa-regular fa-calendar-check"></i><span><b>@L.T("Onlayn rezervasiya")</b>@L.T("Növbə gözləmədən")</span></li>
            <li><i class="fa-regular fa-comments"></i><span><b>@L.T("Usta ilə canlı çat")</b>@L.T("Şəkil və video göndərin")</span></li>
            <li><i class="fa-solid fa-shield-halved"></i><span><b>@L.T("Zəmanət sənədi")</b>@L.T("Görülən işə zəmanət")</span></li>
        </ul>
    </section>

    <!-- ================= XİDMƏTLƏR ================= -->
    <section class="container sv-list" aria-labelledby="sv-list-title">
        <h2 id="sv-list-title" class="visually-hidden">@L.T("Xidmətlərin siyahısı")</h2>

        <partial name="_ServiceGrid" model='new ServiceGridVM
        {
            Categories = Model.Categories ?? new(),
            ReservationServiceIds = ServiceGridVM.MapReservationIds(Model.Categories, Model.Services),
            ShowFilter = true
        }' />
    </section>

    <!-- ================= NECƏ İŞLƏYİRİK ================= -->
    <section class="sv-steps-wrap">
        <div class="container">
            <div class="sv-head wow fadeInUp" data-wow-delay="0.1s">
                <span class="sv-eyebrow">@L.T("Proses")</span>
                <h2>@L.T("Necə işləyirik?")</h2>
                <p>@L.T("Müraciətdən zəmanətə qədər 4 sadə addım.")</p>
            </div>
            <ol class="sv-steps">
                <li class="wow fadeInUp" data-wow-delay="0.1s">
                    <span class="sv-steps__icon"><i class="fa-regular fa-calendar-check"></i></span>
                    <h3>@L.T("Müraciət")</h3>
                    <p>@L.T("Onlayn rezervasiya edin və ya usta ilə çatda problemi yazın.")</p>
                </li>
                <li class="wow fadeInUp" data-wow-delay="0.2s">
                    <span class="sv-steps__icon"><i class="fa-solid fa-magnifying-glass-chart"></i></span>
                    <h3>@L.T("Diaqnostika")</h3>
                    <p>@L.T("Usta mühərriki yoxlayır, nasazlığın səbəbini müəyyən edir.")</p>
                </li>
                <li class="wow fadeInUp" data-wow-delay="0.3s">
                    <span class="sv-steps__icon"><i class="fa-solid fa-screwdriver-wrench"></i></span>
                    <h3>@L.T("Təmir")</h3>
                    <p>@L.T("Razılaşdırılmış işlər peşəkar şəkildə yerinə yetirilir.")</p>
                </li>
                <li class="wow fadeInUp" data-wow-delay="0.4s">
                    <span class="sv-steps__icon"><i class="fa-solid fa-shield-halved"></i></span>
                    <h3>@L.T("Zəmanət")</h3>
                    <p>@L.T("Görülən iş üçün zəmanət sənədi təqdim olunur.")</p>
                </li>
            </ol>
        </div>
    </section>

    <!-- ================= ÇAĞIRIŞ ================= -->
    <section class="container sv-cta-wrap">
        <div class="sv-cta wow fadeInUp" data-wow-delay="0.1s">
            <div>
                <h2>@L.T("Problemin nə olduğunu bilmirsiniz?")</h2>
                <p>@L.T("Əlamətləri AI köməkçiyə yazın və ya birbaşa usta ilə danışın — sizə uyğun xidməti birlikdə tapaq.")</p>
            </div>
            <div class="sv-cta__actions">
                <a asp-controller="Reservation" asp-action="Index" class="sv-btn sv-btn--primary sv-btn--lg">@L.T("Rezervasiya et") <i class="fa-solid fa-arrow-right"></i></a>
                <a asp-controller="Assistant" asp-action="Index" class="sv-btn sv-btn--light sv-btn--lg"><i class="fa-solid fa-wand-magic-sparkles"></i> @L.T("AI Köməkçi")</a>
                <a asp-controller="Contact" asp-action="Index" asp-fragment="chat" class="sv-btn sv-btn--light sv-btn--lg"><i class="fa-regular fa-comments"></i> @L.T("Usta ilə çat")</a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/services.js" asp-append-version="true"></script>
}
