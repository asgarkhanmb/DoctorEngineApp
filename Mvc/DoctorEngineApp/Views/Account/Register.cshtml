@model DoctorEngineApp.ViewModels.Accounts.RegisterVM

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Qeydiyyat";
}

<div class="auth-head">
    <div class="auth-head__icon"><i class="fa-solid fa-user-plus"></i></div>
    <h1>@L.T("Hesab yaradın")</h1>
    <p>@L.T("Bir dəqiqəyə qeydiyyatdan keçin — usta ilə yazışın və rezervasiya edin.")</p>
</div>

<form asp-action="Register" asp-controller="Account" method="post"
      class="auth-form" novalidate data-loading-text="@L.T("Hesab yaradılır…")">

    <div asp-validation-summary="ModelOnly" role="alert"></div>

    <div class="auth-field">
        <label asp-for="FullName">@L.T("Ad Soyad")</label>
        <div class="auth-input">
            <i class="fa-regular fa-id-card"></i>
            <input asp-for="FullName" autocomplete="off" autofocus placeholder="@L.T("Əli Məmmədov")" />
        </div>
        <span asp-validation-for="FullName"></span>
    </div>

    <div class="auth-row">
        <div class="auth-field">
            <label asp-for="UserName">@L.T("İstifadəçi adı")</label>
            <div class="auth-input">
                <i class="fa-solid fa-at"></i>
                <input asp-for="UserName" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="ali.m" />
            </div>
            <span asp-validation-for="UserName"></span>
        </div>

        <div class="auth-field">
            <label asp-for="Email">Email</label>
            <div class="auth-input">
                <i class="fa-regular fa-envelope"></i>
                <input asp-for="Email" type="email" autocomplete="off" placeholder="@L.T("ad@numune.az")" />
            </div>
            <span asp-validation-for="Email"></span>
        </div>
    </div>

    <div class="auth-field">
        <label asp-for="Password">@L.T("Şifrə")</label>
        <div class="auth-input auth-input--password">
            <i class="fa-solid fa-lock"></i>
            <input asp-for="Password" autocomplete="new-password" placeholder="@L.T("Güclü şifrə yaradın")" />
            <button type="button" class="auth-eye" data-toggle-password="Password" aria-label="@L.T("Şifrəni göstər")" aria-pressed="false">
                <i class="fa-regular fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password"></span>
        <small class="auth-caps" data-caps-for="Password"><i class="fa-solid fa-triangle-exclamation"></i> @L.T("Caps Lock açıqdır")</small>

        <div class="auth-meter" data-meter-for="Password" data-level="0" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
        </div>
        <ul class="auth-rules" data-password-rules="Password" aria-label="@L.T("Şifrə tələbləri")">
            <li data-rule="length">@L.T("Minimum 6 simvol")</li>
            <li data-rule="upper">@L.T("Böyük hərf (A–Z)")</li>
            <li data-rule="lower">@L.T("Kiçik hərf (a–z)")</li>
            <li data-rule="digit">@L.T("Rəqəm (0–9)")</li>
            <li data-rule="symbol">@L.T("Xüsusi simvol (! @ # $)")</li>
        </ul>
    </div>

    <div class="auth-field">
        <label asp-for="ConfirmPassword">@L.T("Şifrə təkrarı")</label>
        <div class="auth-input auth-input--password">
            <i class="fa-solid fa-lock"></i>
            <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="@L.T("Şifrəni təkrar yazın")" />
            <button type="button" class="auth-eye" data-toggle-password="ConfirmPassword" aria-label="@L.T("Şifrəni göstər")" aria-pressed="false">
                <i class="fa-regular fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword"></span>
        <small class="auth-match" data-match-for="ConfirmPassword" data-match-with="Password"><i></i><span></span></small>
    </div>

    <button type="submit" class="auth-btn">
        @L.T("Qeydiyyatdan keç") <i class="fa-solid fa-arrow-right"></i>
    </button>
</form>

<div class="auth-switch">
    @L.T("Artıq hesabınız var?") <a asp-action="Login" asp-controller="Account">@L.T("Daxil olun")</a>
</div>
