@* Video / səsli zəng (WebRTC) — ayrıca səhifə, layout yoxdur. Bax: Controllers/CallController.cs, wwwroot/js/call.js *@
@{
    Layout = null;
    var ice = ViewData["IceServers"];
    var lang = Context.Request.Query["lang"].ToString();
    if (!L.IsSupported(lang)) lang = L.Lang;
    var config = new
    {
        iceServers = ice,
        isAuthenticated = User.Identity?.IsAuthenticated ?? false,
        currentUser = User.Identity?.Name,
        loginUrl = Url.Action("Login", "Account", new { returnUrl = Context.Request.Path + Context.Request.QueryString })
    };
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b141a" />
    <title>@L.T("Zəng") · DoctorEngine</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/call.css" asp-append-version="true" />
    <script src="~/Language/Js?lang=@lang&v=@L.JsVersion"></script>
</head>
<body>
    <main class="dc-call" data-state="init">
        <!-- Uzaq iştirakçılar -->
        <section class="dc-call__grid" aria-live="polite"></section>

        <!-- Zəng gedir / gözlənilir -->
        <div class="dc-call__center">
            <div class="dc-call__avatar"><i class="fa-solid fa-user"></i></div>
            <h1 class="dc-call__title"></h1>
            <p class="dc-call__status">@L.T("Qoşulur…")</p>
        </div>

        <!-- Öz kameram -->
        <video class="dc-call__self" autoplay playsinline muted></video>

        <header class="dc-call__top">
            <span class="dc-call__lock"><i class="fa-solid fa-lock"></i> @L.T("Birbaşa bağlantı")</span>
            <span class="dc-call__timer" hidden>0:00</span>
        </header>

        <footer class="dc-call__bar">
            <button type="button" class="dc-call__btn" data-act="camera" title="@L.T("Kamera")" aria-label="@L.T("Kamera")"><i class="fa-solid fa-video"></i></button>
            <button type="button" class="dc-call__btn" data-act="flip" title="@L.T("Kameranı çevir")" aria-label="@L.T("Kameranı çevir")" hidden><i class="fa-solid fa-camera-rotate"></i></button>
            <button type="button" class="dc-call__btn" data-act="mic" title="@L.T("Mikrofon")" aria-label="@L.T("Mikrofon")"><i class="fa-solid fa-microphone"></i></button>
            <button type="button" class="dc-call__btn is-end" data-act="end" title="@L.T("Zəngi bitir")" aria-label="@L.T("Zəngi bitir")"><i class="fa-solid fa-phone-slash"></i></button>
        </footer>
    </main>

    <script id="dcCallConfig" type="application/json">@Json.Serialize(config)</script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="~/js/call.js" asp-append-version="true"></script>
</body>
</html>
