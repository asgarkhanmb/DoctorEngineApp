@* Xüsusiyyət kartları (Keyfiyyətli Xidmət, Ekspert İşçilər ...) — Ana səhifə, Haqqımızda, Rezervasiya *@
@using DoctorEngineApp.ViewModels.Infroms
@model List<InformVM>

@if (Model != null && Model.Any())
{
    <div class="container-xxl py-5">
        <div class="container">
            <div class="row g-4">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    @* Planşetdə (2 sütun) tək sayda kart olanda sonuncu tək qalmasın — tam enə uzansın *@
                    <div class="col-lg-4 @(Model.Count % 2 == 1 && i == Model.Count - 1 ? "col-md-12" : "col-md-6") wow fadeInUp" data-wow-delay="@($"{i * 0.12 + 0.1:0.00}s")">
                        <div class="de-feature">
                            @if (!string.IsNullOrEmpty(item.Icon))
                            {
                                <div class="de-feature__icon">
                                    <img src="@item.Icon" alt="" loading="lazy" />
                                </div>
                            }
                            <div>
                                <h5>@L.T(item.Title)</h5>
                                <p>@L.T(item.Description)</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
