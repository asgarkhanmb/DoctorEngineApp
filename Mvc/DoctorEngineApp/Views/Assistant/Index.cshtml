@using DoctorEngineApp.Services
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "AI Köməkçi";
    var configured = ViewBag.AiConfigured as bool? ?? false;
    var quota = ViewBag.AiQuota as AiQuota ?? new AiQuota(0, 0);
    var config = new
    {
        token = Antiforgery.GetAndStoreTokens(Context).RequestToken,
        maxLength = AiAssistantService.MaxUserMessageLength,
        configured,
        remaining = quota.Remaining,
        limit = quota.Limit
    };
    var suggestions = new[]
    {
        ("fa-solid fa-gauge-high", "Mühərrik soyuqda çətin işə düşür, səbəbi nə ola bilər?"),
        ("fa-solid fa-oil-can", "Yağ təzyiqi lampası yanır, sürmək olarmı?"),
        ("fa-regular fa-clock", "İş saatlarınız və ünvanınız nədir?"),
        ("fa-regular fa-calendar-check", "Necə rezervasiya edə bilərəm?"),
        ("fa-solid fa-screwdriver-wrench", "Hansı xidmətləri göstərirsiniz?"),
        ("fa-solid fa-smog", "İşlənmiş qazdan qara tüstü çıxır, nədir?")
    };
}

@section css {
    <link rel="stylesheet" href="~/css/assistant.css" asp-append-version="true" />
}

<partial name="_PageHeader" model='("AI Köməkçi", "Mühərrik problemləri, xidmətlər, iş saatları və rezervasiya barədə suallarınıza dərhal cavab — günün istənilən vaxtı.")' />

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-4">

            <!-- ================= SÖHBƏT ================= -->
            <div class="col-lg-8">
                <section class="ai" id="ai" aria-label="@L.T("AI köməkçi ilə söhbət")">

                    <header class="ai__head">
                        <span class="ai__avatar" aria-hidden="true"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
                        <div class="ai__title">
                            <h2>@L.T("DoctorEngine Köməkçi")</h2>
                            <span class="ai__status @(configured ? "is-on" : "is-off")">
                                <span class="ai__dot"></span>
                                @(configured ? L.T("Süni intellekt · adətən bir neçə saniyəyə cavab verir") : L.T("Tezliklə aktiv olacaq"))
                            </span>
                        </div>
                        <button type="button" class="ai__icon-btn" data-ai-reset title="@L.T("Yeni söhbət")" aria-label="@L.T("Yeni söhbət")" hidden>
                            <i class="fa-solid fa-rotate-right"></i>
                        </button>
                    </header>

                    <div class="ai__body" role="log" aria-live="polite">

                        <div class="ai__welcome">
                            <div class="ai__welcome-icon" aria-hidden="true"><i class="fa-solid fa-robot"></i></div>
                            <h3>@L.T("Salam! Mən DoctorEngine-in AI köməkçisiyəm 👋")</h3>
                            <p>@L.T("Mühərrikinizdə nə problem var? Əlaməti yazın — mümkün səbəbləri izah edim, xidmətlərimiz və rezervasiya barədə məlumat verim.")</p>

                            <div class="ai__suggestions">
                                @foreach (var (icon, text) in suggestions)
                                {
                                    <button type="button" class="ai__chip" data-ai-suggest="@L.T(text)" disabled="@(!configured || quota.Remaining <= 0)">
                                        <i class="@icon" aria-hidden="true"></i><span>@L.T(text)</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="ai__list"></div>
                    </div>

                    @if (configured)
                    {
                        <div class="ai__limit" data-ai-limit-box hidden="@(quota.Remaining > 0)">
                            <i class="fa-regular fa-hourglass-half"></i>
                            <span>@L.Html("Bugünkü {0} pulsuz sual limitiniz doldu — sabah yenidən yaza bilərsiniz. Təcili sualınız varsa, {1} yazın.", $"<b>{quota.Limit}</b>", $"<a href=\"{Url.Action("Index", "Contact")}#chat\">{System.Net.WebUtility.HtmlEncode(L.T("usta ilə canlı çatda"))}</a>")</span>
                        </div>
                        <form class="ai__composer" novalidate hidden="@(quota.Remaining <= 0)">
                            <div class="ai__input-wrap">
                                <textarea class="ai__input" rows="1" maxlength="@AiAssistantService.MaxUserMessageLength"
                                          placeholder="@L.T("Sualınızı yazın… (məs: mühərrikdən tıqqıltı səsi gəlir)")" aria-label="@L.T("Sual")"></textarea>
                                <button type="submit" class="ai__send" title="@L.T("Göndər")" aria-label="@L.T("Göndər")" disabled>
                                    <i class="fa-solid fa-arrow-up"></i>
                                </button>
                                <button type="button" class="ai__stop" title="@L.T("Dayandır")" aria-label="@L.T("Dayandır")" hidden>
                                    <i class="fa-solid fa-stop"></i>
                                </button>
                            </div>
                            <div class="ai__hint">
                                <span class="ai__quota" title="@L.T("Gündəlik pulsuz limit. Bakı vaxtı ilə gecə yarısı yenilənir.")">
                                    <i class="fa-solid fa-bolt"></i> @L.Html("Bu gün {0} / {1} sual qalıb", $"<b data-ai-remaining>{quota.Remaining}</b>", quota.Limit)
                                </span>
                                <span class="ai__counter" aria-hidden="true"></span>
                                <span class="ai__privacy"><i class="fa-solid fa-shield-halved"></i> @L.T("Şəxsi məlumat yazmayın")</span>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="ai__offline">
                            <i class="fa-solid fa-circle-info"></i>
                            <span>@L.Html("AI köməkçi tezliklə aktiv olacaq. Hələlik {0} yazın.", $"<a href=\"{Url.Action("Index", "Contact")}#chat\">{System.Net.WebUtility.HtmlEncode(L.T("usta ilə canlı çatda"))}</a>")</span>
                        </div>
                    }
                </section>
            </div>

            <!-- ================= YAN PANEL ================= -->
            <div class="col-lg-4">
                <aside class="ai-side">

                    <div class="ai-card ai-card--accent">
                        <h3><i class="fa-solid fa-user-gear"></i> @L.T("Usta ilə danışın")</h3>
                        <p>@L.T("Dəqiq diaqnoz və qiymət üçün ustalarımızla birbaşa əlaqə saxlayın.")</p>
                        <a asp-controller="Contact" asp-action="Index" asp-fragment="chat" class="btn btn-light w-100 mb-2">
                            <i class="fa-regular fa-comments me-2"></i> @L.T("Canlı çat")
                        </a>
                        <a asp-controller="Reservation" asp-action="Index" class="btn btn-primary w-100">
                            <i class="fa-regular fa-calendar-check me-2"></i> @L.T("Rezervasiya et")
                        </a>
                    </div>

                    <div class="ai-card">
                        <h3><i class="fa-solid fa-route"></i> @L.T("Necə işləyir?")</h3>
                        <ol class="ai-steps">
                            <li><b>@L.T("Problemi təsvir edin")</b><span>@L.T("Əlaməti, maşının modelini və ilini yazın.")</span></li>
                            <li><b>@L.T("AI izah edir")</b><span>@L.T("Mümkün səbəblər və nə etməli olduğunuz.")</span></li>
                            <li><b>@L.T("Ustaya gəlin")</b><span>@L.T("Rezervasiya edin — dəqiq diaqnozu ustalar qoyur.")</span></li>
                        </ol>
                    </div>

                    <div class="ai-card ai-card--note">
                        <h3><i class="fa-solid fa-circle-exclamation"></i> @L.T("Bilməli olduğunuz")</h3>
                        <ul>
                            <li>@L.T("AI səhv edə bilər — cavablar məlumat xarakterlidir, diaqnoz deyil.")</li>
                            <li>@L.T("Qiymət diaqnostikadan sonra müəyyən olunur.")</li>
                            <li>@L.Html("Hər istifadəçi gündə {0} sual verə bilər — qeydiyyat lazım deyil.", $"<b>{quota.Limit}</b>")</li>
                            <li>@L.T("Şəxsi məlumat (FİN, kart, parol) yazmayın.")</li>
                            <li>@L.T("Söhbət yalnız bu brauzer pəncərəsində saxlanılır.")</li>
                        </ul>
                    </div>
                </aside>
            </div>

        </div>
    </div>
</div>

<script id="aiConfig" type="application/json">@Json.Serialize(config)</script>

@section Scripts {
    <script src="~/js/assistant.js" asp-append-version="true"></script>
}
