@model List<Slider>
@{
    ViewData["Title"] = "Slayder";
}

<partial name="_PageHead" model='new AdminPageHead("Slayder", "Ana səhifənin yuxarısındakı slaydlar. Hər 6 saniyədən bir bu sıra ilə dəyişir. Fon şəkli ən azı 1920 px enində olmalıdır — əks halda bulanıq görünür.", "Yeni slayd", "Create")' />

<div class="adm-card">

        @if (!Model.Any())
        {
            <div class="adm-empty"><i class="fa-regular fa-images"></i><strong>Hələ slayd yoxdur</strong>Saytda standart başlıq göstərilir.</div>
        }
        else
        {
            <div class="adm-table-wrap">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th style="width:60px">#</th>
                            <th style="width:170px">Şəkil</th>
                            <th>Başlıq</th>
                            <th class="adm-actions-col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var item = Model[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>
                                    <img src="~/uploads/sliders/@item.Image1" alt="" data-check-res
                                         style="width:150px;height:70px;object-fit:cover;border-radius:6px" />
                                    <span class="adm-badge is-pending d-none mt-1" data-res-badge>Aşağı keyfiyyət</span>
                                </td>
                                <td>
                                    <div class="adm-cell-sub text-uppercase">@item.Title</div>
                                    <div class="adm-cell-title">@item.Subtitle</div>
                                </td>
                                <td class="adm-actions-col">
                                    <div class="adm-actions">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="adm-act" title="Redaktə et" aria-label="Redaktə et"><i class="fa-solid fa-pen"></i></a>
                                        <partial name="_DeleteButton" model='new AdminDeleteButton("Delete", item.Id, "Bu slayd silinsin?")' />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

<script>
    // Kiçik ölçülü fon şəkillərini işarələ
    document.querySelectorAll("[data-check-res]").forEach(function (img) {
        function check() {
            if (img.naturalWidth && img.naturalWidth < 1280) {
                const badge = img.parentElement.querySelector("[data-res-badge]");
                badge.textContent = "Aşağı keyfiyyət: " + img.naturalWidth + "×" + img.naturalHeight;
                badge.classList.remove("d-none");
                badge.style.display = "inline-block";
            }
        }
        if (img.complete) check(); else img.addEventListener("load", check);
    });
</script>
