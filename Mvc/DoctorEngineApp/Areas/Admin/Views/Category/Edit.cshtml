@model CategoryEditVM
@{
    ViewData["Title"] = "Kateqoriyanı redaktə et";
    var returnUrl = Url.Action("Edit", new { id = Model.Id });
}

<partial name="_PageHead" model='new AdminPageHead(Model.Name, "Kateqoriyanın adı, ikonu və videosu.", BackAction: "Index")' />

<div class="adm-card" style="max-width:820px">
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="adm-form">
        <div class="adm-card__body">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly"></div>
            <div class="adm-form-section">
                <h3>Kateqoriya</h3>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Ad</label>
                    <input asp-for="Name" class="form-control" placeholder="Məs: Yağ dəyişmə" />
                    <span asp-validation-for="Name"></span>
                </div>
                <partial name="_IconPicker" model='new DoctorEngineApp.Helpers.CategoryIconPicker(Model.PresetIcon, Model.ExistingIcon, Required: false)' />
            </div>
            <div class="adm-form-section">
                <h3>Video <small class="text-muted text-lowercase">(hər kateqoriyada bir video)</small></h3>
                @if (!string.IsNullOrEmpty(Model.ExistingVideo))
                {
                    <div class="d-flex gap-3 align-items-start mb-3 p-3 rounded-3" style="background:#f8f9fc">
                        <div style="width:240px;flex-shrink:0"><partial name="_VideoFrame" model='new VideoFrame(Url.Content($"~/uploads/subvideos/{Model.ExistingVideo}"), "compact")' /></div>
                        <div>
                            <div class="adm-cell-title mb-1">Mövcud video</div>
                            <div class="form-text mt-0 mb-2">Yeni video seçsəniz bu əvəz olunacaq. Başlıq və təsviri aşağıda dəyişə bilərsiniz.</div>
                            <label class="form-check mb-0">
                                <input asp-for="RemoveVideo" type="checkbox" class="form-check-input" />
                                <span class="form-check-label text-danger">Videonu sil (kateqoriya “Tezliklə” kimi görünəcək)</span>
                            </label>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning py-2 px-3 small mb-3"><i class="fa-solid fa-circle-info me-1"></i> Bu kateqoriyanın hələ videosu yoxdur — saytda “Tezliklə” kimi görünür. Aşağıdan əlavə edin.</div>
                }
                <div class="mb-3">
                    <label asp-for="VideoTitle" class="form-label">Başlıq</label>
                    <input asp-for="VideoTitle" class="form-control" maxlength="150" placeholder="Məs: Mühərrik diaqnostikası və təmiri" />
                    <span asp-validation-for="VideoTitle"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="VideoDescription" class="form-label">Təsvir</label>
                    <textarea asp-for="VideoDescription" class="form-control" rows="3" maxlength="1000" placeholder="Bu xidmətdə nə edilir — 1–2 cümlə"></textarea>
                    <span asp-validation-for="VideoDescription"></span>
                </div>
                <div class="adm-upload">
                    <div class="adm-upload__preview" id="videoPreview"><i class="fa-solid fa-film"></i></div>
                    <div class="adm-upload__body">
                        <label asp-for="VideoFile" class="form-label">@(Model.ExistingVideo == null ? "Video faylı" : "Videonu dəyiş") <small class="text-muted">(ixtiyari)</small></label>
                        <input asp-for="VideoFile" type="file" class="form-control" accept="video/mp4,video/webm,video/quicktime" data-preview="#videoPreview" />
                        <div class="form-text">MP4 tövsiyə olunur. Telefonla çəkilmiş (şaquli) videolar da kəsilmədən göstərilir.</div>
                        <span asp-validation-for="VideoFile"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="adm-form-actions">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i> Yadda saxla</button>
            <a asp-action="Index" class="btn btn-light">Ləğv et</a>
        </div>
    </form>
</div>

@if (Model.ExtraVideos.Any())
{
    <div class="adm-card mt-4" style="max-width:820px;border-color:#f3c2c7">
        <div class="adm-card__head">
            <h2><i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>Bu kateqoriyada artıq video var</h2>
        </div>
        <div class="adm-card__body">
            <p class="form-text mt-0">Hər kateqoriyada bir video göstərilir. Aşağıdakılar saytda <b>görünmür</b> — onları boş kateqoriyaya köçürün və ya silin.</p>
            @foreach (var x in Model.ExtraVideos)
            {
                <div class="d-flex flex-wrap align-items-center gap-3 py-3 border-top">
                    @if (!string.IsNullOrEmpty(x.Video))
                    {
                        <partial name="_VideoFrame" model='new VideoFrame(Url.Content($"~/uploads/subvideos/{x.Video}"), "thumb")' />
                    }
                    <div class="adm-cell-title flex-grow-1">@x.Title</div>

                    @if (Model.EmptyCategories.Any())
                    {
                        <form asp-controller="SubService" asp-action="Move" method="post" class="d-flex gap-2 align-items-center">
                            <input type="hidden" name="id" value="@x.Id" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <select name="categoryId" class="form-select form-select-sm" style="min-width:200px" aria-label="Köçürüləcək kateqoriya">
                                @foreach (var opt in Model.EmptyCategories)
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-light btn-sm text-nowrap"><i class="fa-solid fa-arrow-right-arrow-left"></i> Köçür</button>
                        </form>
                    }
                    <form asp-controller="SubService" asp-action="Delete" asp-route-id="@x.Id" method="post">
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-light btn-sm text-danger" data-confirm="“@x.Title” videosu silinsin?"><i class="fa-regular fa-trash-can"></i> Sil</button>
                    </form>
                </div>
            }
            @if (!Model.EmptyCategories.Any())
            {
                <p class="form-text mb-0">Köçürmək üçün boş kateqoriya yoxdur — <a asp-action="Create">yeni kateqoriya yaradın</a> və ya videonu silin.</p>
            }
        </div>
    </div>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
