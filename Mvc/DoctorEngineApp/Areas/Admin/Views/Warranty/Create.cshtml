@model WarrantyCreateVM
@{
    ViewData["Title"] = "Yeni zəmanət";
    var items = Model?.Items?.Any() == true ? Model.Items : new List<WarrantyItemVM> { new() };
}

<partial name="_PageHead" model='new AdminPageHead("Yeni zəmanət sənədi", BackAction: "Index")' />

<div class="adm-card" style="max-width:900px">
    <form asp-action="Create" method="post" class="adm-form">
        <div class="adm-card__body">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="adm-form-section">
                <h3>Müştəri və avtomobil</h3>
                <div class="row g-3">
                    <div class="col-md-5">
                        <label asp-for="CustomerFullName" class="form-label">Müştəri (ad soyad)</label>
                        <input asp-for="CustomerFullName" class="form-control" />
                        <span asp-validation-for="CustomerFullName"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="VehicleModel" class="form-label">Avtomobil modeli</label>
                        <input asp-for="VehicleModel" class="form-control" placeholder="Məs: BMW X6 3.0d" />
                        <span asp-validation-for="VehicleModel"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="VehicleYear" class="form-label">Buraxılış ili</label>
                        <input asp-for="VehicleYear" type="number" min="1950" max="2100" class="form-control" />
                        <span asp-validation-for="VehicleYear"></span>
                    </div>
                </div>
            </div>

            <div class="adm-form-section">
                <h3>Zəmanətli detallar</h3>
                <span asp-validation-for="Items"></span>
                <div id="items" class="d-grid gap-2">
                    @for (int i = 0; i < items.Count; i++)
                    {
                        <div class="row g-2 align-items-start" data-item>
                            <div class="col-6 col-md-8">
                                <input name="Items[@i].PartName" value="@items[i].PartName" class="form-control" required placeholder="Detal (məs: turbin)" />
                                <span asp-validation-for="Items[i].PartName"></span>
                            </div>
                            <div class="col-4 col-md-3">
                                <div class="input-group">
                                    <input name="Items[@i].WarrantyMonth" value="@items[i].WarrantyMonth" type="number" min="1" max="120" class="form-control" required />
                                    <span class="input-group-text">ay</span>
                                </div>
                                <span asp-validation-for="Items[i].WarrantyMonth"></span>
                            </div>
                            <div class="col-2 col-md-1 text-end">
                                <button type="button" class="adm-act is-danger" data-remove-item aria-label="Sil" title="Sil"><i class="fa-solid fa-xmark"></i></button>
                            </div>
                        </div>
                    }
                </div>
                <button type="button" class="btn btn-light btn-sm mt-2" id="addItem"><i class="fa-solid fa-plus"></i> Detal əlavə et</button>
            </div>

            <div class="adm-form-section">
                <h3>Şərtlər</h3>
                <textarea asp-for="Terms" class="form-control" rows="5" placeholder="Zəmanətin şərtləri…"></textarea>
                <span asp-validation-for="Terms"></span>
            </div>
        </div>
        <div class="adm-form-actions">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i> Yarat</button>
            <a asp-action="Index" class="btn btn-light">Ləğv et</a>
        </div>
    </form>
</div>

<template id="itemTpl">
    <div class="row g-2 align-items-start" data-item>
        <div class="col-6 col-md-8"><input data-field="PartName" class="form-control" required placeholder="Detal (məs: turbin)" /></div>
        <div class="col-4 col-md-3">
            <div class="input-group"><input data-field="WarrantyMonth" type="number" min="1" max="120" value="6" class="form-control" required /><span class="input-group-text">ay</span></div>
        </div>
        <div class="col-2 col-md-1 text-end"><button type="button" class="adm-act is-danger" data-remove-item aria-label="Sil" title="Sil"><i class="fa-solid fa-xmark"></i></button></div>
    </div>
</template>

@section Scripts {
    <script>
        (function () {
            const list = document.getElementById("items");
            const tpl = document.getElementById("itemTpl");

            // Sətirlərin indekslərini ardıcıl saxla (Items[0], Items[1] ...) — model binding üçün vacibdir
            function reindex() {
                list.querySelectorAll("[data-item]").forEach((row, i) => {
                    row.querySelectorAll("input").forEach((input) => {
                        const field = input.dataset.field || input.name.replace(/^Items\[\d+\]\./, "");
                        input.dataset.field = field;
                        input.name = "Items[" + i + "]." + field;
                    });
                });
                const rows = list.querySelectorAll("[data-item]");
                rows.forEach((r) => r.querySelector("[data-remove-item]").disabled = rows.length === 1);
            }

            document.getElementById("addItem").addEventListener("click", () => {
                list.appendChild(tpl.content.cloneNode(true));
                reindex();
                list.lastElementChild.querySelector("input").focus();
            });

            list.addEventListener("click", (e) => {
                const btn = e.target.closest("[data-remove-item]");
                if (!btn) return;
                btn.closest("[data-item]").remove();
                reindex();
            });

            reindex();
        })();
    </script>
}
