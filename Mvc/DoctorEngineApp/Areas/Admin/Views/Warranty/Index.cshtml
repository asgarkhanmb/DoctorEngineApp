@model IEnumerable<Warranty>
@{ ViewData["Title"] = "Zəmanətlər"; }

<partial name="_PageHead" model='new AdminPageHead("Zəmanətlər", "Müştərilərə verilən zəmanət sənədləri — PDF kimi çap edilə bilər.", "Yeni zəmanət", "Create")' />

<div class="adm-card">
    <div class="adm-card__head">
        <span class="text-muted">Cəmi: @Model.Count()</span>
        <div class="adm-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" class="form-control form-control-sm" data-table-search="#wTable" placeholder="Müştəri, avtomobil…" />
        </div>
    </div>
    @if (!Model.Any())
    {
        <div class="adm-empty"><i class="fa-solid fa-shield-halved"></i><strong>Hələ zəmanət sənədi yoxdur</strong></div>
    }
    else
    {
        <div class="adm-table-wrap">
            <table class="adm-table" id="wTable">
                <thead><tr><th>Müştəri</th><th>Avtomobil</th><th>Tarix</th><th class="adm-actions-col"></th></tr></thead>
                <tbody>
                    @foreach (var item in Model.OrderByDescending(w => w.CreatedDate))
                    {
                        <tr data-row>
                            <td class="adm-cell-title"><a asp-action="Detail" asp-route-id="@item.Id" class="text-reset">@item.CustomerFullName</a></td>
                            <td>@item.VehicleModel <span class="adm-cell-sub">(@item.VehicleYear)</span></td>
                            <td class="adm-cell-sub text-nowrap">@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                            <td class="adm-actions-col">
                                <div class="adm-actions">
                                    <a asp-action="Detail" asp-route-id="@item.Id" class="adm-act" title="Bax" aria-label="Bax"><i class="fa-regular fa-eye"></i></a>
                                    <a asp-action="Print" asp-route-id="@item.Id" class="adm-act" title="PDF" aria-label="PDF" target="_blank"><i class="fa-regular fa-file-pdf"></i></a>
                                    <partial name="_DeleteButton" model='new AdminDeleteButton("Delete", item.Id, $"{item.CustomerFullName} — zəmanət silinsin?")' />
                                </div>
                            </td>
                        </tr>
                    }
                    <tr data-search-empty hidden><td colspan="4"><div class="adm-empty"><i class="fa-solid fa-magnifying-glass"></i>Nəticə tapılmadı</div></td></tr>
                </tbody>
            </table>
        </div>
    }
</div>
