@model AboutEditVM
@{ ViewData["Title"] = "Haqqımızda — redaktə"; }

<partial name="_PageHead" model='new AdminPageHead("Redaktə et", BackAction: "Index")' />

<div class="adm-card" style="max-width:820px">
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="adm-form">
        <div class="adm-card__body">
            <input asp-for="Id" type="hidden" /><input asp-for="CurrentVideo" type="hidden" />
            <div asp-validation-summary="ModelOnly"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Başlıq</label>
                <input asp-for="Title" class="form-control" maxlength="200" placeholder="Məs: DoctorEngine Avtomobil Baxımı üçün ən yaxşı məkandır" />
                <span asp-validation-for="Title"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Mətn</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.CurrentVideo))
            {
                <div class="mb-3">
                    <label class="form-label">Mövcud video</label>
                    <partial name="_VideoFrame" model='new VideoFrame(Url.Content(Model.CurrentVideo), "compact")' />
                </div>
            }

            <div class="adm-upload">
                <div class="adm-upload__preview" id="videoPreview"><i class="fa-solid fa-film"></i></div>
                <div class="adm-upload__body">
                    <label asp-for="VideoFile" class="form-label">Yeni video <small class="text-muted">(ixtiyari — mövcudu əvəz edir)</small></label>
                    <input asp-for="VideoFile" type="file" class="form-control" accept="video/mp4,video/webm,video/quicktime" data-preview="#videoPreview" />
                    <div class="form-text">MP4 tövsiyə olunur, maksimum 1 GB.</div>
                    <span asp-validation-for="VideoFile"></span>
                </div>
            </div>
        </div>
        <div class="adm-form-actions">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i> Yadda saxla</button>
            <a asp-action="Index" class="btn btn-light">Ləğv et</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
