@model About
@{ ViewData["Title"] = "Haqqımızda"; }

<partial name="_PageHead" model='new AdminPageHead(string.IsNullOrWhiteSpace(Model.Title) ? "(başlıqsız)" : Model.Title, BackAction: "Index")' />

<div class="adm-card" style="max-width:820px">
    @if (!string.IsNullOrEmpty(Model.VideoPath))
    {
        <div class="p-3 pb-0"><partial name="_VideoFrame" model='new VideoFrame(Url.Content(Model.VideoPath))' /></div>
    }
    <div class="adm-card__body">
        <p class="mb-0" style="white-space:pre-wrap">@Model.Description</p>
    </div>
    <div class="adm-form-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="fa-solid fa-pen"></i> Redaktə et</a>
    </div>
</div>
