@model List<About>
@{
    ViewData["Title"] = "Haqqımızda";
}

<partial name="_PageHead" model='new AdminPageHead("Haqqımızda", "Ana səhifədə və Haqqımızda səhifəsində göstərilən başlıq, mətn və video. Saytda birinci qeyd istifadə olunur.", "Yeni qeyd", "Create")' />

@if (!Model.Any())
{
    <div class="adm-card"><div class="adm-empty"><i class="fa-regular fa-address-card"></i><strong>Hələ məlumat yoxdur</strong>Haqqımızda bölməsi üçün başlıq, mətn və video əlavə edin.</div></div>
}
else
{
    <div class="row g-4">
        @for (int i = 0; i < Model.Count; i++)
        {
            var a = Model[i];
            <div class="col-xl-6">
                <div class="adm-card h-100">
                    @if (!string.IsNullOrEmpty(a.VideoPath))
                    {
                        <div class="p-3 pb-0"><partial name="_VideoFrame" model='new VideoFrame(Url.Content(a.VideoPath), "compact")' /></div>
                    }
                    <div class="adm-card__body">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h3 class="h5 mb-0">@(string.IsNullOrWhiteSpace(a.Title) ? "(başlıqsız)" : a.Title)</h3>
                            @if (i == 0) { <span class="adm-badge is-confirmed"><i class="fa-solid fa-eye"></i> Saytda</span> }
                        </div>
                        <p class="adm-clamp mb-3" style="max-width:none">@a.Description</p>
                        <div class="adm-actions">
                            <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-light btn-sm"><i class="fa-solid fa-pen"></i> Redaktə et</a>
                            <partial name="_DeleteButton" model='new AdminDeleteButton("Delete", a.Id, "Bu qeyd və videosu silinsin?")' />
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
