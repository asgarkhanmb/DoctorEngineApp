<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- KÖHNƏ MVC SAYT: tam müstəqil layihə (öz Models, Data/Migrations, Services, Localization kodu).
       API (Server/Api) ilə eyni bazanı istifadə edir, amma koda istinad etmir — model/miqrasiya dəyişəndə hər ikisini yeniləyin. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>04e2fe2a-92d2-44ac-9801-815a0ff0a6d8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- dotnet ef: miqrasiyalar Server/Api-də yaradılır (dotnet ef migrations add X -p Server/Api/DoctorEngine.Infrastructure -s Server/Api/DoctorEngine.Api),
         sonra Migrations/ qovluğu bura da kopyalanır -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.3" />
    <PackageReference Include="Rotativa.AspNetCore" Version="1.4.0" />

    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="MimeKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="WebPush" Version="1.0.12" />
    <!-- WebPush köhnə Newtonsoft.Json 10.0.3 gətirir (məlum zəiflik) — təhlükəsiz versiyaya qaldırılır -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Əllə tərcümə olunmuş UI/JS mətnləri (az → en/ru/tr) -->
  <ItemGroup>
    <!-- WithCulture=false: "ui.en.json"-dakı ".en" mədəniyyət kimi oxunmasın (yoxsa satellite assembly-yə düşür) -->
    <EmbeddedResource Include="Localization\*.json" WithCulture="false" />
    <Content Remove="Localization\*.json" />
    <None Remove="Localization\*.json" />
  </ItemGroup>

</Project>
