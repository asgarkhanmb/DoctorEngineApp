<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:l="clr-namespace:DoctorEngine.App.Localization"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:DoctorEngine.App.Views"
       x:Class="DoctorEngine.App.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.TabBarIsVisible="False"
       Title="DoctorEngine">

    <!-- Bölmələr. Shell-in öz tab paneli gizlidir (Windows-da yuxarıda görünürdü) — alt menyu Views/BottomNav.cs-dədir -->
    <TabBar>
        <ShellContent Title="{l:Tr tab_home}" Icon="tab_home.png" Route="home"
                      ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="{l:Tr tab_services}" Icon="tab_services.png" Route="services"
                      ContentTemplate="{DataTemplate views:ServicesPage}" />
        <!-- Instagram Reels kimi video lenti (Android alt menyusu maks. 5 tab — Rezervasiya ana səhifədən / xidmətlərdən / profildən açılır) -->
        <ShellContent Title="{l:Tr tab_reels}" Icon="tab_reels.png" Route="reels"
                      ContentTemplate="{DataTemplate views:ReelsPage}" />
        <ShellContent Title="{l:Tr notif_title}" Route="notifications"
                      ContentTemplate="{DataTemplate views:NotificationsPage}" />
        <ShellContent Title="{l:Tr tab_chat}" Icon="tab_chat.png" Route="chat"
                      ContentTemplate="{DataTemplate views:ChatPage}" />
        <ShellContent Title="{l:Tr tab_profile}" Icon="tab_profile.png" Route="profile"
                      ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>
</Shell>
