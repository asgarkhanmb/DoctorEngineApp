<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:DoctorEngine.App.Converters"
             x:Class="DoctorEngine.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InvertedBoolConverter x:Key="InvertedBool" />
            <conv:HasValueConverter x:Key="HasValue" />
            <conv:StatusTextConverter x:Key="StatusText" />
            <conv:StatusColorConverter x:Key="StatusColor" />
            <conv:MineAlignConverter x:Key="MineAlign" />
            <conv:BubbleColorConverter x:Key="BubbleColor" />
            <conv:BubbleTextColorConverter x:Key="BubbleText" />
            <conv:SelectedBackgroundConverter x:Key="SelectedBg" />
            <conv:SelectedTextColorConverter x:Key="SelectedText" />
            <conv:UpperAzConverter x:Key="UpperAz" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
