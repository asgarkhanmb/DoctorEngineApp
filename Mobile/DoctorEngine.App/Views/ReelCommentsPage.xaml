<?xml version="1.0" encoding="utf-8" ?>
<!--
    Rəylər — Instagram kimi aşağıdan açılan pəncərə (arxada video oynamağa davam edir).
    Hər rəydə kiçik əməliyyatlar: cavab ver, (öz rəyi) redaktə et, sil. Cavablar rəyin altında içəri çəkilmiş görünür.
    Yazı sahəsində: stiker paneli, cavab / redaktə zolağı.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:DoctorEngine.App.Localization"
             xmlns:vm="clr-namespace:DoctorEngine.App.ViewModels"
             x:Class="DoctorEngine.App.Views.ReelCommentsPage"
             x:DataType="vm:ReelCommentsViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Shell.PresentationMode="ModalAnimated"
             BackgroundColor="#73000000"
             SafeAreaEdges="All"
             Title="{l:Tr reels_comments}">

    <ContentPage.Resources>
        <Style x:Key="MiniAction" TargetType="Label">
            <Setter Property="FontFamily" Value="BarlowSemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="#8A8F98" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="MiniIcon" TargetType="Image">
            <Setter Property="WidthRequest" Value="14" />
            <Setter Property="HeightRequest" Value="14" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="0.22*,0.78*">
        <!-- Yuxarı boş hissəyə toxunanda bağlanır -->
        <BoxView Color="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="Sheet" Grid.Row="1" StrokeThickness="0" StrokeShape="RoundRectangle 20,20,0,0" Padding="0"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- Tutacaq + başlıq -->
                <Grid Padding="14,8,8,10" RowDefinitions="Auto,Auto" RowSpacing="10">
                    <BoxView WidthRequest="36" HeightRequest="4" CornerRadius="2" HorizontalOptions="Center"
                             Color="{AppThemeBinding Light=#DBDBDB, Dark=#3A3A3A}" />
                    <Label Grid.Row="1" Text="{Binding Title}" FontFamily="BarlowBold" FontSize="15" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#111111, Dark=White}" />
                    <Image Grid.Row="1" Source="ic_close_g.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="End" Margin="0,0,6,0">
                        <Image.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseCommand}" /></Image.GestureRecognizers>
                    </Image>
                </Grid>
                <BoxView Grid.Row="1" HeightRequest="0.5" Color="{AppThemeBinding Light=#DBDBDB, Dark=#262626}" />

                <!-- Rəylər -->
                <CollectionView Grid.Row="2" ItemsSource="{Binding Comments}" SelectionMode="None"
                                RemainingItemsThreshold="4" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                    <CollectionView.EmptyView>
                        <Grid Padding="24,48">
                            <ActivityIndicator IsRunning="{Binding IsBusy, x:DataType=vm:ReelCommentsViewModel, Source={RelativeSource AncestorType={x:Type vm:ReelCommentsViewModel}}}"
                                               IsVisible="{Binding IsBusy, x:DataType=vm:ReelCommentsViewModel, Source={RelativeSource AncestorType={x:Type vm:ReelCommentsViewModel}}}"
                                               Color="{StaticResource Primary}" HorizontalOptions="Center" />
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center"
                                                 IsVisible="{Binding IsEmpty, x:DataType=vm:ReelCommentsViewModel, Source={RelativeSource AncestorType={x:Type vm:ReelCommentsViewModel}}}">
                                <Label Text="💬" FontSize="34" HorizontalOptions="Center" />
                                <Label Text="{l:Tr reels_comments_empty}" FontSize="14" HorizontalTextAlignment="Center" TextColor="#8A8F98" />
                            </VerticalStackLayout>
                            <Label Text="{Binding ErrorMessage, x:DataType=vm:ReelCommentsViewModel, Source={RelativeSource AncestorType={x:Type vm:ReelCommentsViewModel}}}"
                                   TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                        </Grid>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReelCommentItem">
                            <Grid Padding="{Binding Indent}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F3F4F6, Dark=#1E1E1E}" />
                                    </DataTrigger>
                                </Grid.Triggers>

                                <Border WidthRequest="{Binding AvatarSize}" HeightRequest="{Binding AvatarSize}" StrokeShape="Ellipse" StrokeThickness="0"
                                        VerticalOptions="Start" Background="{StaticResource PrimaryGradient}">
                                    <Grid>
                                        <Label Text="{Binding Initial}" TextColor="White" FontFamily="BarlowBold" FontSize="13"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" IsVisible="{Binding HasAvatar}" />
                                    </Grid>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <!-- Ad · vaxt · (redaktə edilib) -->
                                    <Label FontSize="12.5" LineBreakMode="TailTruncation">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding FullName}" FontFamily="BarlowBold"
                                                      TextColor="{AppThemeBinding Light=#111111, Dark=White}" />
                                                <Span Text="  " />
                                                <Span Text="{Binding Meta}" TextColor="#8A8F98" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <!-- Mətn (cavabda "@ad" önündə) -->
                                    <Label FontSize="14.5" LineBreakMode="WordWrap" IsVisible="{Binding HasText}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding ReplyToText}" FontFamily="BarlowSemiBold" TextColor="#3D7BD9" />
                                                <Span Text="{Binding Text}" TextColor="{AppThemeBinding Light=#111111, Dark=#F2F2F2}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <!-- Stiker -->
                                    <HorizontalStackLayout IsVisible="{Binding HasSticker}" Spacing="6">
                                        <Label Text="{Binding ReplyToText}" FontFamily="BarlowSemiBold" TextColor="#3D7BD9" FontSize="13" VerticalOptions="Center" IsVisible="{Binding ReplyToText, Converter={StaticResource HasValue}}" />
                                        <Label Text="{Binding Sticker}" FontSize="44" />
                                    </HorizontalStackLayout>

                                    <!-- Kiçik əməliyyatlar -->
                                    <HorizontalStackLayout Spacing="16" Margin="0,2,0,0">
                                        <HorizontalStackLayout Spacing="4">
                                            <Image Source="ic_reply2_g.png" Style="{StaticResource MiniIcon}" />
                                            <Label Text="{l:Tr reels_reply}" Style="{StaticResource MiniAction}" />
                                            <HorizontalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ReplyCommand, x:DataType=vm:ReelCommentsViewModel, Source={RelativeSource AncestorType={x:Type vm:ReelCommentsViewModel}}}"
                                                                      CommandParameter="{Binding .}" />
                                            </HorizontalStackLayout.GestureRecognizers>
                                        </HorizontalStackLayout>
                                        <Image Source="ic_edit_g.png" Style="{StaticResource MiniIcon}" IsVisible="{Binding CanEdit}">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding EditCommand, x:DataType=vm:ReelCommentsViewModel, Source={RelativeSource AncestorType={x:Type vm:ReelCommentsViewModel}}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                        <Image Source="ic_trash_g.png" Style="{StaticResource MiniIcon}" IsVisible="{Binding CanDelete}">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding DeleteCommand, x:DataType=vm:ReelCommentsViewModel, Source={RelativeSource AncestorType={x:Type vm:ReelCommentsViewModel}}}"
                                                                      CommandParameter="{Binding .}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Rəyi bəyən (Instagram kimi sağda kiçik ürək + say) -->
                                <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Start" Padding="6,4,2,4" WidthRequest="34">
                                    <Image Source="{Binding HeartIcon}" WidthRequest="15" HeightRequest="15" HorizontalOptions="Center" />
                                    <Label Text="{Binding LikesText}" IsVisible="{Binding HasLikes}" FontSize="11" TextColor="#8A8F98" HorizontalOptions="Center" />
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LikeCommentCommand, x:DataType=vm:ReelCommentsViewModel, Source={RelativeSource AncestorType={x:Type vm:ReelCommentsViewModel}}}"
                                                              CommandParameter="{Binding .}" />
                                    </VerticalStackLayout.GestureRecognizers>
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="8" Color="Transparent" />
                    </CollectionView.Footer>
                </CollectionView>

                <!-- ================= YAZI SAHƏSİ ================= -->
                <VerticalStackLayout Grid.Row="3" Spacing="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">
                    <BoxView HeightRequest="0.5" Color="{AppThemeBinding Light=#DBDBDB, Dark=#262626}" />

                    <!-- Cavab / redaktə zolağı -->
                    <Grid IsVisible="{Binding HasMode}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="16,8,12,8"
                          BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#1E1E1E}">
                        <Image Source="{Binding ModeIcon}" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding ModeText}" FontSize="12.5" TextColor="#8A8F98" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                        <Image Grid.Column="2" Source="ic_close_g.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center">
                            <Image.GestureRecognizers><TapGestureRecognizer Command="{Binding CancelModeCommand}" /></Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <!-- Stiker paneli -->
                    <CollectionView IsVisible="{Binding ShowStickers}" ItemsSource="{Binding Stickers}" SelectionMode="None" HeightRequest="120" Margin="8,6">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StickerItem">
                                <Label Text="{Binding Emoji}" FontSize="32" HorizontalOptions="Center" Padding="0,4">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SendStickerCommand, x:DataType=vm:ReelCommentsViewModel, Source={RelativeSource AncestorType={x:Type vm:ReelCommentsViewModel}}}"
                                                              CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid Padding="12,8,12,10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" IsVisible="{Binding IsLoggedIn}">
                            <Border WidthRequest="32" HeightRequest="32" StrokeShape="Ellipse" StrokeThickness="0" VerticalOptions="Center"
                                    Background="{StaticResource PrimaryGradient}">
                                <Grid>
                                    <Label Text="{Binding MyInitial}" TextColor="White" FontFamily="BarlowBold" FontSize="13"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Image Source="{Binding MyAvatar}" Aspect="AspectFill" IsVisible="{Binding HasMyAvatar}" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 20" StrokeThickness="0.8" Padding="14,0,6,0" HeightRequest="40"
                                    Stroke="{AppThemeBinding Light=#DBDBDB, Dark=#363636}" BackgroundColor="Transparent">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry x:Name="Input" Text="{Binding Text}" Placeholder="{l:Tr reels_comment_placeholder}" FontSize="14.5"
                                           MaxLength="1000" ReturnType="Send" ReturnCommand="{Binding SendCommand}" VerticalOptions="Center" />
                                    <Image Grid.Column="1" Source="ic_sticker_g.png" WidthRequest="22" HeightRequest="22" Margin="6,0"
                                           VerticalOptions="Center" IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBool}}">
                                        <Image.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleStickersCommand}" /></Image.GestureRecognizers>
                                    </Image>
                                </Grid>
                            </Border>
                            <Grid Grid.Column="2" VerticalOptions="Center" WidthRequest="54">
                                <Label Text="{l:Tr reels_post}" FontFamily="BarlowBold" FontSize="14.5" TextColor="#3D7BD9" HorizontalOptions="Center"
                                       IsVisible="{Binding IsSending, Converter={StaticResource InvertedBool}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Text, Converter={StaticResource HasValue}}" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding SendCommand}" /></Label.GestureRecognizers>
                                </Label>
                                <ActivityIndicator IsRunning="{Binding IsSending}" IsVisible="{Binding IsSending}" Color="{StaticResource Primary}"
                                                   WidthRequest="20" HeightRequest="20" />
                            </Grid>
                        </Grid>
                        <Button Text="{l:Tr reels_login_btn}" Command="{Binding LoginCommand}"
                                IsVisible="{Binding IsLoggedIn, Converter={StaticResource InvertedBool}}" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
