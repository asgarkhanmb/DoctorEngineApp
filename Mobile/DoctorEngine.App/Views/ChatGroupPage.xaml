<?xml version="1.0" encoding="utf-8" ?>
<!-- Usta: yeni qrup / qrupu redaktə et -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:DoctorEngine.App.Localization"
             xmlns:vm="clr-namespace:DoctorEngine.App.ViewModels"
             xmlns:v="clr-namespace:DoctorEngine.App.Views"
             x:Class="DoctorEngine.App.Views.ChatGroupPage"
             x:DataType="vm:ChatGroupViewModel"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#111B21}">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Başlıq -->
        <Grid BackgroundColor="#D81324" Padding="6,10,12,10" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Border WidthRequest="40" HeightRequest="40" StrokeShape="Ellipse" StrokeThickness="0" BackgroundColor="Transparent" Padding="9">
                <Image Source="ic_back_w.png" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBack" />
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1" Text="{Binding PageTitle}" TextColor="White" FontFamily="BarlowSemiBold" FontSize="19" VerticalOptions="Center" />
        </Grid>

        <!-- Forma + üzvlər -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Users}" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Padding="16,14" Spacing="12">
                    <Grid HorizontalOptions="Center" WidthRequest="84" HeightRequest="84">
                        <Border StrokeShape="Ellipse" StrokeThickness="0" BackgroundColor="#FDE2E4" Padding="22">
                            <Image Source="ic_users_r.png" />
                        </Border>
                    </Grid>
                    <Label Text="{l:Tr group_name}" FontSize="13" TextColor="{AppThemeBinding Light=#667781, Dark=#8696A0}" />
                    <Border StrokeShape="RoundRectangle 10" Stroke="{AppThemeBinding Light=#D1D7DB, Dark=#2A3942}" Padding="12,0">
                        <Entry Text="{Binding Name}" MaxLength="100" FontSize="16" />
                    </Border>
                    <Label Text="{l:Tr group_description}" FontSize="13" TextColor="{AppThemeBinding Light=#667781, Dark=#8696A0}" />
                    <Border StrokeShape="RoundRectangle 10" Stroke="{AppThemeBinding Light=#D1D7DB, Dark=#2A3942}" Padding="12,0">
                        <Editor Text="{Binding Description}" MaxLength="300" AutoSize="TextChanges" MinimumHeightRequest="60" FontSize="15" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout>
                            <Label Text="{l:Tr group_all_users}" FontSize="15.5" FontFamily="BarlowSemiBold" />
                            <Label Text="{l:Tr group_all_users_hint}" FontSize="12.5" TextColor="{AppThemeBinding Light=#667781, Dark=#8696A0}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding AllUsers}" OnColor="#F4A5AE" ThumbColor="#D81324" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout>
                            <Label Text="{l:Tr group_admins_only}" FontSize="15.5" FontFamily="BarlowSemiBold" />
                            <Label Text="{l:Tr group_admins_only_hint}" FontSize="12.5" TextColor="{AppThemeBinding Light=#667781, Dark=#8696A0}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding AdminsOnly}" OnColor="#F4A5AE" ThumbColor="#D81324" VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding ShowMembers}" Spacing="8" Margin="0,6,0,0">
                        <Label Text="{l:Tr group_pick_members}" FontSize="14" FontFamily="BarlowSemiBold" />
                        <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F0F2F5, Dark=#202C33}" Padding="12,0">
                            <Entry Text="{Binding Search}" Placeholder="{l:Tr chats_search}" FontSize="15" />
                        </Border>
                    </VerticalStackLayout>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#D81324" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:GroupMemberItem">
                    <Grid Padding="16,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                          IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatGroupViewModel}}, Path=ShowMembers, x:DataType=vm:ChatGroupViewModel}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatGroupViewModel}}, Path=ToggleCommand, x:DataType=vm:ChatGroupViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="42" HeightRequest="42" StrokeShape="Ellipse" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#DFE5E7, Dark=#2A3942}">
                            <Grid>
                                <Label Text="{Binding Initial}" FontFamily="BarlowBold" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#54656F, Dark=#AEBAC1}" />
                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" IsVisible="{Binding HasAvatar}" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding FullName}" FontSize="15.5" />
                            <Label Text="{Binding Handle}" FontSize="12.5" TextColor="{AppThemeBinding Light=#667781, Dark=#8696A0}" />
                        </VerticalStackLayout>
                        <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsExisting, Converter={StaticResource InvertedBool}}" Color="#D81324" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Yadda saxla -->
        <Border Grid.Row="2" Margin="16,8,16,14" StrokeShape="RoundRectangle 26" StrokeThickness="0" BackgroundColor="#D81324" HeightRequest="52" v:Motion.Press="True">
            <Label Text="{l:Tr group_save}" TextColor="White" FontFamily="BarlowBold" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SaveCommand}" />
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentPage>
