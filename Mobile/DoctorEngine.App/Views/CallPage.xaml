<?xml version="1.0" encoding="utf-8" ?>
<!-- Video / səsli zəng: saytın /Call səhifəsi (WebRTC) WebView-da. Zəng bitəndə səhifə "doctorengine://call-ended" açır → bağlanır. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DoctorEngine.App.Views.CallPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#0B141A">
    <Grid>
        <WebView x:Name="Web" Navigating="OnNavigating" />
        <ActivityIndicator x:Name="Loading" IsRunning="True" Color="#D81324" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
