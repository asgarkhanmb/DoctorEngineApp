<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows-da ilk hədəf Windows olmalıdır: Visual Studio ▶ düyməsi standart olaraq ilk hədəfi işə salır
		     (əvvəl Android idi — emulyator olmadığı üçün tətbiq heç yerdə açılmırdı). -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0;</TargetFrameworks>
		<TargetFrameworks>$(TargetFrameworks)net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<!-- Yalnız Windows paketi: dotnet publish ... -p:WindowsOnly=true (digər platformaların restore-u lazım olmur) -->
		<TargetFrameworks Condition="'$(WindowsOnly)' == 'true'">net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>DoctorEngine.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- MVVMTK0045: [ObservableProperty] sahələri — WinRT AOT xəbərdarlığı (AOT istifadə olunmur) -->
		<NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<ApplicationTitle>DoctorEngine</ApplicationTitle>
		<!-- Windows-da məlumat qovluğunun adı (%LOCALAPPDATA%\DoctorEngine\...) buradan götürülür -->
		<Company>DoctorEngine</Company>
		<ApplicationId>az.doctorengine.app</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Windows: sadə .exe (MSIX paketi lazım olanda MSIX-ə keçirilir) -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- WindowsAppSDK 1.8 + Visual Studio (C++ iş yükü qurulmayıb): XAML hədəfi "VC\Tools\MSVC" qovluğunu
	     axtarır və tapmayanda build "GetLatestMSVCVersion" xətası ilə dayanır. C# layihəsinə MSVC lazım deyil —
	     qovluq yoxdursa, axtarışı keçmək üçün boş yol verilir (dotnet CLI-də bu hədəf onsuz da işləmir). -->
	<PropertyGroup Condition="'$(VsInstallRoot)' != '' and !Exists('$(VsInstallRoot)\VC\Tools\MSVC')">
		<VCToolsInstallDir>$(MSBuildProjectDirectory)\obj\no-msvc\</VCToolsInstallDir>
	</PropertyGroup>

	<!-- Android aapt2 qeyri-ASCII yolları qəbul etmir (APT2265) — layihə məs. "C:\Users\Əsgərxan\..." altındadırsa,
	     Android-in ara faylları (obj) və çıxışı (bin) ASCII qovluğa yazılır. Digər platformalara təsir etmir. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectDirectory)', '[^\x00-\x7F]'))">
		<_DeAsciiRoot>$(ProgramData)\DoctorEngineBuild\</_DeAsciiRoot>
		<IntermediateOutputPath>$(_DeAsciiRoot)obj\$(Configuration)\</IntermediateOutputPath>
		<OutputPath>$(_DeAsciiRoot)bin\$(Configuration)\</OutputPath>
	</PropertyGroup>

	<!-- TEST APK: telefonda eyni Wi-Fi-dakı kompüterin lokal API-sinə qoşulur.
	       dotnet publish DoctorEngine.App -f net10.0-android -c Release -p:TestServerUrl=http://172.20.0.82:5020
	     - adı və paketi əsas tətbiqlə eynidir (DoctorEngine) — onun üzərinə quraşdırılır
	     - HTTP icazəlidir (Platforms/Android/TestResources), Profil ekranında server ünvanı dəyişdirilə bilər -->
	<PropertyGroup Condition="'$(TestServerUrl)' != ''">
		<DefineConstants>$(DefineConstants);TESTBUILD</DefineConstants>
	</PropertyGroup>
	<ItemGroup Condition="'$(TestServerUrl)' != ''">
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>TestServerUrl</_Parameter1>
			<_Parameter2>$(TestServerUrl)</_Parameter2>
		</AssemblyAttribute>
		<!-- Zənglər üçün saytın HTTPS ünvanı (kamera HTTP-də işləmir): -p:TestSiteUrl=https://IP:7192 -->
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(TestSiteUrl)' != ''">
			<_Parameter1>TestSiteUrl</_Parameter1>
			<_Parameter2>$(TestSiteUrl)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup Condition="'$(TestServerUrl)' != '' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidResource Remove="Platforms\Android\Resources\xml\network_security_config.xml" />
		<AndroidResource Include="Platforms\Android\TestResources\xml\network_security_config.xml" Link="Platforms\Android\Resources\xml\network_security_config.xml" />
	</ItemGroup>
	<ItemGroup>
		<None Remove="Platforms\Android\TestResources\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- Tətbiq ikonu: saytın loqosu (Admin → Sayt ayarları → loqo şəkli), ağ fonda.
		     ForegroundScale: Android-in dairəvi / yuvarlaq maskası loqonun kənarlarını kəsməsin. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" ForegroundScale="0.62" Color="#FFFFFF" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#D81324" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
		<PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
	</ItemGroup>

	<ItemGroup>
	</ItemGroup>

</Project>

