<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:l="clr-namespace:DoctorEngine.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DoctorEngine.App.ViewModels"
             xmlns:v="clr-namespace:DoctorEngine.App.Views"
             x:Class="DoctorEngine.App.Views.ChatPage"
             x:DataType="vm:ChatViewModel"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All"
             Title="{l:Tr tab_chat}">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{AppThemeBinding Light=#EEF2F8, Dark={StaticResource BackgroundDark}}">

        <!-- ================= BAŞLIQ ================= -->
        <Border Style="{StaticResource PageHeader}" Padding="16,12,16,16" StrokeShape="RoundRectangle 0,0,24,24">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Grid WidthRequest="48" HeightRequest="48">
                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" Background="{StaticResource PrimaryGradient}" Padding="12">
                        <Image Source="ic_wrench_w.png" />
                    </Border>
                    <Ellipse x:Name="OnlineDot" Fill="{StaticResource Live}" Stroke="#0A1C47" StrokeThickness="2" WidthRequest="14" HeightRequest="14"
                             HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-2,-2" IsVisible="{Binding IsOnline}" />
                </Grid>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                    <Label Text="{l:Tr chat_header}" TextColor="White" FontFamily="BarlowBold" FontSize="19" />
                    <Label TextColor="{StaticResource OnHeaderMuted}" FontSize="13">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsGuest}" Value="True">
                                <Setter Property="Text" Value="{l:Tr chat_guest_status}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsLoggedIn}" Value="True">
                                <Setter Property="Text" Value="{Binding Status}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ================= QONAQ ================= -->
        <ScrollView Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsGuest}">
            <VerticalStackLayout Padding="24,30,24,24" Spacing="16" VerticalOptions="Center">
                <Grid HorizontalOptions="Center" WidthRequest="140" HeightRequest="140">
                    <Ellipse Fill="{AppThemeBinding Light=#FDE3E6, Dark=#33D81324}" />
                    <Ellipse Fill="{AppThemeBinding Light=#FBCFD5, Dark=#4DD81324}" Margin="22" />
                    <Border StrokeShape="RoundRectangle 26" StrokeThickness="0" Background="{StaticResource PrimaryGradient}"
                            WidthRequest="74" HeightRequest="74" Padding="20" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="ic_chat_w.png" />
                    </Border>
                </Grid>
                <Label Text="{l:Tr chat_guest_title}" Style="{StaticResource SectionTitle}" FontSize="24" HorizontalTextAlignment="Center" />
                <Label Text="{l:Tr chat_guest_text}"
                       Style="{StaticResource Muted}" FontSize="15" HorizontalTextAlignment="Center" />

                <VerticalStackLayout Spacing="10" Margin="0,6,0,6">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}" Padding="9">
                            <Image Source="ic_attach_r.png" />
                        </Border>
                        <Label Grid.Column="1" Text="{l:Tr chat_feat_media}" VerticalOptions="Center" FontFamily="BarlowSemiBold" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}" Padding="9">
                            <Image Source="ic_mic_r.png" />
                        </Border>
                        <Label Grid.Column="1" Text="{l:Tr chat_feat_voice}" VerticalOptions="Center" FontFamily="BarlowSemiBold" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}" Padding="9">
                            <Image Source="ic_shield_r.png" />
                        </Border>
                        <Label Grid.Column="1" Text="{l:Tr chat_feat_private}" VerticalOptions="Center" FontFamily="BarlowSemiBold" />
                    </Grid>
                </VerticalStackLayout>

                <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" Background="{StaticResource PrimaryGradient}" HeightRequest="54" v:Motion.Press="True">
                    <Label Text="{l:Tr chat_login_register}" TextColor="White" FontFamily="BarlowBold" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= MESAJLAR ================= -->
        <CollectionView x:Name="MessagesView" Grid.Row="1" ItemsSource="{Binding Messages}" IsVisible="{Binding IsLoggedIn}"
                        SelectionMode="None" ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.Header>
                <VerticalStackLayout Padding="0,10,0,4" Spacing="6">
                    <Border Style="{StaticResource Pill}" HorizontalOptions="Center" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                            IsVisible="{Binding CanLoadMore}" v:Motion.Press="True">
                        <Label Text="{l:Tr chat_load_older}" FontFamily="BarlowSemiBold" FontSize="13" TextColor="{StaticResource Primary}" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LoadMoreCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="26" />
                    <VerticalStackLayout Padding="32,40" Spacing="8" IsVisible="{Binding IsEmpty}">
                        <Border StrokeShape="RoundRectangle 22" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}"
                                WidthRequest="66" HeightRequest="66" Padding="18" HorizontalOptions="Center">
                            <Image Source="ic_chat_r.png" />
                        </Border>
                        <Label Text="{l:Tr chat_empty_title}" Style="{StaticResource SectionTitle}" FontSize="18" HorizontalTextAlignment="Center" />
                        <Label Text="{l:Tr chat_empty_text}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatItem">
                    <VerticalStackLayout v:Motion.Appear="True" Padding="12,3" Spacing="4">
                        <!-- Tarix ayırıcısı -->
                        <Border IsVisible="{Binding ShowDate}" HorizontalOptions="Center" Style="{StaticResource Pill}" Padding="12,4" Margin="0,10,0,4"
                                BackgroundColor="{AppThemeBinding Light=#DCE3EE, Dark=#202A44}">
                            <Label Text="{Binding DateLabel}" FontSize="12" FontFamily="BarlowSemiBold" TextColor="{AppThemeBinding Light=#5B6476, Dark=#AEB7C8}" />
                        </Border>

                        <!-- Göndərən adı -->
                        <HorizontalStackLayout IsVisible="{Binding ShowName}" Spacing="6" Margin="6,4,0,0">
                            <Label Text="{Binding UserName}" FontSize="12" Style="{StaticResource Muted}" FontFamily="BarlowBold" />
                            <Border IsVisible="{Binding IsAdmin}" Style="{StaticResource Pill}" BackgroundColor="{StaticResource Primary}" Padding="7,1">
                                <Label Text="{l:Tr chat_badge_mechanic}" TextColor="White" FontSize="10" FontFamily="BarlowBold" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Qabarcıq -->
                        <Border HorizontalOptions="{Binding IsMine, Converter={StaticResource MineAlign}}" MaximumWidthRequest="310"
                                StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="13,9,13,7"
                                BackgroundColor="{Binding ., Converter={StaticResource BubbleColor}}">
                            <Border.Shadow>
                                <Shadow Brush="#0B2154" Offset="0,2" Radius="6" Opacity="0.08" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OptionsCommand, x:DataType=vm:ChatViewModel}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <!-- Şəkil -->
                                <Border IsVisible="{Binding ImageUrl, Converter={StaticResource HasValue}}" StrokeShape="RoundRectangle 14" StrokeThickness="0" Padding="0" Margin="-7,-3,-7,2">
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" WidthRequest="260" HeightRequest="200" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenMediaCommand, x:DataType=vm:ChatViewModel}" CommandParameter="{Binding ImageUrl}" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <!-- Video -->
                                <Border IsVisible="{Binding VideoUrl, Converter={StaticResource HasValue}}" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                                        Background="{StaticResource HeaderGradient}" WidthRequest="240" HeightRequest="140" Margin="-7,-3,-7,2">
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                                        <Border Background="{StaticResource PrimaryGradient}" StrokeShape="Ellipse" StrokeThickness="0" WidthRequest="52" HeightRequest="52" Padding="15" HorizontalOptions="Center">
                                            <Image Source="ic_play_w.png" />
                                        </Border>
                                        <Label Text="{l:Tr common_watch_video}" TextColor="White" FontFamily="BarlowSemiBold" FontSize="13" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenMediaCommand, x:DataType=vm:ChatViewModel}" CommandParameter="{Binding VideoUrl}" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <!-- Səs -->
                                <Grid IsVisible="{Binding AudioUrl, Converter={StaticResource HasValue}}" ColumnDefinitions="Auto,*" ColumnSpacing="10" WidthRequest="220">
                                    <Border BackgroundColor="{StaticResource Navy}" StrokeShape="Ellipse" StrokeThickness="0" WidthRequest="42" HeightRequest="42" Padding="12">
                                        <Grid>
                                            <Image Source="ic_play_w.png" IsVisible="{Binding IsPlaying, Converter={StaticResource InvertedBool}}" />
                                            <Label Text="❚❚" TextColor="White" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsPlaying}" />
                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=PlayAudioCommand, x:DataType=vm:ChatViewModel}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                    <!-- Səs dalğası (dekorativ) -->
                                    <HorizontalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center" Opacity="0.75">
                                        <BoxView WidthRequest="3" HeightRequest="10" CornerRadius="2" Color="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                        <BoxView WidthRequest="3" HeightRequest="18" CornerRadius="2" Color="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                        <BoxView WidthRequest="3" HeightRequest="26" CornerRadius="2" Color="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                        <BoxView WidthRequest="3" HeightRequest="14" CornerRadius="2" Color="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                        <BoxView WidthRequest="3" HeightRequest="22" CornerRadius="2" Color="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                        <BoxView WidthRequest="3" HeightRequest="8" CornerRadius="2" Color="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                        <BoxView WidthRequest="3" HeightRequest="16" CornerRadius="2" Color="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                        <BoxView WidthRequest="3" HeightRequest="24" CornerRadius="2" Color="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                        <BoxView WidthRequest="3" HeightRequest="12" CornerRadius="2" Color="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                        <BoxView WidthRequest="3" HeightRequest="20" CornerRadius="2" Color="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                        <BoxView WidthRequest="3" HeightRequest="10" CornerRadius="2" Color="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                        <BoxView WidthRequest="3" HeightRequest="16" CornerRadius="2" Color="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                    </HorizontalStackLayout>
                                </Grid>
                                <!-- Mətn -->
                                <Label Text="{Binding Text}" IsVisible="{Binding Text, Converter={StaticResource HasValue}}" FontSize="15"
                                       TextColor="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                <!-- Vaxt -->
                                <HorizontalStackLayout HorizontalOptions="End" Spacing="6">
                                    <Label Text="{l:Tr chat_edited}" FontSize="10" Opacity="0.7" IsVisible="{Binding IsEdited}" TextColor="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                    <Label Text="{Binding Time}" FontSize="11" Opacity="0.75" TextColor="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="10" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- ================= YAZMA SAHƏSİ ================= -->
        <Border Grid.Row="2" IsVisible="{Binding IsLoggedIn}" StrokeThickness="0" StrokeShape="RoundRectangle 22,22,0,0" Padding="10,10,10,12"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}">
            <Border.Shadow>
                <Shadow Brush="#0B2154" Offset="0,-4" Radius="16" Opacity="0.08" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="6">
                <!-- Redaktə rejimi -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Editing, Converter={StaticResource HasValue}}" Padding="8,0">
                    <Label Text="{l:Tr chat_editing}" FontSize="13" TextColor="{StaticResource Primary}" FontFamily="BarlowBold" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{l:Tr common_cancel}" FontSize="13" FontFamily="BarlowBold" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelEditCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Səs yazılır -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding IsRecording}" HeightRequest="50" Padding="4,0">
                    <Border WidthRequest="46" HeightRequest="46" StrokeShape="Ellipse" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F1F4FA, Dark=#202A44}" v:Motion.Press="True">
                        <Label Text="✕" FontSize="18" FontFamily="BarlowBold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelRecordCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Ellipse x:Name="RecDot" Grid.Column="1" Fill="{StaticResource Primary}" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="0">
                        <Label Text="{l:Tr chat_recording}" Style="{StaticResource Muted}" FontSize="12" />
                        <Label Text="{Binding RecordTime}" FontSize="18" FontFamily="BarlowBold" />
                    </VerticalStackLayout>
                    <Border Grid.Column="3" WidthRequest="50" HeightRequest="50" StrokeShape="Ellipse" StrokeThickness="0" Background="{StaticResource PrimaryGradient}" Padding="14" v:Motion.Press="True">
                        <Image Source="ic_send_w.png" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleRecordCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Adi yazma -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding IsRecording, Converter={StaticResource InvertedBool}}">
                    <Border WidthRequest="46" HeightRequest="46" StrokeShape="Ellipse" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F1F4FA, Dark=#202A44}"
                            Padding="12" VerticalOptions="End" v:Motion.Press="True">
                        <Image Source="ic_attach_g.png" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AttachCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 23" StrokeThickness="0" Padding="16,2"
                            BackgroundColor="{AppThemeBinding Light=#F1F4FA, Dark=#202A44}">
                        <Editor Text="{Binding Text}" Placeholder="{l:Tr chat_placeholder}" AutoSize="TextChanges" MaxLength="1000" MinimumHeightRequest="44" MaximumHeightRequest="120" />
                    </Border>
                    <Grid Grid.Column="2" VerticalOptions="End">
                        <Border WidthRequest="46" HeightRequest="46" StrokeShape="Ellipse" StrokeThickness="0" Background="{StaticResource PrimaryGradient}" Padding="13"
                                IsVisible="{Binding CanSend}" v:Motion.Press="True">
                            <Image Source="ic_send_w.png" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SendCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border WidthRequest="46" HeightRequest="46" StrokeShape="Ellipse" StrokeThickness="0" Background="{StaticResource NavyTile}" Padding="12"
                                IsVisible="{Binding CanSend, Converter={StaticResource InvertedBool}}" v:Motion.Press="True">
                            <Image Source="ic_mic_w.png" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleRecordCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </Grid>
                <ActivityIndicator IsRunning="{Binding IsSending}" IsVisible="{Binding IsSending}" HeightRequest="18" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
