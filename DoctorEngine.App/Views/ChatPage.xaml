<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DoctorEngine.App.ViewModels"
             x:Class="DoctorEngine.App.Views.ChatPage"
             x:DataType="vm:ChatViewModel"
             Title="Canlı usta dəstəyi">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Status zolağı -->
        <Grid Background="{StaticResource HeroGradient}" Padding="16,10" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding IsLoggedIn}">
            <Ellipse WidthRequest="9" HeightRequest="9" VerticalOptions="Center" Fill="#2ECC71" IsVisible="{Binding IsOnline}" />
            <Ellipse WidthRequest="9" HeightRequest="9" VerticalOptions="Center" Fill="#F5B301" IsVisible="{Binding IsOnline, Converter={StaticResource InvertedBool}}" />
            <Label Grid.Column="1" Text="{Binding Status}" TextColor="#DDFFFFFF" FontSize="13" VerticalOptions="Center" />
        </Grid>

        <!-- ===== Qonaq ===== -->
        <VerticalStackLayout Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsGuest}" Padding="24" Spacing="14" VerticalOptions="Center">
            <Border BackgroundColor="{StaticResource PrimarySoft}" StrokeShape="Ellipse" StrokeThickness="0" WidthRequest="84" HeightRequest="84" HorizontalOptions="Center">
                <Label Text="💬" FontSize="38" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="Usta ilə birbaşa yazışın" Style="{StaticResource H2}" HorizontalTextAlignment="Center" />
            <Label Text="Probleminizi yazın, şəkil, video və ya səs mesajı göndərin — ustalarımız tezliklə cavab verəcək. Yazışmaları görmək üçün hesabınıza daxil olun."
                   Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            <Button Text="Daxil ol / Qeydiyyat" Command="{Binding GoToLoginCommand}" />
        </VerticalStackLayout>

        <!-- ===== Mesajlar ===== -->
        <CollectionView x:Name="MessagesView" Grid.Row="1" ItemsSource="{Binding Messages}" IsVisible="{Binding IsLoggedIn}"
                        SelectionMode="None" ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.Header>
                <VerticalStackLayout Padding="0,8">
                    <Button Text="Köhnə mesajları göstər" Style="{StaticResource LightButton}" HorizontalOptions="Center" FontSize="13"
                            MinimumHeightRequest="36" HeightRequest="36" Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="28" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32" Spacing="6" VerticalOptions="Center" IsVisible="{Binding IsEmpty}">
                    <Label Text="💬" FontSize="40" HorizontalOptions="Center" Opacity="0.5" />
                    <Label Text="Hələ mesaj yoxdur." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    <Label Text="Sualınızı yazın — ustalarımız cavab verəcək." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatItem">
                    <VerticalStackLayout Padding="12,3" Spacing="4">
                        <!-- Tarix ayırıcısı -->
                        <Border IsVisible="{Binding ShowDate}" HorizontalOptions="Center" StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                BackgroundColor="#E3E7EF" Padding="10,3" Margin="0,8,0,4">
                            <Label Text="{Binding DateLabel}" FontSize="11" TextColor="#5B6476" />
                        </Border>

                        <!-- Göndərən adı -->
                        <HorizontalStackLayout IsVisible="{Binding ShowName}" Spacing="6" Margin="6,4,0,0">
                            <Label Text="{Binding UserName}" FontSize="12" Style="{StaticResource Muted}" FontFamily="BarlowBold" />
                            <Border IsVisible="{Binding IsAdmin}" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="6,0">
                                <Label Text="USTA" TextColor="White" FontSize="10" FontFamily="BarlowBold" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Qabarcıq -->
                        <Border HorizontalOptions="{Binding IsMine, Converter={StaticResource MineAlign}}" MaximumWidthRequest="310"
                                StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12,8,12,6"
                                BackgroundColor="{Binding ., Converter={StaticResource BubbleColor}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer NumberOfTapsRequired="1"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OptionsCommand, x:DataType=vm:ChatViewModel}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <!-- Şəkil -->
                                <Border IsVisible="{Binding ImageUrl, Converter={StaticResource HasValue}}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="0" Margin="-6,-2,-6,2">
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" WidthRequest="260" HeightRequest="200" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenMediaCommand, x:DataType=vm:ChatViewModel}" CommandParameter="{Binding ImageUrl}" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <!-- Video -->
                                <Border IsVisible="{Binding VideoUrl, Converter={StaticResource HasValue}}" StrokeShape="RoundRectangle 12" StrokeThickness="0"
                                        BackgroundColor="#0B0F19" WidthRequest="240" HeightRequest="140" Margin="-6,-2,-6,2">
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="6">
                                        <Border BackgroundColor="{StaticResource Primary}" StrokeShape="Ellipse" StrokeThickness="0" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center">
                                            <Label Text="▶" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Text="Videoya bax" TextColor="White" FontSize="12" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=OpenMediaCommand, x:DataType=vm:ChatViewModel}" CommandParameter="{Binding VideoUrl}" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <!-- Səs -->
                                <Grid IsVisible="{Binding AudioUrl, Converter={StaticResource HasValue}}" ColumnDefinitions="Auto,*" ColumnSpacing="10" WidthRequest="210">
                                    <Border BackgroundColor="{StaticResource Navy}" StrokeShape="Ellipse" StrokeThickness="0" WidthRequest="40" HeightRequest="40">
                                        <Grid>
                                            <Label Text="▶" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsPlaying, Converter={StaticResource InvertedBool}}" />
                                            <Label Text="❚❚" TextColor="White" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsPlaying}" />
                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=PlayAudioCommand, x:DataType=vm:ChatViewModel}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                    <Label Grid.Column="1" Text="🎤 Səs mesajı" VerticalOptions="Center" FontSize="13" TextColor="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                </Grid>
                                <!-- Mətn -->
                                <Label Text="{Binding Text}" IsVisible="{Binding Text, Converter={StaticResource HasValue}}" FontSize="15"
                                       TextColor="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                <!-- Vaxt -->
                                <HorizontalStackLayout HorizontalOptions="End" Spacing="6">
                                    <Label Text="redaktə olunub" FontSize="10" Opacity="0.7" IsVisible="{Binding IsEdited}" TextColor="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                    <Label Text="{Binding Time}" FontSize="11" Opacity="0.75" TextColor="{Binding IsMine, Converter={StaticResource BubbleText}}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="8" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- ===== Yazma sahəsi ===== -->
        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsLoggedIn}" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource SurfaceDark}}" Padding="10,8" Spacing="6">
            <!-- Redaktə rejimi -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Editing, Converter={StaticResource HasValue}}" Padding="6,0">
                <Label Text="✏️ Mesaj redaktə olunur" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource TextDark}}" FontFamily="BarlowBold" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Ləğv et" Style="{StaticResource LinkButton}" Command="{Binding CancelEditCommand}" FontSize="12" />
            </Grid>

            <!-- Səs yazılır -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" IsVisible="{Binding IsRecording}" HeightRequest="48">
                <Button Text="🗑" Style="{StaticResource LightButton}" WidthRequest="46" HeightRequest="46" Padding="0" Command="{Binding CancelRecordCommand}" />
                <Ellipse Grid.Column="1" Fill="{StaticResource Primary}" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="{Binding RecordTime}" FontSize="16" FontFamily="BarlowBold" VerticalOptions="Center" />
                <Button Grid.Column="3" Text="➤" WidthRequest="48" HeightRequest="48" CornerRadius="24" Padding="0" FontSize="18" Command="{Binding ToggleRecordCommand}" />
            </Grid>

            <!-- Adi yazma -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding IsRecording, Converter={StaticResource InvertedBool}}">
                <Button Text="📎" Style="{StaticResource LightButton}" WidthRequest="46" HeightRequest="46" Padding="0" CornerRadius="23" Command="{Binding AttachCommand}" />
                <Border Grid.Column="1" Style="{StaticResource Field}" StrokeShape="RoundRectangle 22" Padding="14,0">
                    <Editor Text="{Binding Text}" Placeholder="Mesaj yazın…" AutoSize="TextChanges" MaxLength="1000" MinimumHeightRequest="44" MaximumHeightRequest="120" />
                </Border>
                <Grid Grid.Column="2">
                    <Button Text="➤" WidthRequest="48" HeightRequest="48" CornerRadius="24" Padding="0" FontSize="18" Command="{Binding SendCommand}" IsVisible="{Binding CanSend}" />
                    <Button Text="🎤" WidthRequest="48" HeightRequest="48" CornerRadius="24" Padding="0" FontSize="18" Command="{Binding ToggleRecordCommand}"
                            IsVisible="{Binding CanSend, Converter={StaticResource InvertedBool}}" />
                </Grid>
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsSending}" IsVisible="{Binding IsSending}" HeightRequest="18" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
