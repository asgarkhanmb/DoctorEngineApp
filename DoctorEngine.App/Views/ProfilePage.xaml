<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DoctorEngine.App.ViewModels"
             x:Class="DoctorEngine.App.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profil">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- ===== DAXİL OLUB ===== -->
            <VerticalStackLayout IsVisible="{Binding IsLoggedIn}" Spacing="16">
                <Border Style="{StaticResource Card}" Padding="20">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border WidthRequest="88" HeightRequest="88" StrokeShape="Ellipse" StrokeThickness="0" BackgroundColor="{StaticResource Navy}" HorizontalOptions="Center">
                            <Grid>
                                <Label Text="{Binding Initial}" TextColor="White" FontSize="34" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource HasValue}}" />
                            </Grid>
                        </Border>
                        <Label Text="{Binding User.FullName}" Style="{StaticResource H2}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding User.Email}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                        <Label Style="{StaticResource Muted}" HorizontalTextAlignment="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="@" />
                                    <Span Text="{Binding User.UserName}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border IsVisible="{Binding User.IsAdmin}" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,3" HorizontalOptions="Center">
                            <Label Text="ADMİNİSTRATOR · USTA" TextColor="White" FontSize="11" FontAttributes="Bold" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="8">
                    <VerticalStackLayout>
                        <Button Text="💬  Canlı çat" Style="{StaticResource LightButton}" BorderWidth="0" Clicked="OnChatClicked" />
                        <Button Text="📅  Rezervasiyalarım" Style="{StaticResource LightButton}" BorderWidth="0" Clicked="OnBookingClicked" />
                        <Button Text="✨  AI köməkçi" Style="{StaticResource LightButton}" BorderWidth="0" Clicked="OnAiClicked" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Hesabdan çıx" Style="{StaticResource LightButton}" TextColor="{StaticResource Primary}" Command="{Binding LogoutCommand}" />
            </VerticalStackLayout>

            <!-- ===== QONAQ ===== -->
            <VerticalStackLayout IsVisible="{Binding IsGuest}" Spacing="16">
                <VerticalStackLayout Spacing="2">
                    <Label Text="HESAB" Style="{StaticResource Eyebrow}" />
                    <Label Text="Xoş gəlmisiniz" Style="{StaticResource H1}" />
                    <Label Text="Usta ilə yazışmaq üçün daxil olun və ya qeydiyyatdan keçin. Saytdakı hesabınız burada da işləyir." Style="{StaticResource Muted}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource SuccessBox}" IsVisible="{Binding HasInfo}">
                    <Label Text="{Binding InfoMessage}" TextColor="#14532D" FontSize="13" />
                </Border>
                <Border Style="{StaticResource ErrorBox}" IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" TextColor="#7F1D1D" FontSize="13" />
                </Border>

                <!-- Giriş -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsLoginMode}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Daxil ol" Style="{StaticResource H2}" />
                        <VerticalStackLayout>
                            <Label Text="Email və ya istifadəçi adı" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding LoginName}" Keyboard="Email" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="Şifrə" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding Password}" IsPassword="True" ReturnCommand="{Binding LoginCommand}" /></Border>
                        </VerticalStackLayout>
                        <Button Text="Daxil ol" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="22" />
                        <Grid ColumnDefinitions="*,*">
                            <Button Text="Şifrəni unutmusunuz?" Style="{StaticResource LinkButton}" FontSize="13" HorizontalOptions="Start" Command="{Binding ShowForgotCommand}" />
                            <Button Grid.Column="1" Text="Qeydiyyat →" Style="{StaticResource LinkButton}" FontSize="13" HorizontalOptions="End" Command="{Binding ShowRegisterCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Qeydiyyat -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsRegisterMode}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Qeydiyyat" Style="{StaticResource H2}" />
                        <VerticalStackLayout>
                            <Label Text="Ad Soyad" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding FullName}" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="İstifadəçi adı" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding UserName}" Placeholder="latın hərfləri, rəqəm, . _ -" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="Email" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding Email}" Keyboard="Email" IsSpellCheckEnabled="False" /></Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="Şifrə" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding Password}" IsPassword="True" /></Border>
                            <Label Text="Ən azı 6 simvol: böyük və kiçik hərf, rəqəm və xüsusi simvol (!@#…)" Style="{StaticResource Muted}" FontSize="12" Margin="2,4,0,0" />
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="Şifrə təkrarı" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource Field}"><Entry Text="{Binding Password2}" IsPassword="True" /></Border>
                        </VerticalStackLayout>
                        <Button Text="Qeydiyyatdan keç" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsNotBusy}" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="22" />
                        <Button Text="← Artıq hesabım var" Style="{StaticResource LinkButton}" FontSize="13" Command="{Binding ShowLoginCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Şifrə bərpası -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsForgotMode}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Şifrənin bərpası" Style="{StaticResource H2}" />
                        <Label Text="Emailinizi yazın — şifrə yeniləmə linki göndəriləcək." Style="{StaticResource Muted}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding Email}" Keyboard="Email" Placeholder="ad@numune.az" /></Border>
                        <Button Text="Link göndər" Command="{Binding ForgotCommand}" IsEnabled="{Binding IsNotBusy}" />
                        <Button Text="← Geri" Style="{StaticResource LinkButton}" FontSize="13" Command="{Binding ShowLoginCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ===== Proqramçı ayarları (yalnız Debug) ===== -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding ShowDevSettings}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Server ünvanı (test)" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}"><Entry Text="{Binding ServerUrl}" Keyboard="Url" IsSpellCheckEnabled="False" /></Border>
                    <Button Text="Yadda saxla" Style="{StaticResource NavyButton}" Command="{Binding SaveServerCommand}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding AppVersion}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
