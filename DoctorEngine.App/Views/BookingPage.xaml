<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DoctorEngine.App.ViewModels"
             xmlns:c="clr-namespace:DoctorEngine.Contracts;assembly=DoctorEngine.Contracts"
             x:Class="DoctorEngine.App.Views.BookingPage"
             x:DataType="vm:BookingViewModel"
             Title="Rezervasiya">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <VerticalStackLayout Spacing="2">
                <Label Text="ONLAYN REZERVASİYA" Style="{StaticResource Eyebrow}" />
                <Label Text="Növbəni indi götürün" Style="{StaticResource H1}" />
                <Label Text="Xidməti, günü və boş saatı seçin — rezervasiyanızın statusunu buradan canlı izləyin." Style="{StaticResource Muted}" />
            </VerticalStackLayout>

            <!-- Uğurlu -->
            <Border Style="{StaticResource SuccessBox}" IsVisible="{Binding SuccessMessage, Converter={StaticResource HasValue}}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="✔ Rezervasiya göndərildi" FontFamily="BarlowBold" TextColor="#14532D" />
                    <Label Text="{Binding SuccessMessage}" TextColor="#14532D" FontSize="13" />
                    <Label TextColor="#14532D" FontSize="13" IsVisible="{Binding SuccessCode, Converter={StaticResource HasValue}}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="İzləmə kodu: " />
                                <Span Text="{Binding SuccessCode}" FontFamily="BarlowBold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource ErrorBox}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" TextColor="#7F1D1D" FontSize="13" />
            </Border>

            <!-- 1. Xidmət -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="1  Xidmət seçin" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Picker ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" ItemDisplayBinding="{Binding Name, x:DataType=c:BookableServiceDto}"
                                Title="Xidmət seçin" TextColor="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource TextDark}}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- 2. Gün -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="2  Gün seçin" Style="{StaticResource FieldLabel}" />
                    <CollectionView ItemsSource="{Binding Days}" ItemsLayout="HorizontalList" HeightRequest="72" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DayItem">
                                <Border WidthRequest="58" Margin="0,0,8,0" Padding="4,8" StrokeShape="RoundRectangle 14"
                                        Stroke="{StaticResource Border}"
                                        BackgroundColor="{Binding IsSelected, Converter={StaticResource SelectedBg}}">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="{Binding Label}" FontSize="11" HorizontalTextAlignment="Center" TextColor="{Binding IsSelected, Converter={StaticResource SelectedText}}" />
                                        <Label Text="{Binding Number}" FontSize="20" FontFamily="BarlowBold" HorizontalTextAlignment="Center" TextColor="{Binding IsSelected, Converter={StaticResource SelectedText}}" />
                                    </VerticalStackLayout>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BookingViewModel}}, Path=SelectDayCommand, x:DataType=vm:BookingViewModel}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- 3. Saat -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="3  Saat seçin" Style="{StaticResource FieldLabel}" />
                        <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsLoadingSlots}" IsVisible="{Binding IsLoadingSlots}" HeightRequest="20" WidthRequest="20" />
                    </Grid>
                    <Label Text="Bu gün üçün boş saat qalmayıb — başqa gün seçin." Style="{StaticResource Muted}" IsVisible="{Binding NoSlots}" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding Slots}" Wrap="Wrap" JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SlotItem">
                                <!-- Aralıq xarici Grid-in Padding-i ilə verilir: FlexLayout uşaq Margin-ini hündürlükdən çıxıb düyməni kəsir -->
                                <Grid Padding="0,0,8,8">
                                    <Border Padding="0" WidthRequest="74" HeightRequest="40" StrokeShape="RoundRectangle 10" Stroke="{StaticResource Border}"
                                            BackgroundColor="{Binding Background}">
                                        <Label Text="{Binding Time}" FontFamily="BarlowBold" HorizontalOptions="Center" VerticalOptions="Center"
                                               TextColor="{Binding Foreground}" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BookingViewModel}}, Path=SelectSlotCommand, x:DataType=vm:BookingViewModel}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <HorizontalStackLayout Spacing="14">
                        <Label Text="■ Boş" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource TextDark}}" />
                        <Label Text="■ Tutulub" FontSize="12" TextColor="{StaticResource Primary}" />
                        <Label Text="■ Keçib" FontSize="12" TextColor="#A3AAB8" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 4. Əlaqə -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="4  Əlaqə məlumatları" Style="{StaticResource FieldLabel}" />
                    <VerticalStackLayout>
                        <Label Text="Ad Soyad" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding FullName}" Placeholder="Adınız və soyadınız" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout>
                        <Label Text="Telefon" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding Phone}" Placeholder="+994 XX XXX XX XX" Keyboard="Telephone" /></Border>
                    </VerticalStackLayout>
                    <HorizontalStackLayout Spacing="6">
                        <!-- WidthRequest: Windows-da CheckBox-un standart minimum eni 120px-dir, yazı uzaqda qalır -->
                        <CheckBox IsChecked="{Binding SameAsPhone}" Color="{StaticResource Primary}" WidthRequest="36" MinimumWidthRequest="0" />
                        <Label Text="WhatsApp nömrəsi telefonla eyni olsun" VerticalOptions="Center" FontSize="13" />
                    </HorizontalStackLayout>
                    <VerticalStackLayout IsVisible="{Binding SameAsPhone, Converter={StaticResource InvertedBool}}">
                        <Label Text="WhatsApp" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}"><Entry Text="{Binding WhatsApp}" Placeholder="+994 XX XXX XX XX" Keyboard="Telephone" /></Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout>
                        <Label Text="Qeyd (istəyə görə)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}" Padding="8,4">
                            <Editor Text="{Binding Note}" Placeholder="Məs: avtomobil modeli, il, mühərrik həcmi" AutoSize="TextChanges" MaxLength="1000" MinimumHeightRequest="70" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Göndər -->
            <Border Style="{StaticResource Card}" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Summary}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    <Button Text="Rezervasiya et →" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
                </VerticalStackLayout>
            </Border>

            <!-- Mənim rezervasiyalarım -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding HasMyReservations}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Mənim rezervasiyalarım" Style="{StaticResource H2}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Yenilə" Style="{StaticResource LinkButton}" Command="{Binding LoadMineCommand}" />
                </Grid>
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding MyReservations}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="c:ReservationStatusDto">
                            <Border Style="{StaticResource Card}" Padding="14">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                    <Label Text="{Binding Service}" FontFamily="BarlowBold" TextColor="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource TextDark}}" />
                                    <Label Grid.Row="1" Style="{StaticResource Muted}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Date}" />
                                                <Span Text="  ·  " />
                                                <Span Text="{Binding Time}" />
                                                <Span Text="  ·  #" />
                                                <Span Text="{Binding Code}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Grid.Row="2" Text="{Binding Reason}" Style="{StaticResource Muted}" TextColor="#B00F1D" IsVisible="{Binding Reason, Converter={StaticResource HasValue}}" />
                                    <Border Grid.Column="1" Grid.RowSpan="2" VerticalOptions="Center" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,4"
                                            BackgroundColor="{Binding Status, Converter={StaticResource StatusColor}, ConverterParameter=bg}">
                                        <Label Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="12" FontFamily="BarlowBold"
                                               TextColor="{Binding Status, Converter={StaticResource StatusColor}}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
