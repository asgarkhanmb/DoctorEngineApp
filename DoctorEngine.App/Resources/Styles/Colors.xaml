<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Saytın rəngləri (wwwroot/css/theme.css) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#D81324</Color>
    <Color x:Key="PrimaryDark">#B00F1D</Color>
    <Color x:Key="PrimarySoft">#FDECEE</Color>
    <Color x:Key="Navy">#0B2154</Color>
    <Color x:Key="Navy2">#16306F</Color>
    <Color x:Key="Background">#F4F6FA</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Border">#E3E7EF</Color>
    <Color x:Key="Text">#1D2433</Color>
    <Color x:Key="Muted">#7A8394</Color>
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="SuccessSoft">#E9F8EF</Color>
    <Color x:Key="Warning">#D97706</Color>
    <Color x:Key="WarningSoft">#FFF6E5</Color>

    <!-- Tünd rejim -->
    <Color x:Key="BackgroundDark">#0E1424</Color>
    <Color x:Key="SurfaceDark">#182036</Color>
    <Color x:Key="BorderDark">#273049</Color>
    <Color x:Key="TextDark">#EEF1F7</Color>
    <Color x:Key="MutedDark">#9AA3B5</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource Navy}" />

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B2154" Offset="0" />
        <GradientStop Color="#16306F" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D81324" Offset="0" />
        <GradientStop Color="#B00F1D" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
