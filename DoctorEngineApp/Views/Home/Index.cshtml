@model HomeVM
@{
    ViewData["Title"] = "Ana Səhifə";
    var about = Model.Abouts?.FirstOrDefault();
}

@section css {
    <link rel="stylesheet" href="~/css/services.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/services.js" asp-append-version="true"></script>
}

<main>

    <!-- Slider -->
    @await Component.InvokeAsync("Slider")

    <!-- Axan xidmətlər lenti -->
    <partial name="_ServiceMarquee" model="Model.Categories" />

    <!-- Xüsusiyyətlər -->
    <partial name="_InformCards" model="Model.Informs" />

    <!-- Haqqımızda (Haqqımızda səhifəsi ilə eyni dizayn) -->
    @if (about != null)
    {
        <div class="sv ab ab-home">
            <partial name="_AboutHero" model='new AboutSectionVM(about.Title, about.Description, about.VideoPath, Model.Informs, IsHome: true)' />
        </div>
    }

    <!-- Xidmətlər (kartlar — Xidmətlər səhifəsi ilə eyni dizayn) -->
    <section class="sv sv-home">
        <div class="container">
            <div class="sv-home__head wow fadeInUp" data-wow-delay="0.1s">
                <div>
                    <span class="sv-eyebrow">@L.T("Xidmətlərimiz")</span>
                    <h2>@L.T("Xidmətlərimizi araşdırın")</h2>
                    <p>@L.T("Videolara baxın, işin necə görüldüyünü görün və uyğun xidməti bir kliklə rezervasiya edin.")</p>
                </div>
                <a asp-controller="Service" asp-action="Index" class="sv-btn sv-btn--ghost">
                    @L.T("Bütün xidmətlər") <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            @* Ana səhifədə yalnız ən son yaradılan 3 xidmət (yenisi birinci). Hamısı — Xidmətlər səhifəsində. *@
            <partial name="_ServiceGrid" model='new ServiceGridVM
            {
                Categories = (Model.Categories ?? new()).OrderByDescending(c => c.Id).Take(3).ToList(),
                ReservationServiceIds = ServiceGridVM.MapReservationIds(Model.Categories, Model.Services),
                Limit = 3
            }' />
        </div>
    </section>

    <!-- Rezervasiya -->
    <partial name="_BookingForm" for="Reservation" />

    <!-- Mütəxəssislər (Haqqımızda səhifəsi ilə eyni dizayn) -->
    <div class="sv ab ab-home-team">
        <partial name="_TeamSection" model="Model.Technicians" />
    </div>
</main>
