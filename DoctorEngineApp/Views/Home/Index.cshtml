@model HomeVM
@{
    ViewData["Title"] = "Ana Səhifə";
    var about = Model.Abouts?.FirstOrDefault();
}

<main>

    <!-- Slider -->
    @await Component.InvokeAsync("Slider")

    <!-- Informlar -->
    <div class="container-xxl py-5">
        <div class="container">
            <div class="row g-4">
                @for (int i = 0; i < Model.Informs.Count; i++)
                {
                    var item = Model.Informs[i];
                    var delay = (i * 0.2) + 0.1;

                    <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="@($"{delay:0.0}s")">
                        <div class="d-flex @(i == 1 ? "bg-light" : "") py-5 px-4 align-items-center">
                            @if (!string.IsNullOrEmpty(item.Icon))
                            {
                                <img src="@item.Icon" alt="@item.Title" class="flex-shrink-0" style="width:50px; height:50px; object-fit:contain;" />
                            }
                            <div class="ps-4">
                                <h5 class="mb-3">@item.Title</h5>
                                <p>@item.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- About Video -->
    <div class="container-xxl py-5">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-6 pt-4 d-flex justify-content-center position-relative">
                    <video id="aboutVideo" class="w-100" style="max-height:500px; object-fit:cover; border-radius:20px;" controls>
                        @if (about != null && !string.IsNullOrEmpty(about.VideoPath))
                        {
                            <source src="@Url.Content(about.VideoPath)" type="video/mp4" />
                        }
                    </video>
                </div>
                <div class="col-lg-6">
                    <h6 class="text-primary text-uppercase">HAQQIMIZDA</h6>
                    <h1 class="mb-4">@about?.Title</h1>
                    <p class="mb-4">@about?.Description</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Categories + SubServices -->
    <div class="container-xxl service py-5">
        <div class="container">
            <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
                <h6 class="text-primary text-uppercase">Xidmətlərimiz</h6>
                <h1 class="mb-5">Xidmətlərimizi Araşdırın</h1>
            </div>

            <div class="row g-4 wow fadeInUp" data-wow-delay="0.3s">
                <div class="col-lg-4">
                    <div class="nav w-100 nav-pills me-4" role="tablist">
                        @for (int i = 0; i < Model.Categories.Count; i++)
                        {
                            var cat = Model.Categories[i];
                            <button class="nav-link w-100 d-flex align-items-center text-start p-4 mb-3 @(i == 0 ? "active" : "")"
                                    data-bs-toggle="pill" data-bs-target="#cat-@cat.Id" type="button">
                                @if (!string.IsNullOrEmpty(cat.Icon))
                                {
                                    <img src="~/uploads/categories/@cat.Icon" width="40" class="me-3" />
                                }
                                <h4 class="m-0">@cat.Name</h4>
                            </button>
                        }
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="tab-content w-100">
                        @for (int i = 0; i < Model.Categories.Count; i++)
                        {
                            var cat = Model.Categories[i];
                            <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="cat-@cat.Id">
                                @foreach (var sub in cat.SubServices)
                                {
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-6" style="min-height:350px;">
                                            <div class="position-relative h-100">
                                                @if (!string.IsNullOrEmpty(sub.Video))
                                                {
                                                    <video class="position-absolute w-100 h-100"
                                                           style="object-fit:cover; border-radius:15px;" controls preload="metadata">
                                                        <source src="~/uploads/subvideos/@sub.Video" />
                                                    </video>
                                                }
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <h3 class="mb-3">@sub.Title</h3>
                                            <p class="mb-4">@sub.Description</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Booking Form -->

    <div class="container-fluid bg-secondary booking my-5">
        <div class="container">
            <div class="row gx-5">

                <div class="col-lg-6 py-5">
                    <h1 class="text-white mb-4">
                        Etibarlı Avtomobil Təmiri Xidməti
                    </h1>
                    <p class="text-white">
                        Peşəkar və sürətli texniki xidmət
                    </p>
                </div>

                <div class="col-lg-6">
                    <div class="bg-primary p-5 text-center">

                        <h2 class="text-white mb-4">Öncədən Rezervasiya</h2>

                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["Success"]
                            </div>
                        }

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger">
                                @TempData["Error"]
                            </div>
                        }
                        <form id="reservationForm">
                            @Html.AntiForgeryToken()

                            <div class="row g-3">

                                <div class="col-12 col-sm-6">
                                    <input asp-for="Reservation.FullName"
                                           class="form-control"
                                           placeholder="Ad Soyad"
                                           required />
                                </div>

                                <div class="col-12 col-sm-6">
                                    <input asp-for="Reservation.Phone"
                                           id="phoneInput"
                                           class="form-control"
                                           placeholder="+994 XX XXX XX XX"
                                           required />
                                </div>

                                <div class="col-12 col-sm-6">
                                    <select asp-for="Reservation.ServiceId"
                                            class="form-select"
                                            required>
                                        <option value="">Xidmət seçin</option>
                                        @foreach (var s in Model.Reservation.Services)
                                        {
                                            <option value="@s.Id">@s.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-12 col-sm-6">
                                    <input asp-for="Reservation.DateTime"
                                           type="datetime-local"
                                           class="form-control"
                                           step="60"
                                           required />
                                </div>

                                <div class="col-12">
                                    <textarea asp-for="Reservation.Note"
                                              class="form-control"
                                              placeholder="Əlavə qeyd (məs: avtomobil modeli, ili, mühərrik həcmi)"></textarea>
                                </div>

                                <!-- WhatsApp checkbox -->
                                <div class="col-12 text-start">
                                    <input type="checkbox" id="sameAsPhone" />
                                    <label for="sameAsPhone" class="text-white">
                                        WhatsApp nömrəsi telefonla eyni olsun
                                    </label>
                                </div>

                                <div class="col-12">
                                    <input asp-for="Reservation.WhatsApp"
                                           id="whatsappInput"
                                           class="form-control"
                                           placeholder="+994 XX XXX XX XX" />
                                </div>

                                <div class="col-12">
                                    <button type="submit"
                                            class="btn btn-dark w-100 py-3">
                                        REZERVASİYA
                                    </button>
                                </div>

                            </div>

                            <div id="reservationMessage" class="mt-3"></div>
                        </form>




                    </div>
                </div>

            </div>
        </div>
    </div>
<!-- Booking End -->
    <!-- Team Start -->
    <div class="container-xxl py-5">
        <div class="container">

            <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
                <h6 class="text-primary text-uppercase">Bizim Texniklər</h6>
                <h1 class="mb-5">Mütəxəssislərimiz</h1>
            </div>

            <div class="row g-4 justify-content-center">

                @foreach (var t in Model.Technicians)
                {
                    <div class="col-lg-3 col-md-6 wow fadeInUp">
                        <div class="team-item shadow rounded overflow-hidden">

                            <div class="position-relative overflow-hidden">
                                <img class="img-fluid w-100"
                                     src="~/uploads/technicians/@t.Image"
                                     style="height:300px; object-fit:cover;" />

                                <div class="team-overlay position-absolute start-0 top-0 w-100 h-100 d-flex align-items-center justify-content-center">

                                    @if (!string.IsNullOrEmpty(t.FacebookUrl))
                                    {
                                        <a class="btn btn-square mx-1" href="@t.FacebookUrl" target="_blank">
                                            <i class="fab fa-facebook-f"></i>
                                        </a>
                                    }

                                    @if (!string.IsNullOrEmpty(t.InstagramUrl))
                                    {
                                        <a class="btn btn-square mx-1" href="@t.InstagramUrl" target="_blank">
                                            <i class="fab fa-instagram"></i>
                                        </a>
                                    }

                                    @if (!string.IsNullOrEmpty(t.TiktokUrl))
                                    {
                                        <a class="btn btn-square mx-1" href="@t.TiktokUrl" target="_blank">
                                            <i class="fab fa-tiktok"></i>
                                        </a>
                                    }
                                </div>
                            </div>

                            <div class="bg-light text-center p-4">
                                <h5 class="fw-bold mb-0">@t.FullName</h5>
                                <small>@t.Position</small>
                            </div>

                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</main>