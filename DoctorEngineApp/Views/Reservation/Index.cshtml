@model ReservationPageVM

@{
    ViewData["Title"] = "Rezervasiya";
}

<partial name="_PageHeader" model='("Rezervasiya", "Mühərrik diaqnostikası və təmiri üçün onlayn növbə götürün — gözləmədən, rahat.")' />

<partial name="_InformCards" model="Model.Informs" />
<partial name="_BookingForm" for="Reservation" />
<!-- Telefon: rezervasiya forması ilə eyni endə yığcam blok -->
@if (!string.IsNullOrEmpty(Model.ContactPhone?.PhoneNumber))
{
    var tel = Model.ContactPhone.PhoneNumber.Replace(" ", "");
    <section class="rs-call">
        <div class="container">
            <div class="rs-call__box wow fadeInUp" data-wow-delay="0.1s">
                <div class="rs-call__text">
                    @if (!string.IsNullOrWhiteSpace(Model.ContactPhone.Subtitle))
                    {
                        <span class="rs-call__eyebrow">@Model.ContactPhone.Subtitle</span>
                    }
                    <h2>@Model.ContactPhone.Title</h2>
                    <p>@Model.ContactPhone.Description</p>
                </div>
                <a class="rs-call__btn" href="tel:@tel">
                    <span class="rs-call__icon"><i class="fa fa-phone-alt"></i></span>
                    <span class="rs-call__num">
                        <small>İndi zəng edin</small>
                        <strong>@Model.ContactPhone.PhoneNumber</strong>
                    </span>
                    <i class="fa-solid fa-arrow-right rs-call__arrow" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>
}
