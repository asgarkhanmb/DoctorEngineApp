@model ReservationPageVM

@{
    ViewData["Title"] = "Rezervasiya";
}

<!-- Service Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-4">
            @for (int i = 0; i < Model.Informs.Count; i++)
            {
                var item = Model.Informs[i];
                var delay = (i * 0.2) + 0.1;

                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="@($"{delay:0.0}s")">
                    <div class="d-flex @(i == 1 ? "bg-light" : "") py-5 px-4 align-items-center">
                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <img src="@item.Icon" alt="@item.Title" class="flex-shrink-0" style="width:50px; height:50px; object-fit:contain;" />
                        }
                        <div class="ps-4">
                            <h5 class="mb-3">@item.Title</h5>
                            <p>@item.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<!-- Service End -->
<!-- Booking Start -->
<div class="container-fluid bg-secondary booking my-5">
    <div class="container">
        <div class="row gx-5">

            <div class="col-lg-6 py-5">
                <h1 class="text-white mb-4">
                    Etibarlı Avtomobil Təmiri Xidməti
                </h1>
                <p class="text-white">
                    Rezervasiya Bölməsi güc, etibarlılıq və peşəkarlığın bir araya gəldiyi xüsusi xidmət sahəsidir.Müasir avadanlıqlarımız və peşəkar komandamız sayəsində ehtiyaclarınıza uyğun mühərriki sürətli, rahat və təhlükəsiz şəkildə təmir etdirə bilərsiniz.Buyrun öncədən rezerv edin avtomobilinizə vaxtında qulluq edin.
                </p>
            </div>

            <div class="col-lg-6">
                <div class="bg-primary p-5 text-center">

                    <h2 class="text-white mb-4">Öncədən Rezervasiya</h2>

                    <form id="reservationForm"
                          asp-controller="Reservation"
                          asp-action="CreateReservation"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="row g-3">

                            <div class="col-12 col-sm-6">
                                <input asp-for="Reservation.FullName"
                                       class="form-control"
                                       placeholder="Ad Soyad" />
                            </div>

                            <div class="col-12 col-sm-6">
                                <input asp-for="Reservation.Phone"
                                       id="phoneInput"
                                       class="form-control"
                                       placeholder="+994 XX XXX XX XX" />
                            </div>

                            <div class="col-12 col-sm-6">
                                <select asp-for="Reservation.ServiceId"
                                        class="form-select">
                                    <option value="">Xidmət seçin</option>
                                    @foreach (var s in Model.Reservation.Services)
                                    {
                                        <option value="@s.Id">@s.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-sm-6">
                                <input type="datetime-local"
                                       name="Reservation.DateTime"
                                       value="@Model.Reservation.DateTime.ToString("yyyy-MM-ddTHH:mm")"
                                       class="form-control"
                                       step="60" />

                            </div>

                            <div class="col-12">
                                <textarea asp-for="Reservation.Note"
                                          class="form-control"
                                          placeholder="Əlavə qeyd"></textarea>
                            </div>

                            <!-- WhatsApp checkbox -->
                            <div class="col-12 text-start">
                                <input type="checkbox" id="sameAsPhone" />
                                <label for="sameAsPhone" class="text-white">
                                    WhatsApp nömrəsi telefonla eyni olsun
                                </label>
                            </div>

                            <div class="col-12">
                                <input asp-for="Reservation.WhatsApp"
                                       id="whatsappInput"
                                       class="form-control"
                                       placeholder="+994 XX XXX XX XX" />
                            </div>

                            <div class="col-12">
                                <button type="submit"
                                        class="btn btn-dark w-100 py-3">
                                    Rezerv Edin
                                </button>
                            </div>

                        </div>

                        <div id="reservationMessage" class="mt-3"></div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- Booking End -->
<!-- Call To Action Start -->
<div class="container-xxl py-5 wow fadeInUp" data-wow-delay="0.1s">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8 col-md-6">
                <h6 class="text-primary text-uppercase">
                    @Model.ContactPhone.Subtitle
                </h6>
                <h1 class="mb-4">
                    @Model.ContactPhone.Title
                </h1>
                <p class="mb-0">
                    @Model.ContactPhone.Description
                </p>
            </div>
            <div class="col-lg-4 col-md-6 mt-5">
                <div class="bg-primary d-flex flex-column justify-content-center text-center h-60 p-4">
                    <h3 class="text-white mb-4">
                        <i class="fa fa-phone-alt me-3"></i>
                        @Model.ContactPhone.PhoneNumber
                    </h3>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Call To Action End -->
