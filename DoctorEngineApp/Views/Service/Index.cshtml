@model ServicePageVM

@{
    ViewData["Title"] = "Xidmətlər";
}
<div class="container-xxl service py-5">
    <div class="container">

        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="text-primary text-uppercase">Xidmətlərimiz</h6>
            <h1 class="mb-5">Xidmətlərimizi Araşdırın</h1>
        </div>

        <div class="row g-4 wow fadeInUp" data-wow-delay="0.3s">

            <!-- Categories Nav -->
            <div class="col-lg-4">
                <div class="nav w-100 nav-pills me-4" role="tablist">
                    @for (int i = 0; i < Model.Categories.Count; i++)
                    {
                        var cat = Model.Categories[i];
                        <button class="nav-link w-100 d-flex align-items-center text-start p-4 mb-3 @(i == 0 ? "active" : "")"
                                data-bs-toggle="pill"
                                data-bs-target="#cat-@cat.Id"
                                type="button">
                            @if (!string.IsNullOrEmpty(cat.Icon))
                            {
                                <img src="@Url.Content($"~/uploads/categories/{cat.Icon}")" width="40" class="me-3" />
                            }
                            <h4 class="m-0">@cat.Name</h4>
                        </button>
                    }
                </div>
            </div>

            <!-- Tab Content -->
            <div class="col-lg-8">
                <div class="tab-content w-100">
                    @for (int i = 0; i < Model.Categories.Count; i++)
                    {
                        var cat = Model.Categories[i];
                        <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="cat-@cat.Id">

                            @foreach (var sub in cat.SubServices)
                            {
                                <div class="row g-4 mb-4">

                                    <!-- Video Column -->
                                    <div class="col-md-6" style="min-height:350px;">
                                        <div class="position-relative h-100">
                                            @if (!string.IsNullOrEmpty(sub.Video))
                                            {
                                                <video class="position-absolute w-100 h-100"
                                                       style="object-fit:cover; border-radius:15px;"
                                                       controls preload="metadata">
                                                    <source src="@Url.Content($"~/uploads/subvideos/{sub.Video}")" type="video/mp4" />
                                                    Your browser does not support the video tag.
                                                </video>
                                            }
                                        </div>
                                    </div>

                                    <!-- Text Column -->
                                    <div class="col-md-6">
                                        <h3 class="mb-3">@sub.Title</h3>
                                        <p class="mb-4">@sub.Description</p>
                                    </div>

                                </div>
                            }

                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
