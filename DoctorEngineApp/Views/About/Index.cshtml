@model AboutVM

@{
    ViewData["Title"] = "Haqqımızda";
    var phone = Model.Contact?.Phone;
    var telHref = string.IsNullOrWhiteSpace(phone) ? null : "tel:" + new string(phone.Where(c => char.IsDigit(c) || c == '+').ToArray());
    var informs = Model.Informs ?? new();
}

@section css {
    <link rel="stylesheet" href="~/css/services.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}

<partial name="_PageHeader" model='("Haqqımızda", "Mühərrik təmirində təcrübə, müasir avadanlıq və hər müştəriyə fərdi yanaşma.")' />

<div class="sv ab">

    <!-- ================= BİZ KİMİK ================= -->
    <partial name="_AboutHero" model='new AboutSectionVM(Model.Title, Model.Description, Model.VideoPath, Model.Informs)' />

    <!-- ================= NİYƏ BİZ ================= -->
    @if (informs.Any())
    {
        <section class="ab-why">
            <div class="container">
                <div class="sv-head wow fadeInUp" data-wow-delay="0.1s">
                    <span class="sv-eyebrow">@L.T("Niyə biz?")</span>
                    <h2>@L.T("Üstünlüklərimiz")</h2>
                    <p>@L.T("Avtomobilinizi etibar edə biləcəyiniz səbəblər.")</p>
                </div>

                <div class="ab-why__grid">
                    @for (int i = 0; i < informs.Count; i++)
                    {
                        var inf = informs[i];
                        // Təsvir admin paneldə vergüllə yazılır: "Peşəkar baxım,Etibarlı nəticə" → siyahı
                        var points = L.T(inf.Description)
                            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                        <article class="ab-why__card wow fadeInUp" data-wow-delay="@($"{i * 0.1 + 0.1:0.0}s")">
                            <div class="ab-why__top">
                                @if (!string.IsNullOrEmpty(inf.Icon))
                                {
                                    <span class="ab-why__icon"><img src="@inf.Icon" alt="" loading="lazy" /></span>
                                }
                                <span class="ab-why__num" aria-hidden="true">0@(i + 1)</span>
                            </div>
                            <h3>@L.T(inf.Title)</h3>
                            @if (points.Length > 1)
                            {
                                <ul>
                                    @foreach (var p in points)
                                    {
                                        <li>@p</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p>@L.T(inf.Description)</p>
                            }
                        </article>
                    }
                </div>
            </div>
        </section>
    }

    <!-- ================= KOMANDA ================= -->
    <partial name="_TeamSection" model="Model.Technicians" />

    <!-- ================= ÇAĞIRIŞ ================= -->
    <section class="container sv-cta-wrap ab-cta-wrap">
        <div class="sv-cta wow fadeInUp" data-wow-delay="0.1s">
            <div>
                <h2>@L.T("Mühərrikinizlə bağlı sualınız var?")</h2>
                <p>@L.T("Bizə zəng edin, usta ilə yazışın və ya elə indi rezervasiya edin — vaxtınıza qənaət edin.")</p>
            </div>
            <div class="sv-cta__actions">
                <a asp-controller="Reservation" asp-action="Index" class="sv-btn sv-btn--primary sv-btn--lg">@L.T("Rezervasiya et") <i class="fa-solid fa-arrow-right"></i></a>
                @if (telHref != null)
                {
                    <a href="@telHref" class="sv-btn sv-btn--light sv-btn--lg"><i class="fa-solid fa-phone"></i> @L.T("Zəng et")</a>
                }
                <a asp-controller="Contact" asp-action="Index" asp-fragment="chat" class="sv-btn sv-btn--light sv-btn--lg"><i class="fa-regular fa-comments"></i> @L.T("Usta ilə çat")</a>
            </div>
        </div>
    </section>
</div>
