@* Xidmətlər: solda kateqoriya tabları, sağda həmin kateqoriyanın videolu xidmətləri.
   İstifadə: Ana səhifə və Xidmətlər səhifəsi. Model: List<CategoryVM> *@
@using DoctorEngineApp.ViewModels.Categories
@model List<CategoryVM>
@{
    var cats = Model ?? new();
    // Səhifə boş tabla açılmasın: xidməti olan ilk kateqoriya aktiv olur
    var activeId = cats.FirstOrDefault(c => c.SubServices?.Any() == true)?.Id ?? cats.FirstOrDefault()?.Id;
}

@if (!cats.Any())
{
    <div class="de-empty">
        <i class="fa-solid fa-screwdriver-wrench"></i>
        Xidmətlər tezliklə əlavə olunacaq.
    </div>
}
else
{
    <div class="row g-4 de-services" data-de-services>

        <!-- Kateqoriyalar -->
        <div class="col-lg-4">
            <div class="nav w-100 nav-pills flex-column de-services__tabs" role="tablist" aria-orientation="vertical">
                @foreach (var cat in cats)
                {
                    // Hər kateqoriyada bir video göstərilir (ən köhnə qeyd)
                    var video = cat.SubServices?.FirstOrDefault();
                    var isActive = cat.Id == activeId;
                    <button class="nav-link w-100 d-flex align-items-center text-start p-4 mb-3 @(isActive ? "active" : "")"
                            id="cat-@cat.Id-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#cat-@cat.Id"
                            type="button"
                            role="tab"
                            aria-controls="cat-@cat.Id"
                            aria-selected="@(isActive ? "true" : "false")">
                        @if (!string.IsNullOrEmpty(cat.Icon))
                        {
                            <img src="@Url.Content($"~/uploads/categories/{cat.Icon}")" width="40" height="40" class="me-3" alt="" />
                        }
                        <span class="de-services__tab-text">
                            <span class="h4 m-0 d-block">@cat.Name</span>
                            <small class="de-services__count">@(video == null ? "Tezliklə" : video.Title)</small>
                        </span>
                    </button>
                }
            </div>
        </div>

        <!-- Məzmun -->
        <div class="col-lg-8">
            <div class="tab-content w-100">
                @foreach (var cat in cats)
                {
                    var isActive = cat.Id == activeId;
                    <div class="tab-pane fade @(isActive ? "show active" : "")" id="cat-@cat.Id" role="tabpanel" aria-labelledby="cat-@cat.Id-tab" tabindex="0">

                        @if (cat.SubServices == null || !cat.SubServices.Any())
                        {
                            <div class="de-empty">
                                <i class="fa-regular fa-clock"></i>
                                <strong class="d-block mb-1">“@cat.Name” xidmətləri tezliklə əlavə olunacaq</strong>
                                Bu barədə sualınız varsa, <a asp-controller="Contact" asp-action="Index" asp-fragment="chat">usta ilə yazışın</a>
                                və ya <a asp-controller="Reservation" asp-action="Index">rezervasiya edin</a>.
                            </div>
                        }
                        else
                        {
                            // Hər kateqoriyada yalnız bir video — videolar alt-alta düşmür
                            foreach (var sub in cat.SubServices.Take(1))
                            {
                                <article class="de-service">
                                    @if (!string.IsNullOrEmpty(sub.Video))
                                    {
                                        <div class="de-service__media">
                                            @* Vahid 16:9 çərçivə: video kəsilmir, şaquli videoların yanları bulanıq fonla dolur *@
                                            <partial name="_VideoFrame" model='new VideoFrame(Url.Content($"~/uploads/subvideos/{sub.Video}"))' />
                                        </div>
                                    }
                                    <div class="de-service__body">
                                        <span class="de-service__cat">@cat.Name</span>
                                        <h3>@sub.Title</h3>
                                        <p>@sub.Description</p>
                                        <div class="de-service__actions">
                                            <a asp-controller="Reservation" asp-action="Index" class="btn btn-primary py-2 px-4">
                                                Rezervasiya et <i class="fa fa-arrow-right ms-2"></i>
                                            </a>
                                            <a asp-controller="Assistant" asp-action="Index" class="btn de-service__ghost py-2 px-3">
                                                <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Sual ver
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
