@* Daxili səhifələr üçün başlıq. İstifadə:
   <partial name="_PageHeader" model='("Başlıq", "Qısa izah")' /> *@
@model (string Title, string? Subtitle)

<section class="de-page-header">
    <div class="container">
        <h1>@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
        {
            <p>@Model.Subtitle</p>
        }
        <nav aria-label="breadcrumb">
            <ol class="de-breadcrumb">
                <li><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house"></i> Ana Səhifə</a></li>
                <li class="sep" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></li>
                <li aria-current="page">@Model.Title</li>
            </ol>
        </nav>
    </div>
</section>
