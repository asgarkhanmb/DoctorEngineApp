@using DoctorEngineApp.Services.Interfaces
@using Microsoft.AspNetCore.Mvc.Routing
@inject IHttpContextAccessor HttpContextAccessor
@inject IWhatsappService WhatsAppService
@inject ISiteSettingService SiteSettings
@inject IContactInfoService ContactInfo

@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var userName = User.Identity?.Name ?? "";
    var initial = userName.Length > 0 ? userName.Substring(0, 1) : "?";
    // Profil şəkli login cookie-sindən gəlir (AppClaimsPrincipalFactory)
    var avatar = (User as System.Security.Claims.ClaimsPrincipal)?.FindFirst(DoctorEngineApp.Helpers.AppClaimsPrincipalFactory.AvatarClaim)?.Value;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var site = await SiteSettings.GetAsync();
    var contact = await ContactInfo.GetFirstAsync();
    var phone = contact?.Phone;
}

<!-- Canlı məlumat zolağı: iş statusu (Bakı vaxtı ilə hər dəqiqə yenilənir), saatlar, telefon -->
    <div class="de-topbar" data-de-hours data-weekdays="@contact?.Weekdays" data-weekend="@contact?.Weekend">
        <div class="de-topbar__inner">
            <span class="de-status" data-de-status hidden>
                <span class="de-status__dot" aria-hidden="true"></span>
                <span class="de-status__text" aria-live="polite"></span>
            </span>
            @if (!string.IsNullOrWhiteSpace(contact?.Weekdays))
            {
                <span class="de-topbar__item d-none d-md-inline-flex">
                    <i class="fa-regular fa-clock" aria-hidden="true"></i>
                    B.e–Cümə: @contact!.Weekdays @if (!string.IsNullOrWhiteSpace(contact.Weekend)) { <span>· Şənbə–Bazar: @contact.Weekend</span> }
                </span>
            }
            <span class="de-topbar__right">
                <a asp-controller="Assistant" asp-action="Index" class="de-topbar__item d-none d-lg-inline-flex">
                    <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> AI ilə sual ver
                </a>
                @if (!string.IsNullOrWhiteSpace(phone))
                {
                    <a href="tel:@phone.Replace(" ", "")" class="de-topbar__item">
                        <i class="fa-solid fa-phone" aria-hidden="true"></i> @phone
                    </a>
                }
            </span>
        </div>
    </div>

<header class="s-header">
    <!-- Navbar Start -->
    <nav class="navbar navbar-expand-lg bg-white navbar-light shadow sticky-top p-0" aria-label="Əsas menyu">
        <a asp-controller="Home" asp-action="Index" class="navbar-brand d-flex align-items-center px-4 px-lg-5">
            <h2 class="m-0 text-primary">
                <partial name="_BrandIcon" model="site" />@site.SiteName
            </h2>
        </a>

        <!-- Mobile Toggle Button -->
        <button type="button" class="navbar-toggler me-4" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                aria-controls="navbarCollapse" aria-expanded="false" aria-label="Menyunu aç">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto align-items-lg-center p-4 p-lg-0 pe-lg-5">

                <a asp-controller="Home" asp-action="Index" class="nav-item nav-link @IsActive("Home")" aria-current="@AriaCurrent("Home")">Ana Səhifə</a>
                <a asp-controller="About" asp-action="Index" class="nav-item nav-link @IsActive("About")" aria-current="@AriaCurrent("About")">Haqqımızda</a>
                <a asp-controller="Service" asp-action="Index" class="nav-item nav-link @IsActive("Service")" aria-current="@AriaCurrent("Service")">Xidmətlər</a>
                <a asp-controller="Reservation" asp-action="Index" class="nav-item nav-link @IsActive("Reservation")" aria-current="@AriaCurrent("Reservation")">Rezervasiya</a>
                <a asp-controller="Contact" asp-action="Index" class="nav-item nav-link @IsActive("Contact", "Chat")" aria-current="@AriaCurrent("Contact", "Chat")">Əlaqə</a>
                <a asp-controller="Assistant" asp-action="Index" class="nav-item nav-link de-nav-ai @IsActive("Assistant")" aria-current="@AriaCurrent("Assistant")"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> AI Köməkçi</a>

                <!-- İstifadəçi -->
                <div class="de-user">
                    @if (isAuthenticated)
                    {
                        <div class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle de-user-toggle" href="#" id="userDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                @if (!string.IsNullOrEmpty(avatar))
                                {
                                    <img class="de-avatar" src="~/uploads/avatars/@avatar" alt="" aria-hidden="true" style="object-fit:cover" />
                                }
                                else
                                {
                                    <span class="de-avatar" aria-hidden="true">@initial</span>
                                }
                                <span class="de-user-name">@userName</span>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li class="de-dropdown-head">
                                    <strong>@userName</strong>
                                    <small>@(User.IsInRole("Admin") ? "Administrator" : "İstifadəçi")</small>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">
                                        <i class="fa-regular fa-id-card"></i> Profilim
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Chat" asp-action="Index">
                                        <i class="fa-regular fa-comments"></i> Canlı çat
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Reservation" asp-action="Index">
                                        <i class="fa-regular fa-calendar-check"></i> Rezervasiya et
                                    </a>
                                </li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                            <i class="fa-solid fa-gauge-high"></i> Admin Panel
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-area="" asp-controller="Account" asp-action="Logout">
                                        <button type="submit" class="dropdown-item is-danger">
                                            <i class="fa-solid fa-arrow-right-from-bracket"></i> Çıxış
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" class="de-login-btn">
                            <i class="fa-regular fa-user"></i> Daxil ol
                        </a>
                    }
                </div>

            </div>
        </div>
    </nav>
    <!-- Navbar End -->

    <!-- WhatsApp Floating Button -->
    @{
        var whatsapp = await WhatsAppService.GetAsync();
    }

    @if (whatsapp != null)
    {
        <a href="https://wa.me/@whatsapp.PhoneNumber?text=@Uri.EscapeDataString(whatsapp.Message ?? "")"
           class="whatsapp-btn"
           target="_blank"
           rel="noopener"
           aria-label="WhatsApp ilə yazın">
            <i class="bi bi-whatsapp"></i>
        </a>
    }
</header>

@functions {
    private bool IsCurrent(params string[] controllers)
    {
        var current = HttpContextAccessor.HttpContext?.GetRouteData().Values["controller"]?.ToString();
        return controllers.Any(c => string.Equals(current, c, StringComparison.OrdinalIgnoreCase));
    }

    private string IsActive(params string[] controllers) => IsCurrent(controllers) ? "active" : "";

    private string? AriaCurrent(params string[] controllers) => IsCurrent(controllers) ? "page" : null;
}
