@model ContactInfoVm

<footer>
    <div class="container-fluid bg-dark text-light footer pt-5 mt-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container py-5">
            <div class="row g-5">

                <div class="col-lg-3 col-md-6">
                    <h4 class="text-light mb-4">Ünvan</h4>

                    <p class="mb-2">
                        <i class="fa fa-map-marker-alt me-3"></i>@Model?.Address
                    </p>

                    <p class="mb-2">
                        <i class="fa fa-phone-alt me-3"></i>@Model?.Phone
                    </p>

                    <p class="mb-2">
                        <i class="fa fa-envelope me-3"></i>@Model?.Email
                    </p>

                    @{
                        string whatsappLink = null;

                        if (!string.IsNullOrEmpty(Model?.WhatsApp))
                        {
                            whatsappLink = "https://wa.me/" +
                            Model.WhatsApp.Replace("+", "").Replace(" ", "") +
                            "?text=Salam";
                        }
                    }

                    <div class="d-flex">

                        @if (!string.IsNullOrEmpty(Model?.YouTube))
                        {
                            <a href="@Model.YouTube" target="_blank" class="btn btn-outline-secondary me-2">
                                <i class="fab fa-youtube" style="color:red;"></i>

                            </a>
                        }

                        @if (!string.IsNullOrEmpty(Model?.Facebook))
                        {
                            <a href="@Model.Facebook" target="_blank" class="btn btn-outline-secondary me-2">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                        }

                        @if (!string.IsNullOrEmpty(Model?.TikTok))
                        {
                            <a href="@Model.TikTok" target="_blank" class="btn btn-outline-secondary me-2"
                             style="background-color:black; color:white;">
                                    <i class="fab fa-tiktok"></i>
                            </a>
                        }

                        @if (!string.IsNullOrEmpty(whatsappLink))
                        {
                            <a href="@whatsappLink" target="_blank" class="btn btn-outline-success">
                                <i class="fab fa-whatsapp"></i>
                            </a>
                        }
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h4 class="text-light mb-4">İş Saatları</h4>

                    <h6 class="text-light">Bazar ertəsi - Cümə:</h6>
                    <p class="mb-4">@Model?.Weekdays</p>

                    <h6 class="text-light">Şənbə - Bazar:</h6>
                    <p class="mb-0">@Model?.Weekend</p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h4 class="text-light mb-4">Xidmətlər</h4>

                    @if (Model?.Services != null && Model.Services.Any())
                    {
                        foreach (var service in Model.Services)
                        {
                            <a class="btn btn-link">
                                @service.Name
                            </a>
                        }
                    }
                    else
                    {
                        <p class="text-secondary">Servislər əlavə olunmayıb</p>
                    }
                </div>

            </div>
        </div>
        <div class="container">
            <div class="copyright">
                <div class="row">
                    <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                        Developed by <strong>Asgarkhan Bayramov</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>
