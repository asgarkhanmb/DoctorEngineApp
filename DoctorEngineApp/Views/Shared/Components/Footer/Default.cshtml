@model ContactInfoVm
@inject DoctorEngineApp.Services.Interfaces.ISiteSettingService SiteSettings

@{
    string? whatsappLink = null;
    if (!string.IsNullOrEmpty(Model?.WhatsApp))
    {
        whatsappLink = "https://wa.me/" + Model.WhatsApp.Replace("+", "").Replace(" ", "") + "?text=Salam";
    }
    var site = await SiteSettings.GetAsync();
    var phoneHref = string.IsNullOrEmpty(Model?.Phone) ? null : "tel:" + Model.Phone.Replace(" ", "");
}

<footer>
    <div class="container-fluid text-light footer pt-5">
        <div class="container py-5">
            <div class="row g-5">

                <!-- Brend -->
                <div class="col-lg-3 col-md-6">
                    <a asp-controller="Home" asp-action="Index" class="de-footer-brand">
                        <span class="de-footer-brand__icon"><partial name="_BrandIcon" model="site" /></span> @site.SiteName
                    </a>
                    <p class="mb-0">
                        Yeni model dizel və benzin mühərriklərinin peşəkar diaqnostikası və təmiri.
                        Müasir avadanlıq, təcrübəli ustalar, etibarlı nəticə.
                    </p>

                    <div class="de-social">
                        @if (!string.IsNullOrEmpty(Model?.YouTube))
                        {
                            <a href="@Model.YouTube" target="_blank" rel="noopener" class="yt" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(Model?.Facebook))
                        {
                            <a href="@Model.Facebook" target="_blank" rel="noopener" class="fb" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(Model?.TikTok))
                        {
                            <a href="@Model.TikTok" target="_blank" rel="noopener" class="tt" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(whatsappLink))
                        {
                            <a href="@whatsappLink" target="_blank" rel="noopener" class="wa" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                        }
                    </div>
                </div>

                <!-- Əlaqə -->
                <div class="col-lg-3 col-md-6">
                    <h4 class="text-light mb-4">Əlaqə</h4>

                    @if (!string.IsNullOrEmpty(Model?.Address))
                    {
                        <p class="mb-3 d-flex"><i class="fa fa-map-marker-alt me-3 mt-1"></i><span>@Model.Address</span></p>
                    }
                    @if (phoneHref != null)
                    {
                        <p class="mb-3 d-flex"><i class="fa fa-phone-alt me-3 mt-1"></i><a class="text-reset" href="@phoneHref">@Model!.Phone</a></p>
                    }
                    @if (!string.IsNullOrEmpty(Model?.Email))
                    {
                        <p class="mb-3 d-flex"><i class="fa fa-envelope me-3 mt-1"></i><a class="text-reset text-break" href="mailto:@Model.Email">@Model.Email</a></p>
                    }
                </div>

                <!-- İş saatları -->
                <div class="col-lg-3 col-md-6">
                    <h4 class="text-light mb-4">İş Saatları</h4>
                    <div class="de-hours">
                        <div data-de-days="weekdays"><span>B.e – Cümə</span><strong>@Model?.Weekdays</strong></div>
                        <div data-de-days="weekend"><span>Şənbə – Bazar</span><strong>@Model?.Weekend</strong></div>
                    </div>
                </div>

                <!-- Keçidlər -->
                <div class="col-lg-3 col-md-6">
                    <h4 class="text-light mb-4">Xidmətlər</h4>

                    @* Yalnız xidmətlər: ən son əlavə olunan 5-i (çox olsa da footer böyümür) *@
                    @if (Model?.Services != null && Model.Services.Any())
                    {
                        <ul class="de-footer-services">
                            @foreach (var service in Model.Services)
                            {
                                <li>
                                    <a class="btn btn-link" asp-controller="Service" asp-action="Index" asp-fragment="cat-@service.Id" title="@service.Name">@service.Name</a>
                                </li>
                            }
                        </ul>
                        @if ((ViewData["ServiceTotal"] as int? ?? 0) > Model.Services.Count)
                        {
                            <a class="de-footer-more" asp-controller="Service" asp-action="Index">Bütün xidmətlər <i class="fa-solid fa-arrow-right"></i></a>
                        }
                    }
                    else
                    {
                        <p class="mb-0">Xidmətlər tezliklə əlavə olunacaq.</p>
                    }
                </div>

            </div>
        </div>

        <div class="container">
            <div class="copyright">
                <span>© @DateTime.Now.Year @site.SiteName — Bütün hüquqlar qorunur.</span>
                <span>
                    Developed by
                    <a href="https://www.linkedin.com/in/asgarkhanb/"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="de-dev-link">
                        Asgarkhan Bayramov
                    </a>
                </span>
            </div>
        </div>
    </div>
</footer>
