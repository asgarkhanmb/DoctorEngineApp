@model ContactPageVM

@{
    ViewData["Title"] = "Əlaqə";
    var phone = Model.Contact?.Phone;
    var email = Model.Contact?.Email;
}

<partial name="_PageHeader" model='("Əlaqə", "Sualınız var? Usta ilə canlı yazışın, zəng edin və ya mesaj göndərin.")' />

<!-- ===================================================== -->
<!-- CANLI ÇAT -->
<!-- ===================================================== -->

<div class="container-xxl py-5" id="chat">
    <div class="container">

        <div class="text-center mb-4 wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="text-primary text-uppercase">Canlı Əlaqə</h6>
            <h2 class="mb-3">Usta ilə Birbaşa Yazışın</h2>
            <p class="mb-0">Probleminizi yazın, şəkil və ya video göndərin — ustalarımız tezliklə cavab verəcək.</p>
        </div>

        <partial name="_ChatWidget" />

    </div>
</div>

<!-- ===================================================== -->
<!-- ƏLAQƏ MƏLUMATLARI -->
<!-- ===================================================== -->

<div class="container-xxl py-5">
    <div class="container">

        <div class="text-center mb-5 wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="text-primary text-uppercase">Bizimlə Əlaqə</h6>
            <h1 class="mb-0">İstənilən sual üçün əlaqə saxlayın</h1>
        </div>

        <div class="row g-4 mb-4">

            <div class="col-md-4 wow fadeInUp" data-wow-delay="0.1s">
                <div class="de-contact-card">
                    <span class="de-contact-card__icon"><i class="fa-solid fa-location-dot"></i></span>
                    <div>
                        <h5>Ünvan</h5>
                        <p>@(Model.Contact?.Address ?? "—")</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 wow fadeInUp" data-wow-delay="0.2s">
                <div class="de-contact-card">
                    <span class="de-contact-card__icon"><i class="fa-solid fa-phone"></i></span>
                    <div>
                        <h5>Telefon</h5>
                        @if (!string.IsNullOrEmpty(phone))
                        {
                            <a href="tel:@phone.Replace(" ", "")">@phone</a>
                        }
                        else
                        {
                            <p>—</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4 wow fadeInUp" data-wow-delay="0.3s">
                <div class="de-contact-card">
                    <span class="de-contact-card__icon"><i class="fa-solid fa-envelope"></i></span>
                    <div>
                        <h5>Email</h5>
                        @if (!string.IsNullOrEmpty(email))
                        {
                            <a href="mailto:@email">@email</a>
                        }
                        else
                        {
                            <p>—</p>
                        }
                    </div>
                </div>
            </div>

        </div>

        <div class="row g-4">

            <!-- Xəritə -->
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s">
                @if (Model.Map != null)
                {
                    <iframe class="de-map" src="@Model.Map.MapUrl" title="Xəritə: @Model.Map.Address"
                            loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
                }
            </div>

            <!-- Mesaj formu -->
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.2s" id="contact-form">
                <div class="de-form-card">
                    <h4>Mesaj göndərin</h4>
                    <p class="lead-sm">Formu doldurun, ən qısa zamanda sizinlə əlaqə saxlayacağıq.</p>

                    <form asp-action="SendMessage" asp-fragment="contact-form" method="post" novalidate data-de-loading="Göndərilir…">

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success d-flex align-items-center gap-2" role="status">
                                <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
                            </div>
                        }

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="Message.FullName">Ad Soyad</label>
                                <input asp-for="Message.FullName" class="form-control" autocomplete="off" placeholder="Adınız" />
                                <span asp-validation-for="Message.FullName" class="text-danger"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Message.Email">Email</label>
                                <input asp-for="Message.Email" type="email" class="form-control" autocomplete="off" placeholder="ad@numune.az" />
                                <span asp-validation-for="Message.Email" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Message.Subject">Mövzu</label>
                                <input asp-for="Message.Subject" class="form-control" placeholder="Məs: Mühərrik diaqnostikası" />
                                <span asp-validation-for="Message.Subject" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Message.Message">Mesaj</label>
                                <textarea asp-for="Message.Message" class="form-control" rows="4" placeholder="Mesajınızı yazın…"></textarea>
                                <span asp-validation-for="Message.Message" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary w-100 py-3">
                                    <i class="fa-regular fa-paper-plane me-2"></i> Göndər
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
