@model ContactPageVM

@{
    ViewData["Title"] = "Əlaqə";
}
<!-- ================= CHAT SECTION START ================= -->
<div class="container-xxl py-5">
    <div class="container">

        <!-- Title -->
        <div class="text-center mb-4">
            <h6 class="text-primary text-uppercase">Canlı Əlaqə</h6>
            <h2 class="mb-3">Usta ilə Birbaşa Yazışın</h2>
            <p class="text-muted">
                Mühərrik probleminizi yazın, ustalarımız sizə kömək etsin.
            </p>
        </div>

        <!-- Chat Box Centered -->
        <div class="d-flex justify-content-center">
            <div class="chat-widget">

                <div class="chat-header">
                    🔧 Canlı Usta Dəstəyi
                </div>

                <div class="chat-body" id="chatBody">
                    <div class="msg admin">
                        <div class="bubble">
                            Salam! Problemi qısa izah edə bilərsiniz?
                        </div>
                    </div>
                </div>

                <div class="chat-footer">
                    <input type="text"
                           id="chatInput"
                           placeholder="Mesajınızı yazın..." />
                    <button type="button" id="sendBtn">Göndər</button>
                </div>

            </div>
        </div>

    </div>
</div>
<!-- ================= CHAT SECTION END ================= -->
<!-- ================= CHAT CSS ================= -->
<style>
    .chat-widget {
        width: 100%;
        max-width: 420px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 12px 35px rgba(0,0,0,0.12);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        font-family: inherit;
    }

    .chat-header {
        background: linear-gradient(135deg, #dc3545, #b02a37);
        color: #fff;
        padding: 14px;
        text-align: center;
        font-weight: 600;
    }

    .chat-body {
        background: #f8f9fa;
        padding: 15px;
        height: 260px;
        overflow-y: auto;
    }

    .msg {
        margin-bottom: 12px;
        display: flex;
    }

        .msg.user {
            justify-content: flex-end;
        }

    .bubble {
        max-width: 75%;
        padding: 10px 14px;
        border-radius: 14px;
        font-size: 14px;
        line-height: 1.4;
    }

    .msg.admin .bubble {
        background: #e9ecef;
        color: #212529;
        border-bottom-left-radius: 4px;
    }

    .msg.user .bubble {
        background: #0d6efd;
        color: #fff;
        border-bottom-right-radius: 4px;
    }

    .chat-footer {
        display: flex;
        border-top: 1px solid #dee2e6;
    }

        .chat-footer input {
            flex: 1;
            border: none;
            padding: 12px;
            outline: none;
            font-size: 14px;
        }

        .chat-footer button {
            border: none;
            padding: 0 18px;
            background: #dc3545;
            color: #fff;
            font-weight: 500;
            cursor: pointer;
        }

            .chat-footer button:hover {
                background: #bb2d3b;
            }
</style>

<!-- ================= CHAT JS ================= -->
<script>
    const input = document.getElementById("chatInput");
    const body = document.getElementById("chatBody");
    const sendBtn = document.getElementById("sendBtn");

    sendBtn.addEventListener("click", sendMessage);

    input.addEventListener("keypress", function (e) {
        if (e.key === "Enter") {
            sendMessage();
        }
    });

    function sendMessage() {
        const text = input.value.trim();
        if (!text) return;

        body.insertAdjacentHTML("beforeend", `
            <div class="msg user">
                <div class="bubble">${text}</div>
            </div>
        `);

        input.value = "";
        body.scrollTop = body.scrollHeight;
    }
</script>

<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="text-primary text-uppercase">Bizimlə Əlaqə</h6>
            <h1 class="mb-4">İstənilən sual üçün əlaqə saxlayın</h1>
        </div>
        <div class="row g-4">
            <div class="col-12">
                <div class="row gy-2">
                    <!-- ADDRESS -->
                    <div class="col-md-4">
                        <div class="bg-light p-4">
                            <h5 class="text-uppercase">Ünvan</h5>
                            <p class="m-0">
                                <i class="fa fa-map-marker-alt me-3"></i>
                                @Model.Contact?.Address
                            </p>
                        </div>
                    </div>
                    <!-- PHONE -->
                    <div class="col-md-4">
                        <div class="bg-light p-4">
                            <h5 class="text-uppercase">Telefon</h5>
                            <p class="m-0">
                                <i class="fa fa-phone-alt me-3"></i>
                                @Model.Contact?.Phone
                            </p>
                        </div>
                    </div>
                    <!-- EMAIL -->
                    <div class="col-md-4">
                        <div class="bg-light p-4">
                            <h5 class="text-uppercase">Email</h5>
                            <p class="m-0">
                                <i class="fa fa-envelope me-3"></i>
                                @Model.Contact?.Email
                            </p>
                        </div>
                    </div>

                </div>
            </div>
            <!-- GOOGLE MAP -->
            <div class="col-md-6 wow fadeIn" data-wow-delay="0.1s">
                @if (Model.Map != null && !string.IsNullOrEmpty(Model.Map.MapUrl))
                {
                    <iframe class="rounded w-100 h-100"
                            src="@Model.Map.MapUrl"
                            style="min-height:250px;border:0;"
                            loading="lazy">
                    </iframe>
                }
            </div>
            <!-- CONTACT FORM -->
            <div class="col-md-6">
                <div class="wow fadeInUp" data-wow-delay="0.2s">
            <form asp-action="SendMessage" asp-controller="Contact" method="post">
                @Html.AntiForgeryToken()
                <!-- ÜMUMİ ERROR -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Message.FullName"
                                   class="form-control"
                                   placeholder="Ad Soyad" />
                            <label>Ad Soyad</label>
                        </div>
                        <span asp-validation-for="Message.FullName"
                              class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Message.Email"
                                   class="form-control"
                                   placeholder="Email" />
                            <label>Email</label>
                        </div>
                        <span asp-validation-for="Message.Email"
                              class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="Message.Subject"
                                   class="form-control"
                                   placeholder="Mövzu" />
                            <label>Mövzu</label>
                        </div>
                        <span asp-validation-for="Message.Subject"
                              class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-floating">
                            <textarea asp-for="Message.Message"
                                      class="form-control"
                                              placeholder="Mesaj" style="height:100px"></textarea>
                            <label>Mesaj</label>
                        </div>
                        <span asp-validation-for="Message.Message"
                              class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <button type="submit"
                                class="btn btn-primary w-100 py-3">
                            Göndər
                        </button>
                    </div>
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="col-12 mt-3">
                            <div class="alert alert-success text-center">
                                @TempData["SuccessMessage"]
                            </div>
                        </div>
                    }
                </div>
            </form>
        </div>
    </div>
</div>
</div>
</div>

