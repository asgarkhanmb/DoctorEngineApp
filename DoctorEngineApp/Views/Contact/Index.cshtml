@model ContactPageVM

@{
    ViewData["Title"] = "Əlaqə";
}

<div class="container-xxl py-5">
    <div class="container">

        <!-- Başlıq -->
        <div class="text-center mb-4">
            <h6 class="text-primary text-uppercase">Canlı Əlaqə</h6>
            <h2 class="mb-3">Usta ilə Birbaşa Yazışın</h2>
        </div>

        <div class="d-flex justify-content-center">
            <div class="chat-widget">

                <!-- Chat Başlıq -->
                <div class="chat-header">
                    🔧 Canlı Usta Dəstəyi
                </div>

                <!-- Chat Bədəni -->
                <div class="chat-body" id="chatBody">
                    @foreach (var msg in Model.ChatMessages)
                    {
                        var isMe = msg.UserName == User.Identity.Name;
                        <div class="msg @(isMe ? "user" : "admin")" id="msg-@msg.Id">
                            <div class="bubble">
                                <strong>@msg.UserName</strong>
                                <span class="text">@msg.Message</span>
                                @if (msg.IsEdited) { <small>(edit)</small> }
                                @if (isMe)
                                {
                                    <div class="actions">
                                        <button onclick="editMessage(@msg.Id)">✏️</button>
                                        <button onclick="deleteMessage(@msg.Id)">🗑️</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Chat Footer -->
                <div class="chat-footer">
                    <input id="chatInput" placeholder="Mesaj yaz..." />
                    <button id="sendBtn">Göndər</button>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- CSS -->
<style>
.chat-widget {
    max-width: 420px;
    width: 100%;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 35px rgba(0,0,0,0.12);
    display: flex;
    flex-direction: column;
    overflow: hidden;
}
.chat-header {
    background: #dc3545;
    color: #fff;
    padding: 12px;
    text-align: center;
}
.chat-body {
    height: 300px;
    overflow-y: auto;
    padding: 15px;
    background: #f8f9fa;
}
.msg {
    display: flex;
    margin-bottom: 10px;
    transition: .3s;
}
.msg.user { justify-content: flex-end; }
.bubble {
    max-width: 75%;
    background: #e9ecef;
    padding: 10px;
    border-radius: 12px;
    position: relative;
}
.msg.user .bubble { background: #0d6efd; color: #fff; }
.bubble strong { display: block; font-size: 12px; margin-bottom: 4px; }
.text { display: block; word-break: break-word; }

/* Actions */
.actions {
    display: none;
    position: absolute;
    top: -10px;
    right: 0;
    gap: 5px;
}
.msg.user:hover .actions { display: flex; }
.actions button {
    border: none;
    background: #fff;
    border-radius: 50%;
    padding: 4px 6px;
    cursor: pointer;
}

/* Delete Animation */
.msg.removing {
    opacity: 0;
    transform: translateX(40px);
}

/* Edit Input */
.edit-input {
    width: 100%;
    border: none;
    padding: 6px;
    border-radius: 6px;
}

/* Footer */
.chat-footer {
    display: flex;
    border-top: 1px solid #dee2e6;
    padding: 8px;
    gap: 8px;
    background: #fff;
}
.chat-footer input {
    flex: 1;
    border: 1px solid #ddd;
    padding: 10px 14px;
    border-radius: 20px;
    outline: none;
    font-size: 14px;
}
.chat-footer button {
    border: none;
    padding: 0 18px;
    background: #dc3545;
    color: #fff;
    border-radius: 20px;
    font-weight: 500;
    cursor: pointer;
}
.chat-footer button:hover { background: #bb2d3b; }
</style>

<!-- JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
const input = document.getElementById("chatInput");
const body = document.getElementById("chatBody");
const sendBtn = document.getElementById("sendBtn");

// Login yoxlaması
const isAuthenticated = @User.Identity.IsAuthenticated.ToString().ToLower();

// SignalR connection
const connection = new signalR.HubConnectionBuilder()
    .withUrl("/chatHub")
    .build();

connection.start();

// Yeni mesaj gəldikdə
connection.on("ReceiveMessage", function (user, message, id) {
    let isMe = user === "@User.Identity.Name";
    let html = `
    <div class="msg ${isMe ? "user" : "admin"}" id="msg-${id}">
        <div class="bubble">
            <strong>${user}</strong>
            <span class="text">${message}</span>
            ${isMe ? `
            <div class="actions">
                <button onclick="editMessage(${id})">✏️</button>
                <button onclick="deleteMessage(${id})">🗑️</button>
            </div>` : ""}
        </div>
    </div>
    `;
    body.insertAdjacentHTML("beforeend", html);
    body.scrollTop = body.scrollHeight;
});

// Send düyməsi
sendBtn.onclick = sendMessage;

// Enter ilə göndərmə
input.addEventListener("keypress", function(e){
    if(e.key === "Enter") sendMessage();
});

// Mesaj göndərmə funksiyası
function sendMessage(){
    if(!isAuthenticated){
        window.location.href = "/Account/Login";
        return;
    }

    let text = input.value.trim();
    if(!text) return;

    fetch("/api/chat/send", {
        method: "POST",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify({message:text})
    });

    input.value="";
}

// Silmə
function deleteMessage(id){
    let el = document.getElementById("msg-"+id);
    el.classList.add("removing");

    setTimeout(()=>{
        fetch(`/api/chat/delete/${id}`, {method:"POST"});
    },300);
}

connection.on("DeleteMessage", id=>{
    document.getElementById("msg-"+id)?.remove();
});

// Redaktə
function editMessage(id){
    let msg = document.getElementById("msg-"+id);
    if(msg.classList.contains("editing")) return;
    msg.classList.add("editing");

    let textSpan = msg.querySelector(".text");
    let oldText = textSpan.innerText;

    textSpan.innerHTML = `<input class="edit-input" value="${oldText}">`;
    let inputEdit = textSpan.querySelector("input");
    inputEdit.focus();

    inputEdit.addEventListener("keydown", function(e){
        if(e.key === "Enter"){
            fetch("/api/chat/edit",{
                method:"POST",
                headers:{"Content-Type":"application/json"},
                body:JSON.stringify({id:id,message:inputEdit.value})
            });
            msg.classList.remove("editing");
        }
        if(e.key === "Escape"){
            textSpan.innerText = oldText;
            msg.classList.remove("editing");
        }
    });
}

connection.on("EditMessage", (id,message)=>{
    let msg=document.getElementById("msg-"+id);
    let span=msg.querySelector(".text");
    if(span) span.innerText=message;
});
</script>
<div class="container-xxl py-5">
    <div class="container">

        <div class="text-center mb-4">
            <h6 class="text-primary text-uppercase">Bizimlə Əlaqə</h6>
            <h1>İstənilən sual üçün əlaqə saxlayın</h1>
        </div>

        <div class="row g-4">

            <!-- CONTACT INFO -->
            <div class="col-md-4">
                <div class="bg-light p-4">
                    <h5>Ünvan</h5>
                    <p>@Model.Contact?.Address</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="bg-light p-4">
                    <h5>Telefon</h5>
                    <p>@Model.Contact?.Phone</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="bg-light p-4">
                    <h5>Email</h5>
                    <p>@Model.Contact?.Email</p>
                </div>
            </div>

            <!-- MAP -->
            <div class="col-md-6">
                @if (Model.Map != null)
                {
                    <iframe class="w-100" style="height:250px"
                            src="@Model.Map.MapUrl"></iframe>
                }
            </div>

            <!-- FORM -->
            <div class="col-md-6">
                <form asp-action="SendMessage" method="post">

                    <input asp-for="Message.FullName" class="form-control mb-2" placeholder="Ad Soyad" />
                    <input asp-for="Message.Email" class="form-control mb-2" placeholder="Email" />
                    <input asp-for="Message.Subject" class="form-control mb-2" placeholder="Mövzu" />
                    <textarea asp-for="Message.Message" class="form-control mb-2"></textarea>

                    <button class="btn btn-primary w-100">Göndər</button>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-2">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                </form>
            </div>

        </div>
    </div>
</div>