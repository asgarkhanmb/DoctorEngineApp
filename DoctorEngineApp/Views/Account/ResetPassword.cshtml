@model DoctorEngineApp.ViewModels.Accounts.ResetPasswordVM

@{
    Layout = null;
    ViewData["Title"] = "Reset Password";
}

<link rel="stylesheet" href="~/css/auth.css" />

<body>

    <div class="background">
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <form asp-action="ResetPassword" asp-controller="Account" method="post">

        @Html.AntiForgeryToken()

        <h3>Yeni Şifrə</h3>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />

        <label>Yeni Şifrə</label>
        <input asp-for="Password" type="password" placeholder="Yeni şifrə daxil edin" />
        <span asp-validation-for="Password" class="text-danger"></span>

        <label>Şifrəni Təkrar Daxil Et</label>
        <input asp-for="ConfirmPassword" type="password" placeholder="Şifrəni yenidən yazın" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

        <button type="submit">Şifrəni Dəyiş</button>

        <div style="margin-top:15px;">
            <a asp-action="Login" asp-controller="Account">Giriş səhifəsinə qayıt</a>
        </div>

    </form>

</body>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}