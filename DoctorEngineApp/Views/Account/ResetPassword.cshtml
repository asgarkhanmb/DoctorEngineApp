@model DoctorEngineApp.ViewModels.Accounts.ResetPasswordVM

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Yeni şifrə";
}

<div class="auth-head">
    <div class="auth-head__icon"><i class="fa-solid fa-shield-halved"></i></div>
    <h1>@L.T("Yeni şifrə təyin edin")</h1>
    <p>@L.T("Hesabınız üçün yeni, güclü şifrə yaradın.")</p>
</div>

<form asp-action="ResetPassword" asp-controller="Account" method="post"
      class="auth-form" novalidate data-loading-text="@L.T("Yadda saxlanılır…")">

    <div asp-validation-summary="ModelOnly" role="alert"></div>

    <input asp-for="Email" type="hidden" />
    <input asp-for="Token" type="hidden" />

    <div class="auth-field">
        <label asp-for="Password">@L.T("Yeni şifrə")</label>
        <div class="auth-input auth-input--password">
            <i class="fa-solid fa-lock"></i>
            <input asp-for="Password" autocomplete="new-password" autofocus placeholder="@L.T("Yeni şifrə")" />
            <button type="button" class="auth-eye" data-toggle-password="Password" aria-label="@L.T("Şifrəni göstər")" aria-pressed="false">
                <i class="fa-regular fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password"></span>
        <small class="auth-caps" data-caps-for="Password"><i class="fa-solid fa-triangle-exclamation"></i> @L.T("Caps Lock açıqdır")</small>

        <div class="auth-meter" data-meter-for="Password" data-level="0" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
        </div>
        <ul class="auth-rules" data-password-rules="Password" aria-label="@L.T("Şifrə tələbləri")">
            <li data-rule="length">@L.T("Minimum 6 simvol")</li>
            <li data-rule="upper">@L.T("Böyük hərf (A–Z)")</li>
            <li data-rule="lower">@L.T("Kiçik hərf (a–z)")</li>
            <li data-rule="digit">@L.T("Rəqəm (0–9)")</li>
            <li data-rule="symbol">@L.T("Xüsusi simvol (! @ # $)")</li>
        </ul>
    </div>

    <div class="auth-field">
        <label asp-for="ConfirmPassword">@L.T("Şifrə təkrarı")</label>
        <div class="auth-input auth-input--password">
            <i class="fa-solid fa-lock"></i>
            <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="@L.T("Şifrəni təkrar yazın")" />
            <button type="button" class="auth-eye" data-toggle-password="ConfirmPassword" aria-label="@L.T("Şifrəni göstər")" aria-pressed="false">
                <i class="fa-regular fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword"></span>
        <small class="auth-match" data-match-for="ConfirmPassword" data-match-with="Password"><i></i><span></span></small>
    </div>

    <button type="submit" class="auth-btn">
        @L.T("Şifrəni yenilə") <i class="fa-solid fa-check"></i>
    </button>
</form>

<div class="auth-switch">
    <a asp-action="Login" asp-controller="Account"><i class="fa-solid fa-arrow-left"></i> @L.T("Girişə qayıt")</a>
</div>
