@model DoctorEngineApp.ViewModels.Accounts.ResetPasswordVM

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Yeni şifrə";
}

<div class="auth-head">
    <div class="auth-head__icon"><i class="fa-solid fa-shield-halved"></i></div>
    <h1>Yeni şifrə təyin edin</h1>
    <p>Hesabınız üçün yeni, güclü şifrə yaradın.</p>
</div>

<form asp-action="ResetPassword" asp-controller="Account" method="post"
      class="auth-form" novalidate data-loading-text="Yadda saxlanılır…">

    <div asp-validation-summary="ModelOnly" role="alert"></div>

    <input asp-for="Email" type="hidden" />
    <input asp-for="Token" type="hidden" />

    <div class="auth-field">
        <label asp-for="Password">Yeni şifrə</label>
        <div class="auth-input auth-input--password">
            <i class="fa-solid fa-lock"></i>
            <input asp-for="Password" autocomplete="new-password" autofocus placeholder="Yeni şifrə" />
            <button type="button" class="auth-eye" data-toggle-password="Password" aria-label="Şifrəni göstər" aria-pressed="false">
                <i class="fa-regular fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password"></span>
        <small class="auth-caps" data-caps-for="Password"><i class="fa-solid fa-triangle-exclamation"></i> Caps Lock açıqdır</small>

        <div class="auth-meter" data-meter-for="Password" data-level="0" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
        </div>
        <ul class="auth-rules" data-password-rules="Password" aria-label="Şifrə tələbləri">
            <li data-rule="length">Minimum 6 simvol</li>
            <li data-rule="upper">Böyük hərf (A–Z)</li>
            <li data-rule="lower">Kiçik hərf (a–z)</li>
            <li data-rule="digit">Rəqəm (0–9)</li>
            <li data-rule="symbol">Xüsusi simvol (! @@ # $)</li>
        </ul>
    </div>

    <div class="auth-field">
        <label asp-for="ConfirmPassword">Şifrə təkrarı</label>
        <div class="auth-input auth-input--password">
            <i class="fa-solid fa-lock"></i>
            <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Şifrəni təkrar yazın" />
            <button type="button" class="auth-eye" data-toggle-password="ConfirmPassword" aria-label="Şifrəni göstər" aria-pressed="false">
                <i class="fa-regular fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword"></span>
        <small class="auth-match" data-match-for="ConfirmPassword" data-match-with="Password"><i></i><span></span></small>
    </div>

    <button type="submit" class="auth-btn">
        Şifrəni yenilə <i class="fa-solid fa-check"></i>
    </button>
</form>

<div class="auth-switch">
    <a asp-action="Login" asp-controller="Account"><i class="fa-solid fa-arrow-left"></i> Girişə qayıt</a>
</div>
