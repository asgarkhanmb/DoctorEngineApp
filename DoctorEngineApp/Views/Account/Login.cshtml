@model DoctorEngineApp.ViewModels.Accounts.LoginVM

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="~/css/auth.css" />

<body>
    <div class="background">
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <form asp-action="Login" asp-controller="Account" method="post" novalidate>
        @Html.AntiForgeryToken()

        <h3>Giriş</h3>

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="background:#d4edda;padding:10px;border-radius:5px;color:#155724;margin-bottom:10px;">
                @TempData["SuccessMessage"]
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <label for="EmailOrUsername">İstifadəçi</label>
        <input asp-for="EmailOrUsername" id="EmailOrUsername" placeholder="E-poçt və ya istifadəçi adı" />
        <span asp-validation-for="EmailOrUsername" class="text-danger"></span>

        <label for="loginPassword">Parol</label>
        <input asp-for="Password" type="password" id="loginPassword" placeholder="Şifrə" />
        <span asp-validation-for="Password" class="text-danger"></span>

        <button type="submit">Daxil Ol</button>

        <div style="margin-top:10px;">
            <a asp-action="ForgotPassword" asp-controller="Account">Şifrəni unutdum?</a>
        </div>

        <div>
            <br />
            Hesabın yoxdur?
            <a asp-action="Register" asp-controller="Account">Qeydiyyat</a>
        </div>

        <br />

        <div>
            <a asp-controller="Home" asp-action="Index">Ana Səhifə</a>
        </div>

    </form>
</body>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}