@model DoctorEngineApp.ViewModels.Accounts.ForgotPasswordVM

@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<link rel="stylesheet" href="~/css/forgot.css" />

<body>
    <form asp-action="ForgotPassword" asp-controller="Account" method="post" novalidate>
        @Html.AntiForgeryToken()

        <h3>Şifrəni Yenilə</h3>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <label>Email</label>
        <input asp-for="Email" placeholder="E-poçt adresinizi daxil edin" />
        <span asp-validation-for="Email" class="text-danger"></span>

        <button type="submit">Göndər</button>

        <div class="footer">
            <a asp-controller="Account" asp-action="Login">
                Daxil Ol
            </a>
        </div>

        <div class="footer">
            <a asp-controller="Home" asp-action="Index">
                Ana Səhifə
            </a>
        </div>
    </form>
</body>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}