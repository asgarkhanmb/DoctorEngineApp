@model DoctorEngineApp.ViewModels.Accounts.ForgotPasswordVM

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Şifrəni unutmusunuz";
}

<div class="auth-head">
    <div class="auth-head__icon"><i class="fa-solid fa-key"></i></div>
    <h1>@L.T("Şifrəni unutmusunuz?")</h1>
    <p>@L.T("Qeydiyyatdan keçdiyiniz email ünvanını yazın — şifrəni yeniləmək üçün link göndərəcəyik.")</p>
</div>

<form asp-action="ForgotPassword" asp-controller="Account" method="post"
      class="auth-form" novalidate data-loading-text="@L.T("Göndərilir…")">

    <div asp-validation-summary="ModelOnly" role="alert"></div>

    <div class="auth-field">
        <label asp-for="Email">Email</label>
        <div class="auth-input">
            <i class="fa-regular fa-envelope"></i>
            <input asp-for="Email" type="email" autocomplete="off" autofocus placeholder="@L.T("ad@numune.az")" />
        </div>
        <span asp-validation-for="Email"></span>
    </div>

    <button type="submit" class="auth-btn">
        @L.T("Link göndər") <i class="fa-regular fa-paper-plane"></i>
    </button>
</form>

<div class="auth-switch">
    <a asp-action="Login" asp-controller="Account"><i class="fa-solid fa-arrow-left"></i> @L.T("Girişə qayıt")</a>
</div>
