@model DoctorEngineApp.ViewModels.Accounts.ProfileVM

@{
    ViewData["Title"] = "Hesab ayarları";
    var success = TempData["ProfileSuccess"] as string;
    var error = TempData["ProfileError"] as string;
    var initial = string.IsNullOrWhiteSpace(Model.Info.FullName) ? "?" : Model.Info.FullName.Trim().Substring(0, 1).ToUpper();
    var hasImage = !string.IsNullOrEmpty(Model.ProfileImage);

    // Forma xəta ilə geri qayıdıbsa, həmin bölmə açıq qalsın
    string serverTab = "";
    if (ViewData.ModelState.Keys.Any(k => k.StartsWith("Email.") && ViewData.ModelState[k]!.Errors.Count > 0)) serverTab = "email";
    else if (ViewData.ModelState.Keys.Any(k => k.StartsWith("Password.") && ViewData.ModelState[k]!.Errors.Count > 0)) serverTab = "password";
    else if (ViewData.ModelState.Keys.Any(k => k.StartsWith("Info.") && ViewData.ModelState[k]!.Errors.Count > 0)) serverTab = "profile";
}

@section css {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<partial name="_PageHeader" model='("Hesab ayarları", "Profil məlumatlarınızı, email ünvanınızı və şifrənizi idarə edin.")' />

<div class="container py-5">
    <div class="ds" data-server-tab="@serverTab">

        <!-- ================= SOL MENYU ================= -->
        <aside class="ds-side">
            <div class="ds-user">
                @if (hasImage)
                {
                    <img class="ds-avatar" src="~/uploads/avatars/@Model.ProfileImage" alt="" />
                }
                else
                {
                    <span class="ds-avatar" aria-hidden="true">@initial</span>
                }
                <div class="ds-user__text">
                    <strong>@Model.Info.FullName</strong>
                    <small>@@@Model.Info.UserName</small>
                </div>
            </div>

            <nav class="ds-nav" role="tablist" aria-label="@L.T("Ayarlar bölmələri")">
                <button type="button" class="ds-nav__item" role="tab" id="tab-profile" data-tab="profile" aria-controls="panel-profile" aria-selected="true">
                    <i class="fa-regular fa-user"></i>
                    <span><b>@L.T("Profil")</b><small>@L.T("Şəkil, ad, istifadəçi adı")</small></span>
                </button>
                <button type="button" class="ds-nav__item" role="tab" id="tab-email" data-tab="email" aria-controls="panel-email" aria-selected="false">
                    <i class="fa-regular fa-envelope"></i>
                    <span><b>Email</b><small>@L.T("Email ünvanının dəyişdirilməsi")</small></span>
                </button>
                <button type="button" class="ds-nav__item" role="tab" id="tab-password" data-tab="password" aria-controls="panel-password" aria-selected="false">
                    <i class="fa-solid fa-shield-halved"></i>
                    <span><b>@L.T("Təhlükəsizlik")</b><small>@L.T("Şifrənin dəyişdirilməsi")</small></span>
                </button>
            </nav>

            <form asp-action="Logout" asp-controller="Account" method="post" class="ds-logout">
                <button type="submit" class="ds-nav__item is-danger">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    <span><b>@L.T("Çıxış")</b></span>
                </button>
            </form>
        </aside>

        <!-- ================= SAĞ TƏRƏF ================= -->
        <main class="ds-main">

            @if (!string.IsNullOrEmpty(success))
            {
                <div class="ds-alert is-ok" role="status">
                    <i class="fa-solid fa-circle-check"></i><span>@success</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="ds-alert is-error" role="alert">
                    <i class="fa-solid fa-triangle-exclamation"></i><span>@error</span>
                </div>
            }

            <!-- ---------- PROFİL ---------- -->
            <section class="ds-panel" id="panel-profile" role="tabpanel" aria-labelledby="tab-profile">
                <header class="ds-panel__head">
                    <h2>@L.T("Profil")</h2>
                    <p>@L.T("Bu məlumatlar çatda və hesabınızda göstərilir.")</p>
                </header>

                <!-- Şəkil -->
                <div class="ds-row">
                    <div class="ds-row__label">
                        <h3>@L.T("Profil şəkli")</h3>
                        <p>@L.T("JPG, PNG və ya WEBP, maksimum 5 MB.")</p>
                    </div>
                    <div class="ds-row__control">
                        <div class="ds-photo">
                            @if (hasImage)
                            {
                                <img class="ds-avatar ds-avatar--lg" src="~/uploads/avatars/@Model.ProfileImage" alt="@L.T("Profil şəkli")" />
                            }
                            else
                            {
                                <span class="ds-avatar ds-avatar--lg" aria-hidden="true">@initial</span>
                            }

                            <div class="ds-photo__actions">
                                <form asp-action="UploadAvatar" asp-controller="Account" method="post" enctype="multipart/form-data" id="avatarForm">
                                    <label class="ds-btn ds-btn--primary" for="avatarInput">
                                        <i class="fa-solid fa-camera"></i> @(hasImage ? L.T("Şəkli dəyiş") : L.T("Şəkil yüklə"))
                                    </label>
                                    <input type="file" name="photo" id="avatarInput" accept=".jpg,.jpeg,.png,.webp" class="visually-hidden" />
                                </form>
                                @if (hasImage)
                                {
                                    <form asp-action="RemoveAvatar" asp-controller="Account" method="post">
                                        <button type="submit" class="ds-btn ds-btn--ghost">
                                            <i class="fa-regular fa-trash-can"></i> @L.T("Sil")
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Ad və istifadəçi adı -->
                <form asp-action="UpdateProfile" asp-controller="Account" method="post" novalidate>
                    <div class="ds-row">
                        <div class="ds-row__label">
                            <h3><label asp-for="Info.FullName"></label></h3>
                            <p>@L.T("Tam adınız.")</p>
                        </div>
                        <div class="ds-row__control">
                            <div class="ds-input">
                                <i class="fa-regular fa-id-card"></i>
                                <input asp-for="Info.FullName" autocomplete="name" />
                            </div>
                            <span asp-validation-for="Info.FullName" class="ds-error"></span>
                        </div>
                    </div>

                    <div class="ds-row">
                        <div class="ds-row__label">
                            <h3><label asp-for="Info.UserName"></label></h3>
                            <p>@L.T("Latın hərfləri, rəqəm və . _ - (3–30 simvol).")</p>
                        </div>
                        <div class="ds-row__control">
                            <div class="ds-input">
                                <i class="fa-solid fa-at"></i>
                                <input asp-for="Info.UserName" autocomplete="username" />
                            </div>
                            <span asp-validation-for="Info.UserName" class="ds-error"></span>
                        </div>
                    </div>

                    <footer class="ds-panel__foot">
                        <button type="submit" class="ds-btn ds-btn--primary">
                            <i class="fa-solid fa-floppy-disk"></i> @L.T("Yadda saxla")
                        </button>
                    </footer>
                </form>
            </section>

            <!-- ---------- EMAIL ---------- -->
            <section class="ds-panel" id="panel-email" role="tabpanel" aria-labelledby="tab-email" hidden>
                <header class="ds-panel__head">
                    <h2>@L.T("Email ünvanı")</h2>
                    <p>@L.T("Yeni ünvana təsdiq linki göndəriləcək. Email yalnız linkə klik etdikdən sonra dəyişəcək.")</p>
                </header>

                <div class="ds-row">
                    <div class="ds-row__label">
                        <h3>@L.T("Hazırkı email")</h3>
                        <p>@L.T("Giriş və bildirişlər üçün.")</p>
                    </div>
                    <div class="ds-row__control">
                        <div class="ds-current">
                            <i class="fa-regular fa-envelope"></i>
                            <span>@Model.CurrentEmail</span>
                            <em class="ds-badge"><i class="fa-solid fa-check"></i> @L.T("Təsdiqlənib")</em>
                        </div>
                    </div>
                </div>

                <form asp-action="ChangeEmail" asp-controller="Account" method="post" novalidate>
                    <div class="ds-row">
                        <div class="ds-row__label">
                            <h3><label asp-for="Email.NewEmail"></label></h3>
                            <p>@L.T("Təsdiq linki bu ünvana gələcək.")</p>
                        </div>
                        <div class="ds-row__control">
                            <div class="ds-input">
                                <i class="fa-regular fa-envelope"></i>
                                <input asp-for="Email.NewEmail" type="email" autocomplete="email" placeholder="@L.T("yeni@email.com")" />
                            </div>
                            <span asp-validation-for="Email.NewEmail" class="ds-error"></span>
                        </div>
                    </div>

                    <div class="ds-row">
                        <div class="ds-row__label">
                            <h3><label asp-for="Email.CurrentPassword"></label></h3>
                            <p>@L.T("Təhlükəsizlik üçün şifrənizi təsdiqləyin.")</p>
                        </div>
                        <div class="ds-row__control">
                            <div class="ds-input ds-input--password">
                                <i class="fa-solid fa-lock"></i>
                                <input asp-for="Email.CurrentPassword" autocomplete="current-password" />
                                <button type="button" class="ds-eye" aria-label="@L.T("Şifrəni göstər")"><i class="fa-regular fa-eye"></i></button>
                            </div>
                            <span asp-validation-for="Email.CurrentPassword" class="ds-error"></span>
                        </div>
                    </div>

                    <footer class="ds-panel__foot">
                        <button type="submit" class="ds-btn ds-btn--primary">
                            <i class="fa-regular fa-paper-plane"></i> @L.T("Təsdiq linki göndər")
                        </button>
                    </footer>
                </form>
            </section>

            <!-- ---------- ŞİFRƏ ---------- -->
            <section class="ds-panel" id="panel-password" role="tabpanel" aria-labelledby="tab-password" hidden>
                <header class="ds-panel__head">
                    <h2>@L.T("Təhlükəsizlik")</h2>
                    <p>@L.T("Güclü şifrə: böyük və kiçik hərf, rəqəm və xüsusi simvol.")</p>
                </header>

                <form asp-action="ChangePassword" asp-controller="Account" method="post" novalidate>
                    <div class="ds-row">
                        <div class="ds-row__label">
                            <h3><label asp-for="Password.CurrentPassword"></label></h3>
                            <p>@L.T("İndi istifadə etdiyiniz şifrə.")</p>
                        </div>
                        <div class="ds-row__control">
                            <div class="ds-input ds-input--password">
                                <i class="fa-solid fa-lock"></i>
                                <input asp-for="Password.CurrentPassword" autocomplete="current-password" />
                                <button type="button" class="ds-eye" aria-label="@L.T("Şifrəni göstər")"><i class="fa-regular fa-eye"></i></button>
                            </div>
                            <span asp-validation-for="Password.CurrentPassword" class="ds-error"></span>
                        </div>
                    </div>

                    <div class="ds-row">
                        <div class="ds-row__label">
                            <h3><label asp-for="Password.NewPassword"></label></h3>
                            <p>@L.T("Minimum 6 simvol.")</p>
                        </div>
                        <div class="ds-row__control">
                            <div class="ds-input ds-input--password">
                                <i class="fa-solid fa-key"></i>
                                <input asp-for="Password.NewPassword" autocomplete="new-password" />
                                <button type="button" class="ds-eye" aria-label="@L.T("Şifrəni göstər")"><i class="fa-regular fa-eye"></i></button>
                            </div>
                            <span asp-validation-for="Password.NewPassword" class="ds-error"></span>
                            <ul class="ds-rules" id="pwRules" aria-label="@L.T("Şifrə tələbləri")">
                                <li data-rule="length">@L.T("6+ simvol")</li>
                                <li data-rule="upper">A–Z</li>
                                <li data-rule="lower">a–z</li>
                                <li data-rule="digit">0–9</li>
                                <li data-rule="symbol">! @@ # $</li>
                            </ul>
                        </div>
                    </div>

                    <div class="ds-row">
                        <div class="ds-row__label">
                            <h3><label asp-for="Password.ConfirmPassword"></label></h3>
                            <p>@L.T("Yeni şifrəni təkrar yazın.")</p>
                        </div>
                        <div class="ds-row__control">
                            <div class="ds-input ds-input--password">
                                <i class="fa-solid fa-key"></i>
                                <input asp-for="Password.ConfirmPassword" autocomplete="new-password" />
                                <button type="button" class="ds-eye" aria-label="@L.T("Şifrəni göstər")"><i class="fa-regular fa-eye"></i></button>
                            </div>
                            <span asp-validation-for="Password.ConfirmPassword" class="ds-error"></span>
                        </div>
                    </div>

                    <footer class="ds-panel__foot">
                        <button type="submit" class="ds-btn ds-btn--primary">
                            <i class="fa-solid fa-check"></i> @L.T("Şifrəni yenilə")
                        </button>
                    </footer>
                </form>
            </section>

        </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var root = document.querySelector('.ds');
            if (!root) return;
            var tabs = root.querySelectorAll('[data-tab]');
            var valid = ['profile', 'email', 'password'];

            function show(name, updateHash) {
                if (valid.indexOf(name) < 0) name = 'profile';
                tabs.forEach(function (t) {
                    var on = t.getAttribute('data-tab') === name;
                    t.classList.toggle('is-active', on);
                    t.setAttribute('aria-selected', on ? 'true' : 'false');
                    document.getElementById('panel-' + t.getAttribute('data-tab')).hidden = !on;
                });
                if (updateHash && history.replaceState) history.replaceState(null, '', '#' + name);
            }

            tabs.forEach(function (t) {
                t.addEventListener('click', function () { show(t.getAttribute('data-tab'), true); });
            });

            // Xəta olan forma > URL-dəki #bölmə > Profil
            show(root.getAttribute('data-server-tab') || location.hash.replace('#', ''), false);

            // Şifrəni göstər / gizlət
            root.querySelectorAll('.ds-eye').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = btn.parentElement.querySelector('input');
                    var hidden = input.type === 'password';
                    input.type = hidden ? 'text' : 'password';
                    btn.querySelector('i').className = hidden ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
                    btn.setAttribute('aria-label', hidden ? deT('Şifrəni gizlət') : deT('Şifrəni göstər'));
                });
            });

            // Şifrə tələbləri canlı yoxlanılır
            var pw = document.getElementById('Password_NewPassword');
            var rules = document.getElementById('pwRules');
            if (pw && rules) {
                var tests = {
                    length: function (v) { return v.length >= 6; },
                    upper: function (v) { return /[A-Z]/.test(v); },
                    lower: function (v) { return /[a-z]/.test(v); },
                    digit: function (v) { return /[0-9]/.test(v); },
                    symbol: function (v) { return /[^A-Za-z0-9]/.test(v); }
                };
                pw.addEventListener('input', function () {
                    rules.querySelectorAll('[data-rule]').forEach(function (li) {
                        li.classList.toggle('is-ok', tests[li.getAttribute('data-rule')](pw.value));
                    });
                });
            }

            // Profil şəkli: seçilən kimi yüklənir
            var input = document.getElementById('avatarInput');
            if (input) {
                input.addEventListener('change', function () {
                    var file = input.files && input.files[0];
                    if (!file) return;
                    if (file.size > 5 * 1024 * 1024) {
                        if (window.deUI) window.deUI.toast(deT('Şəkil ölçüsü maksimum 5 MB ola bilər.'), 'error');
                        input.value = '';
                        return;
                    }
                    document.getElementById('avatarForm').submit();
                });
            }
        })();
    </script>
}
