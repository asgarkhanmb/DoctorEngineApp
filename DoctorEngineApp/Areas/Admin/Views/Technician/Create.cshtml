@model TechnicianCreateVM

<div class="container mt-4">
    <h2>Add Technician</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Position</label>
            <input asp-for="Position" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Photo</label>
            <input asp-for="Photo" type="file" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Facebook</label>
            <input asp-for="FacebookUrl" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Instagram</label>
            <input asp-for="InstagramUrl" class="form-control" />
        </div>

        <div class="mb-3">
            <label>TikTok</label>
            <input asp-for="TiktokUrl" class="form-control" />
        </div>

        <button class="btn btn-success">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>
