@model TechnicianCreateVM
@{ ViewData["Title"] = "Yeni usta"; }

<partial name="_PageHead" model='new AdminPageHead("Yeni usta", BackAction: "Index")' />

<div class="adm-card" style="max-width:820px">
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="adm-form">
        <div class="adm-card__body">
            
            <div asp-validation-summary="ModelOnly"></div>

            <div class="adm-form-section">
                <h3>Əsas məlumat</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label">Ad Soyad</label>
                        <input asp-for="FullName" class="form-control" placeholder="Məs: Elton Əlizadə" />
                        <span asp-validation-for="FullName"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Position" class="form-label">Vəzifə</label>
                        <input asp-for="Position" class="form-control" placeholder="Məs: Mühərrik ustası" />
                        <span asp-validation-for="Position"></span>
                    </div>
                </div>
            </div>

            <div class="adm-form-section">
                <h3>Şəkil</h3>
                <div class="adm-upload">
                    <div class="adm-upload__preview" id="photoPreview" style=""><i class="fa-regular fa-user"></i></div>
                    <div class="adm-upload__body">
                        <label asp-for="Photo" class="form-label">Foto *</label>
                        <input asp-for="Photo" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" data-preview="#photoPreview" />
                        <div class="form-text">Şaquli portret tövsiyə olunur (məs: 600×800).</div>
                        <span asp-validation-for="Photo"></span>
                    </div>
                </div>
            </div>

            <div class="adm-form-section">
                <h3>Sosial şəbəkələr <small class="text-muted text-lowercase">(ixtiyari)</small></h3>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="FacebookUrl" class="form-label"><i class="fa-brands fa-facebook me-1"></i> Facebook</label>
                        <input asp-for="FacebookUrl" type="url" class="form-control" placeholder="https://facebook.com/…" />
                        <span asp-validation-for="FacebookUrl"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="InstagramUrl" class="form-label"><i class="fa-brands fa-instagram me-1"></i> Instagram</label>
                        <input asp-for="InstagramUrl" type="url" class="form-control" placeholder="https://instagram.com/…" />
                        <span asp-validation-for="InstagramUrl"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="TiktokUrl" class="form-label"><i class="fa-brands fa-tiktok me-1"></i> TikTok</label>
                        <input asp-for="TiktokUrl" type="url" class="form-control" placeholder="https://tiktok.com/@@…" />
                        <span asp-validation-for="TiktokUrl"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="adm-form-actions">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i> Əlavə et</button>
            <a asp-action="Index" class="btn btn-light">Ləğv et</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
