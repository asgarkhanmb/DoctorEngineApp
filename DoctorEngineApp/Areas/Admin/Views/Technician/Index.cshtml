@model List<Technician>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Technicians</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add Technician</a>
    </div>

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Image</th>
                <th>Full Name</th>
                <th>Position</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>
                        <img src="~/uploads/technicians/@t.Image"
                             width="80" height="80"
                             style="object-fit:cover;border-radius:8px;" />
                    </td>
                    <td>@t.FullName</td>
                    <td>@t.Position</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@t.Id"
                           onclick="return confirm('Are you sure?')"
                           class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
