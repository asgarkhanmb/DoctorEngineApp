@using Microsoft.EntityFrameworkCore
@inject DoctorEngineApp.Data.AppDbContext Db
@inject DoctorEngineApp.Services.Interfaces.ISiteSettingService SiteSettings
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var userName = User.Identity?.Name ?? "Admin";
    var site = await SiteSettings.GetAsync();
    var pendingReservations = await Db.Reservations.CountAsync(r => r.Status == "Pending");
    var weekAgo = DateTime.Now.Date.AddDays(-7);
    var newMessages = await Db.ContactMessages.CountAsync(m => m.CreatedDate >= weekAgo);

    string Active(params string[] names) =>
        names.Any(n => string.Equals(n, controller, StringComparison.OrdinalIgnoreCase)) ? "is-active" : "";
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0B2154" />
    <title>@ViewData["Title"] — Admin | @site.SiteName</title>

    <link rel="icon" href="~/assets/img/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@600;700&family=Ubuntu:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/v4-shims.min.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/video-frame.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="adm">

    <!-- ================= SOL MENYU ================= -->
    <aside class="adm-sidebar" id="admSidebar" aria-label="Admin menyusu">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="adm-brand">
            <span class="adm-brand__icon"><partial name="_BrandIcon" model="site" /></span>
            <span>
                @site.SiteName
                <small>İdarəetmə paneli</small>
            </span>
        </a>

        <nav class="adm-nav">
            <div class="adm-nav__label">Ümumi</div>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="adm-nav__link @Active("Dashboard")">
                <i class="fa-solid fa-gauge-high"></i> İdarə paneli
            </a>
            <a asp-area="Admin" asp-controller="Reservation" asp-action="Index" class="adm-nav__link @Active("Reservation")">
                <i class="fa-regular fa-calendar-check"></i> Rezervasiyalar
                @if (pendingReservations > 0)
                {
                    <span class="adm-nav__badge" title="Gözləyən rezervasiyalar">@pendingReservations</span>
                }
            </a>
            <a asp-area="Admin" asp-controller="ContactMessage" asp-action="Index" class="adm-nav__link @Active("ContactMessage")">
                <i class="fa-regular fa-envelope"></i> Əlaqə mesajları
                @if (newMessages > 0)
                {
                    <span class="adm-nav__badge is-muted" title="Son 7 gündə">@newMessages</span>
                }
            </a>
            <a asp-area="" asp-controller="Chat" asp-action="Index" class="adm-nav__link" target="_blank" rel="noopener">
                <i class="fa-regular fa-comments"></i> Canlı çat <i class="fa-solid fa-arrow-up-right-from-square adm-nav__ext"></i>
            </a>
            <a asp-area="Admin" asp-controller="Warranty" asp-action="Index" class="adm-nav__link @Active("Warranty")">
                <i class="fa-solid fa-shield-halved"></i> Zəmanətlər
            </a>

            <div class="adm-nav__label">Sayt məzmunu</div>
            <a asp-area="Admin" asp-controller="Slider" asp-action="Index" class="adm-nav__link @Active("Slider")">
                <i class="fa-regular fa-images"></i> Slayder
            </a>
            <a asp-area="Admin" asp-controller="Inform" asp-action="Index" class="adm-nav__link @Active("Inform")">
                <i class="fa-regular fa-star"></i> Üstünlüklər
            </a>
            <a asp-area="Admin" asp-controller="About" asp-action="Index" class="adm-nav__link @Active("About")">
                <i class="fa-regular fa-address-card"></i> Haqqımızda
            </a>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="adm-nav__link @Active("Category")">
                <i class="fa-solid fa-layer-group"></i> Kateqoriyalar
            </a>
            <a asp-area="Admin" asp-controller="SubService" asp-action="Index" class="adm-nav__link @Active("SubService")">
                <i class="fa-solid fa-film"></i> Kateqoriya videoları
            </a>
            <a asp-area="Admin" asp-controller="Service" asp-action="Index" class="adm-nav__link @Active("Service")">
                <i class="fa-solid fa-screwdriver-wrench"></i> Rezervasiya xidmətləri
            </a>
            <a asp-area="Admin" asp-controller="Technician" asp-action="Index" class="adm-nav__link @Active("Technician")">
                <i class="fa-solid fa-user-gear"></i> Ustalar
            </a>

            <div class="adm-nav__label">Əlaqə ayarları</div>
            <a asp-area="Admin" asp-controller="Contact" asp-action="Edit" class="adm-nav__link @Active("Contact")">
                <i class="fa-solid fa-address-book"></i> Əlaqə məlumatları
            </a>
            <a asp-area="Admin" asp-controller="ContactPhone" asp-action="Index" class="adm-nav__link @Active("ContactPhone")">
                <i class="fa-solid fa-phone"></i> Telefon bloku
            </a>
            <a asp-area="Admin" asp-controller="Map" asp-action="Index" class="adm-nav__link @Active("Map")">
                <i class="fa-solid fa-map-location-dot"></i> Xəritə
            </a>
            <a asp-area="Admin" asp-controller="WhatsApp" asp-action="Index" class="adm-nav__link @Active("WhatsApp")">
                <i class="fa-brands fa-whatsapp"></i> WhatsApp düyməsi
            </a>

            <div class="adm-nav__label">Sistem</div>
            <a asp-area="Admin" asp-controller="SiteSetting" asp-action="Index" class="adm-nav__link @Active("SiteSetting")">
                <i class="fa-solid fa-sliders"></i> Sayt ayarları
            </a>
            <a asp-area="Admin" asp-controller="User" asp-action="Index" class="adm-nav__link @Active("User")">
                <i class="fa-solid fa-users"></i> İstifadəçilər
            </a>
        </nav>

        <a asp-area="" asp-controller="Home" asp-action="Index" class="adm-sidebar__site" target="_blank" rel="noopener">
            <i class="fa-solid fa-globe"></i> Sayta bax
        </a>
    </aside>

    <div class="adm-backdrop" data-adm-close></div>

    <!-- ================= ƏSAS HİSSƏ ================= -->
    <div class="adm-main">
        <header class="adm-topbar">
            <button type="button" class="adm-icon-btn adm-menu-btn" data-adm-toggle aria-label="Menyunu aç" aria-controls="admSidebar">
                <i class="fa-solid fa-bars"></i>
            </button>

            <div class="adm-topbar__title">@ViewData["Title"]</div>

            <div class="adm-topbar__right">
                <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener" class="btn btn-light btn-sm d-none d-md-inline-flex align-items-center gap-2">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Sayt
                </a>

                <div class="dropdown">
                    <button class="adm-user" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="adm-user__avatar">@userName.Substring(0, 1).ToUpper()</span>
                        <span class="adm-user__name d-none d-sm-inline">@userName</span>
                        <i class="fa-solid fa-chevron-down small text-muted"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li class="px-3 py-2">
                            <strong class="d-block">@userName</strong>
                            <small class="text-muted">Administrator</small>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-2"></i> Ana səhifə</a></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Çıxış</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="adm-content">
            @RenderBody()
        </main>
    </div>

    <!-- ================= BİLDİRİŞLƏR ================= -->
    <div class="adm-toasts" aria-live="polite">
        @if (TempData["Success"] is string ok)
        {
            <div class="adm-toast is-success" role="status"><i class="fa-solid fa-circle-check"></i><span>@ok</span><button type="button" aria-label="Bağla" data-toast-close>&times;</button></div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="adm-toast is-error" role="alert"><i class="fa-solid fa-circle-exclamation"></i><span>@err</span><button type="button" aria-label="Bağla" data-toast-close>&times;</button></div>
        }
    </div>

    <!-- ================= TƏSDİQ PƏNCƏRƏSİ ================= -->
    <div class="modal fade" id="admConfirm" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content adm-confirm">
                <div class="adm-confirm__icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
                <h5 class="adm-confirm__title">Əminsiniz?</h5>
                <p class="adm-confirm__text">Bu əməliyyat geri qaytarıla bilməz.</p>
                <div class="adm-confirm__actions">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Ləğv et</button>
                    <button type="button" class="btn btn-danger" data-confirm-ok>Bəli, sil</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/no-autocomplete.js" asp-append-version="true"></script>
    <script src="~/js/video-frame.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
