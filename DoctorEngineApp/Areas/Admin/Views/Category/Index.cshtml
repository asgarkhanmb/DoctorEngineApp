@model List<CategoryVM>

<h2>Categories</h2>
<a asp-action="Create" class="btn btn-success mb-2">Create</a>
<table class="table">
    <thead><tr><th>Icon</th><th>Name</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(c.Icon))
                    {
                        <img src="~/uploads/categories/@c.Icon" width="50" />
                    }
                </td>
                <td>@c.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
