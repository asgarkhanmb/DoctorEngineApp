@model CategoryEditVM
<form asp-action="Edit" enctype="multipart/form-data" method="post">
    <input asp-for="Id" type="hidden" />
    <div class="mb-3"><label>Name</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-2">
        Current Icon:<br />
        @if (!string.IsNullOrEmpty(Model.ExistingIcon))
        {
            <img src="~/uploads/categories/@Model.ExistingIcon" width="60" />
        }
    </div>
    <div class="mb-3"><label>New Icon</label><input asp-for="IconFile" type="file" class="form-control" /></div>
    <button class="btn btn-primary">Save</button>
</form>
