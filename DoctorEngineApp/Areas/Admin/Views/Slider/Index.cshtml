@model List<Slider>

<a class="btn btn-success mb-3" asp-action="Create">Create Slider</a>

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Image 1</th>
        <th>Image 2</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Title</td>
            <td><img src="~/uploads/sliders/@item.Image1" width="120" /></td>
            <td><img src="~/uploads/sliders/@item.Image2" width="120" /></td>

            <td>
                <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>
