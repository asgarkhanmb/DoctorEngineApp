@model SliderVM

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />

    <label>Title</label>
    <input asp-for="Title" class="form-control" />

    <label>Subtitle</label>
    <input asp-for="Subtitle" class="form-control" />

    <p>Current Image 1:</p>
    <img src="~/uploads/sliders/@Model.ExistingImage1" width="150" />

    <label>Yeni Şəkil 1</label>
    <input asp-for="ImageFile1" type="file" class="form-control" />

    <p>Current Image 2:</p>
    <img src="~/uploads/sliders/@Model.ExistingImage2" width="150" />

    <label>Yeni Şəkil 2</label>
    <input asp-for="ImageFile2" type="file" class="form-control" />

    <button class="btn btn-primary mt-3">Update</button>
</form>
