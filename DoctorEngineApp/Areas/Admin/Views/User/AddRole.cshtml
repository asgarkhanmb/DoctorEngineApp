@model UserAddRoleVM
@{
    ViewData["Title"] = "Rol ver";
}

<partial name="_PageHead" model='new AdminPageHead("Rol ver", "İstifadəçiyə yeni rol əlavə edin. “Admin” rolu bu panelə tam giriş verir.", BackAction: "Index")' />

<div class="adm-card" style="max-width:560px">
    <form asp-action="AddRole" method="post" class="adm-form">
        <div class="adm-card__body">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="mb-3">
                <label asp-for="UsernameId" class="form-label">İstifadəçi</label>
                <select asp-for="UsernameId" asp-items="@ViewBag.users" class="form-select">
                    <option value="">— seçin —</option>
                </select>
                <span asp-validation-for="UsernameId"></span>
            </div>
            <div>
                <label asp-for="RoleId" class="form-label">Rol</label>
                <select asp-for="RoleId" asp-items="@ViewBag.roles" class="form-select">
                    <option value="">— seçin —</option>
                </select>
                <span asp-validation-for="RoleId"></span>
            </div>
        </div>
        <div class="adm-form-actions">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i> Rol ver</button>
            <a asp-action="Index" class="btn btn-light">Ləğv et</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
