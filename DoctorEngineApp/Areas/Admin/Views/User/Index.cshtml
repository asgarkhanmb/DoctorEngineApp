@model List<UserRoleVM>
@{
    ViewData["Title"] = "İstifadəçilər";
}

<partial name="_PageHead" model='new AdminPageHead("İstifadəçilər", "Qeydiyyatdan keçmiş istifadəçilər və onların rolları.", "Rol ver", "AddRole", "fa-solid fa-user-shield")' />

<div class="adm-card">
    <div class="adm-card__head">
        <span class="text-muted">Cəmi: @Model.Count</span>
        <div class="adm-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" class="form-control form-control-sm" data-table-search="#userTable" placeholder="Ad, istifadəçi adı, email…" />
        </div>
    </div>
    <div class="adm-table-wrap">
        <table class="adm-table" id="userTable">
            <thead>
                <tr><th>İstifadəçi</th><th>Email</th><th>Rollar</th><th class="adm-actions-col"></th></tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr data-row>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="adm-user__avatar">@(string.IsNullOrEmpty(u.Username) ? "?" : u.Username.Substring(0, 1).ToUpper())</span>
                                <div>
                                    <div class="adm-cell-title">@u.Fullname</div>
                                    <div class="adm-cell-sub">@@@u.Username</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            @u.Email
                            <div class="mt-1">
                                @if (u.EmailConfirmed)
                                {
                                    <span class="adm-badge is-confirmed"><i class="fa-solid fa-check"></i> Təsdiqlənib</span>
                                }
                                else
                                {
                                    <span class="adm-badge is-pending"><i class="fa-regular fa-clock"></i> Təsdiqlənməyib</span>
                                }
                                @if (u.IsLockedOut)
                                {
                                    <span class="adm-badge is-rejected"><i class="fa-solid fa-lock"></i> Bloklanıb</span>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var role in u.RoleList)
                                {
                                    <form asp-action="RemoveRole" method="post" class="d-inline">
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <input type="hidden" name="role" value="@role" />
                                        <span class="adm-badge @(role == "Admin" ? "is-admin" : "is-neutral")">
                                            @(role == "Admin" ? "Administrator" : role == "Member" ? "İstifadəçi" : role)
                                            <button type="submit" class="btn btn-link p-0 ms-1 text-reset" title="Rolu sil" aria-label="Rolu sil"
                                                    data-confirm="@u.Username istifadəçisindən “@role” rolu silinsin?" data-confirm-ok="Bəli, sil" style="font-size:11px;line-height:1">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        </span>
                                    </form>
                                }
                                @if (!u.RoleList.Any())
                                {
                                    <span class="text-muted">—</span>
                                }
                            </div>
                        </td>
                        <td class="adm-actions-col">
                            <a asp-action="AddRole" asp-route-userId="@u.Id" class="adm-act" title="Rol ver" aria-label="Rol ver"><i class="fa-solid fa-user-shield"></i></a>
                        </td>
                    </tr>
                }
                <tr data-search-empty hidden><td colspan="4"><div class="adm-empty"><i class="fa-solid fa-magnifying-glass"></i>Nəticə tapılmadı</div></td></tr>
            </tbody>
        </table>
    </div>
</div>
