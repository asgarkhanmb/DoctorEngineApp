@model InformEditVM
@{ ViewData["Title"] = "Kartı redaktə et"; }

<partial name="_PageHead" model='new AdminPageHead("Kartı redaktə et", BackAction: "Index")' />

<div class="adm-card" style="max-width:720px">
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="adm-form">
        <div class="adm-card__body">
            <input asp-for="Id" type="hidden" /><input asp-for="CurrentIcon" type="hidden" />
            <div asp-validation-summary="ModelOnly"></div>

            <div class="adm-upload mb-3">
                <div class="adm-upload__preview is-contain" id="iconPreview" style="@(string.IsNullOrEmpty(Model.CurrentIcon) ? "" : $"background-image:url('{Model.CurrentIcon}')")">@if (string.IsNullOrEmpty(Model.CurrentIcon)) { <i class="fa-regular fa-image"></i> }</div>
                <div class="adm-upload__body">
                    <label asp-for="Icon" class="form-label">İkon <small class="text-muted">(dəyişmək üçün yenisini seçin)</small></label>
                    <input asp-for="Icon" type="file" class="form-control" accept="image/png,image/webp,image/jpeg" data-preview="#iconPreview" />
                    <div class="form-text">Kvadrat, şəffaf fonlu PNG tövsiyə olunur (məs: 128×128).</div>
                    <span asp-validation-for="Icon"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Başlıq</label>
                <input asp-for="Title" class="form-control" maxlength="80" placeholder="Məs: Keyfiyyətli Xidmət" />
                <span asp-validation-for="Title"></span>
            </div>

            <div>
                <label asp-for="Description" class="form-label">Təsvir</label>
                <textarea asp-for="Description" class="form-control" rows="3" maxlength="300" placeholder="Bir-iki cümlə ilə izah edin"></textarea>
                <span asp-validation-for="Description"></span>
            </div>
        </div>
        <div class="adm-form-actions">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i> Yadda saxla</button>
            <a asp-action="Index" class="btn btn-light">Ləğv et</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
