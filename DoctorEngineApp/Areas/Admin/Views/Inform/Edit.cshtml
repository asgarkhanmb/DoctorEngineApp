@model InformEditVM

@{
    ViewData["Title"] = "Edit Inform";
}

<div class="container mt-5">
    <h2>Edit Inform</h2>

    <form asp-action="Edit" asp-controller="Inform" enctype="multipart/form-data" method="post">

        <input asp-for="Id" type="hidden" />

        <!-- Current Icon -->
        <div class="mb-3">
            <label class="form-label">Current Icon</label>
            @if (!string.IsNullOrEmpty(Model.CurrentIcon))
            {
                <div>
                    <img src="@Model.CurrentIcon" alt="Icon" style="width:70px; height:70px; object-fit:contain;" />
                </div>
            }
            else
            {
                <p>No icon uploaded.</p>
            }
        </div>

        <!-- Upload New Icon -->
        <div class="mb-3">
            <label asp-for="Icon" class="form-label">New Icon</label>
            <input asp-for="Icon" type="file" accept="image/*" class="form-control" />
            <span class="text-danger" asp-validation-for="Icon"></span>
        </div>

        <!-- Title -->
        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span class="text-danger" asp-validation-for="Title"></span>
        </div>

        <!-- Description -->
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span class="text-danger" asp-validation-for="Description"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
