@model List<Inform>
@{
    ViewData["Title"] = "Üstünlüklər";
    var canCreate = Model == null || Model.Count < 3;
}

<partial name="_PageHead" model='new AdminPageHead("Üstünlüklər", "Ana səhifədə, Haqqımızda və Rezervasiya səhifələrində göstərilən 3 kart (məs: “Keyfiyyətli Xidmət”).", canCreate ? "Yeni kart" : null, canCreate ? "Create" : null)' />

<div class="adm-card">
    @if (Model == null || !Model.Any())
    {
        <div class="adm-empty"><i class="fa-regular fa-star"></i><strong>Hələ kart yoxdur</strong>Saytda 3 kart göstərilir — birincisini əlavə edin.</div>
    }
    else
    {
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead><tr><th style="width:70px">İkon</th><th>Başlıq</th><th>Təsvir</th><th class="adm-actions-col"></th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><img src="@item.Icon" alt="" class="adm-thumb is-square is-contain" /></td>
                            <td class="adm-cell-title">@item.Title</td>
                            <td><div class="adm-clamp">@item.Description</div></td>
                            <td class="adm-actions-col">
                                <div class="adm-actions">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="adm-act" title="Redaktə et" aria-label="Redaktə et"><i class="fa-solid fa-pen"></i></a>
                                    @if (Model.Count > 1)
                                    {
                                        <partial name="_DeleteButton" model='new AdminDeleteButton("Delete", item.Id, $"“{item.Title}” kartı silinsin?")' />
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!canCreate)
        {
            <div class="px-4 py-3 border-top text-muted small"><i class="fa-solid fa-circle-info me-1"></i> Maksimum 3 kart ola bilər — yenisini əlavə etmək üçün birini silin və ya redaktə edin.</div>
        }
    }
</div>
