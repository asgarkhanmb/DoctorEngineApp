@model DoctorEngineApp.Models.WhatsappSetting

<div class="container mt-4">

    <h3 class="mb-4 text-danger">WhatsApp Ayarını Sil</h3>

    <div class="alert alert-warning">
        <p>Bu WhatsApp ayarını silmək istədiyinizə əminsiniz?</p>
        <p><strong>Nömrə:</strong> @Model.PhoneNumber</p>
        <p><strong>Mesaj:</strong> @Model.Message</p>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Sil</button>
        <a asp-action="Index" class="btn btn-secondary">Geri</a>
    </form>

</div>