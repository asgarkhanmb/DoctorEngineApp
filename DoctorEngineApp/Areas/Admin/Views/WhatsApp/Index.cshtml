@model DoctorEngineApp.Models.WhatsappSetting
@{ ViewData["Title"] = "WhatsApp düyməsi"; }

<partial name="_PageHead" model='new AdminPageHead("WhatsApp düyməsi", "Saytın sağ aşağı küncündəki yaşıl WhatsApp düyməsi — hansı nömrəyə və hansı hazır mesajla yazılacaq.", Model == null ? "Ayarla" : null, Model == null ? "Create" : null)' />

@if (Model == null)
{
    <div class="adm-card"><div class="adm-empty"><i class="fa-brands fa-whatsapp"></i><strong>WhatsApp düyməsi ayarlanmayıb</strong>Ayarlanmasa, saytda düymə göstərilmir.</div></div>
}
else
{
    <div class="adm-card" style="max-width:720px">
        <div class="adm-card__body d-flex gap-3 align-items-start">
            <span class="adm-stat__icon is-green"><i class="fa-brands fa-whatsapp"></i></span>
            <dl class="adm-dl flex-grow-1 mb-0">
                <dt>Nömrə</dt><dd><a href="https://wa.me/@Model.PhoneNumber.Replace("+", "").Replace(" ", "")" target="_blank" rel="noopener">@Model.PhoneNumber</a></dd>
                <dt>Hazır mesaj</dt><dd>@(string.IsNullOrWhiteSpace(Model.Message) ? "—" : Model.Message)</dd>
            </dl>
        </div>
        <div class="adm-form-actions">
            <a asp-action="Edit" class="btn btn-primary"><i class="fa-solid fa-pen"></i> Redaktə et</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="ms-auto">
                <button type="submit" class="btn btn-light text-danger" data-confirm="WhatsApp düyməsi silinsin?" data-confirm-text="Saytda WhatsApp düyməsi görünməyəcək."><i class="fa-regular fa-trash-can"></i> Sil</button>
            </form>
        </div>
    </div>
}
