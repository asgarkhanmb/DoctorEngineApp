@model List<JobVM>

<h4>Görülən İşlər</h4>

@for (int i = 0; i < Model.Count; i++)
{
    <div class="border p-2 mb-2">

        <input type="hidden" asp-for="@Model[i].JobId" />

        <strong>@Model[i].Name</strong>

        <div class="form-check mt-1">
            <input asp-for="@Model[i].IsSelected"
                   class="form-check-input" />
            <label class="form-check-label">Seç</label>
        </div>

        <input asp-for="@Model[i].WarrantyMonths"
               class="form-control mt-2"
               placeholder="Zəmanət (ay)" />
    </div>
}
