@model MapVM

<form method="post">
    <div class="mb-3">
        <label>Ünvan</label>
        <input asp-for="Address" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Google Map Embed URL</label>
        <textarea asp-for="MapUrl" class="form-control" rows="4"></textarea>
    </div>

    <button class="btn btn-success">Update</button>
</form>

<hr />

<iframe src="@Model.MapUrl"
        class="w-100 rounded"
        style="height:300px;border:0;"
        loading="lazy">
</iframe>
