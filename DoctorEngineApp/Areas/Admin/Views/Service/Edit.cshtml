@model ServiceVM

<h2>Xidmət Düzəlişi</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Ad</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="WhatsApp" class="form-label">WhatsApp nömrəsi</label>
        <input asp-for="WhatsApp" class="form-control" placeholder="+99450xxxxxxx" />
        <span asp-validation-for="WhatsApp" class="text-danger"></span>
    </div>

    <button class="btn btn-success">Yadda saxla</button>
    <a asp-action="Index" class="btn btn-secondary">Geri</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
