@model ServiceVM
@{ ViewData["Title"] = "Yeni xidmət"; }

<partial name="_PageHead" model='new AdminPageHead("Yeni xidmət", BackAction: "Index")' />

<div class="adm-card" style="max-width:640px">
    <form asp-action="Create" method="post" class="adm-form">
        <div class="adm-card__body">
            
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label asp-for="Name" class="form-label">Xidmətin adı</label>
                <input asp-for="Name" class="form-control" placeholder="Məs: Mühərrik diaqnostikası" />
                <span asp-validation-for="Name"></span>
            </div>
        </div>
        <div class="adm-form-actions">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i> Əlavə et</button>
            <a asp-action="Index" class="btn btn-light">Ləğv et</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
