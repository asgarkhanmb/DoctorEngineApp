@model About
@{ ViewData["Title"] = "Silmək"; }

<partial name="_PageHead" model='new AdminPageHead("Qeydi silmək", BackAction: "Index")' />

<div class="adm-card" style="max-width:560px">
    <div class="adm-card__body">
        <p>Bu qeyd və onun videosu silinəcək. Bu əməliyyat geri qaytarıla bilməz.</p>
        <strong>@Model.Title</strong>
    </div>
    <form asp-action="Delete" method="post" class="adm-form-actions">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger"><i class="fa-regular fa-trash-can"></i> Sil</button>
        <a asp-action="Index" class="btn btn-light">Ləğv et</a>
    </form>
</div>
