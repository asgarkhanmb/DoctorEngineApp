@model AboutEditVM

<h2>About Düzəliş</h2>

<form asp-action="Edit" enctype="multipart/form-data" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label>Title</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>Mövcud Video</label><br />
        @if (!string.IsNullOrEmpty(Model.CurrentVideo))
        {
            <video width="400" controls>
                <source src="@Model.CurrentVideo" />
            </video>
        }
        else
        {
            <p>Video yoxdur</p>
        }
    </div>

    <div class="mb-3">
        <label>Yeni Video yüklə (isteğe bağlı, maksimum 1GB)</label>
        <input asp-for="VideoFile" type="file" accept="video/*" class="form-control" />
    </div>

    <button class="btn btn-primary">Yadda saxla</button>
    <a asp-action="Index" class="btn btn-secondary">Geri</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
