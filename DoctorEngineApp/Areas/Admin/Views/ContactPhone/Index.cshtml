@model List<ContactPhoneVM>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Əlaqə Nömrələri</h4>
        <a asp-action="Create" class="btn btn-success">
            + Yeni nömrə əlavə et
        </a>
    </div>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width: 45%;">Məlumat</th>
                <th style="width: 25%;">Telefon</th>
                <th style="width: 30%;" class="text-center">Əməliyyatlar</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">
                                @item.Title
                            </div>

                            <div class="text-muted small description-clamp">

                            <textarea class="form-control note-textarea" readonly>@item.Description</textarea>

                            </div>
                        </td>
                        <td>
                            <span class="fw-semibold">@item.PhoneNumber</span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-primary me-1">
                                Dəyiş
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Silmək istədiyinizə əminsiniz?')">
                                Sil
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">
                        Heç bir məlumat tapılmadı
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
