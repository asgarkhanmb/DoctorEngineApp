@model List<ContactPhoneVM>
@{ ViewData["Title"] = "Telefon bloku"; }

<partial name="_PageHead" model='new AdminPageHead("Telefon bloku", "Rezervasiya səhifəsinin aşağısındakı “İndi zəng edin” bölməsi. Saytda birinci qeyd göstərilir.", "Yeni blok", "Create")' />

<div class="adm-card">
    @if (Model == null || !Model.Any())
    {
        <div class="adm-empty"><i class="fa-solid fa-phone"></i><strong>Hələ blok yoxdur</strong>Əlavə etməsəniz, Rezervasiya səhifəsində zəng bölməsi göstərilməyəcək.</div>
    }
    else
    {
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead><tr><th>Mətn</th><th>Telefon</th><th class="adm-actions-col"></th></tr></thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        <tr>
                            <td>
                                <div class="adm-cell-sub text-uppercase">@item.Subtitle</div>
                                <div class="adm-cell-title">
                                    @item.Title
                                    @if (i == 0) { <span class="adm-badge is-confirmed ms-1"><i class="fa-solid fa-eye"></i> Saytda</span> }
                                </div>
                                <div class="adm-clamp">@item.Description</div>
                            </td>
                            <td class="text-nowrap"><a href="tel:@item.PhoneNumber.Replace(" ", "")">@item.PhoneNumber</a></td>
                            <td class="adm-actions-col">
                                <div class="adm-actions">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="adm-act" title="Redaktə et" aria-label="Redaktə et"><i class="fa-solid fa-pen"></i></a>
                                    <partial name="_DeleteButton" model='new AdminDeleteButton("Delete", item.Id, "Bu telefon bloku silinsin?")' />
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
